	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vitest run --config vitest.config.ts",
		"test:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vitest --config vitest.config.ts"
	},
