# Dōjō console — public runtime env. Copy to `.env` and fill in the anon key.
# NEVER commit a real .env (see .gitignore). Secrets live only in your local .env.

# ── Supabase auth (the local stack from R5) ──────────────────────────────────
# `supabase start` prints the API URL + anon key for the local stack.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# ── Dōjō service (the shared-mind API the console reads once signed in) ───────
PUBLIC_DOJO_API_URL=http://127.0.0.1:7755
