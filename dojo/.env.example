# Dōjō console — public runtime env. Copy to `.env` and fill in the anon key.
# NEVER commit a real .env (see .gitignore). Secrets live only in your local .env.

# ── Supabase auth (the local stack from R5) ──────────────────────────────────
# `supabase start` prints the API URL + anon key for the local stack.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase browser (anon/publishable) key — PUBLIC, shipped to the browser. Used
# by the client Realtime subscription (relay P4.2). Local dev: the anon JWT from
# `supabase status`. Prod: the prod anon/publishable key (a Worker public var).
# Public by design — RLS + the user JWT scope access — so it is safe in client env.
PUBLIC_SUPABASE_ANON_KEY=

# ── Dōjō service (the shared-mind API the console reads once signed in) ───────
PUBLIC_DOJO_API_URL=http://127.0.0.1:7755

# ── Web Push (relay P4.3) — VAPID public key ─────────────────────────────────
# The application-server public key advertised to the browser (PushManager.subscribe).
# Dev: generated locally (private key in .dev-vapid.json, gitignored). Prod: set by
# Dev as a Worker var; the matching private key is a `wrangler secret` (never in git).
PUBLIC_VAPID_KEY=

# ── Azure DevOps through Microsoft Entra (#308 R5b, D42) ─────────────────────
# The multi-tenant app registration the connect flow uses (server-only, NEVER
# PUBLIC_-prefixed, never in git). Without both, connecting Azure DevOps answers
# 503 "Azure DevOps is not configured on this dōjō". Setup checklist:
# docs/spec/dojo/git-integration-import.md, "R5b · one-time setup".
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
