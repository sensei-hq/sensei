{
	// Committed so Cloudflare's `wrangler deploy` (Workers Static Assets) deploys
	// the SvelteKit (adapter-cloudflare) output directly instead of running its
	// interactive auto-config — which otherwise runs `wrangler types --check`
	// and fails with "Types file not found at worker-configuration.d.ts".
	//
	// This is a WORKERS deploy (`wrangler deploy`), not a Pages deploy — the
	// website holds the account's single Pages project, everything else is a
	// Worker. The adapter is selected by svelte.config.js when WORKERS_CI (set by
	// Cloudflare Workers Builds) is present. Mirrors kavach's sites/learn.
	//
	// nodejs_compat is required: dojo runs kavach SSR auth (hooks.server.ts +
	// /auth/session + /data endpoints) in the Worker, not prerendered.
	//
	// `name` must match the Cloudflare project's Worker name.
	"name": "dojo",
	"compatibility_date": "2026-06-13",
	"compatibility_flags": ["nodejs_compat"],
	// Env is managed in the Cloudflare dashboard as encrypted SECRETS (PUBLIC_
	// SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY publishable, and the service/secret
	// key) — never in git, since this repo is PUBLIC. `wrangler deploy` never
	// deletes Secrets, so they survive every deploy. (The earlier wipe hit
	// plaintext dashboard *Variables*: a committed config is authoritative and
	// deploy removes plaintext vars not listed here.) keep_vars:true is a safety
	// net so any *future* plaintext Variable added in the dashboard also survives.
	// At runtime SvelteKit reads all of these from platform.env via
	// $env/dynamic/{public,private}. Local `wrangler dev`: gitignored .dev.vars
	// (see .dev.vars.example); `bun run dev` (Vite) uses the gitignored .env.
	"keep_vars": true,
	// Web Push / VAPID (relay P4.4 send). Declared here as documentation — the
	// VALUES are NOT committed (this repo is public). At runtime SvelteKit reads
	// them from platform.env via $env/dynamic/{public,private}:
	//   VAPID_PRIVATE_KEY — SECRET. Prod: `wrangler secret put VAPID_PRIVATE_KEY`.
	//                       Local: gitignored .dev.vars (base64url `d` from
	//                       .dev-vapid.json). NEVER a plaintext var / never in git.
	//   VAPID_SUBJECT     — mailto: contact. Dashboard var (or secret); .dev.vars local.
	//   PUBLIC_VAPID_KEY  — base64url raw public key; PUBLIC_ ships to the browser.
	//                       Dashboard var; .env (Vite) / .dev.vars (wrangler) local.
	// No "vars" block with values on purpose: keep_vars:true preserves the
	// dashboard-managed values across deploys, and none of these belong in git.
	// Served at <name>.<subdomain>.workers.dev + a versioned preview URL per
	// deploy. Set workers_dev:false to serve only from the custom domain.
	"workers_dev": true,
	"preview_urls": true,
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	}
}
