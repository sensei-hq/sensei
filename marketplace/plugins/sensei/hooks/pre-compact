#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_lib.sh"

PROJECT_ROOT="${CLAUDE_PROJECT_ROOT:-${PWD}}"
PROJECT_NAME="$(basename "$PROJECT_ROOT")"

# Forward telemetry first so the event reaches the daemon even if the
# context-building below fails.
read_stdin_payload
send_telemetry "$PAYLOAD"

# ── Re-inject the MANDATORY tier (D-INJECT) ──────────────────────────────
# Pushed from the daemon so the non-negotiable rules survive compaction intact —
# the old `head -60 .sensei/rules.md` could truncate them. Plain-text markdown
# (no jq); fall back to the static file when the daemon is down.
RULES=""
REPO_RULES=$(curl -s --connect-timeout 1 --max-time 3 \
  "${DAEMON_URL}/api/knowledge/rules?folder=${PROJECT_ROOT}&format=md&tiers=mandatory" 2>/dev/null || true)
if [ -n "$REPO_RULES" ] && [ "${REPO_RULES:0:1}" != "{" ]; then
  RULES="$REPO_RULES"
else
  RULES_FILE="${PROJECT_ROOT}/.sensei/rules.md"
  [ -f "$RULES_FILE" ] && RULES=$(head -60 "$RULES_FILE")
fi

# ── Mindsets (shipped as subagents) ──────────────────────────────────────────
MINDSETS_SUMMARY="Core three in sequence: Analyst → Developer → Acceptance Tester; specialists by domain. Each is a subagent — invoke via /sensei:agent."

# ── Read workflow state (from the daemon — the DB, not a local mirror) ───────
# Same pushed-from-daemon pattern as the rules above; no .sensei/state.yaml
# (it drifted). Silent no-op when the daemon is down / nothing set / JSON error.
STATE=""
STATE_BODY=$(curl -s --connect-timeout 1 --max-time 3 \
  "${DAEMON_URL}/api/state/${PROJECT_NAME}?format=md" 2>/dev/null || true)
if [ -n "$STATE_BODY" ] && [ "${STATE_BODY:0:1}" != "{" ]; then
  STATE="$STATE_BODY"
fi

# ── Build context ────────────────────────────────────────────────────────────
CONTEXT="<sensei-refocus>
## Workflow state
${STATE:-No active workflow state.}

## Guardrails
${RULES:-No project rules found. Run /sensei:rules to create.}

## Mindsets
${MINDSETS_SUMMARY:-Mindsets not loaded.}

## Tools
Prefer sensei MCP tools over grep/sed:
- search() for symbol lookup
- get_callers()/get_callees() for dependencies
- get_lib_docs() for library documentation

Run /sensei:session refocus for full orientation after compaction.
</sensei-refocus>"

ESCAPED=$(escape_for_json "$CONTEXT")

cat <<EOF
{
  "additional_context": "${ESCAPED}"
}
EOF
exit 0
