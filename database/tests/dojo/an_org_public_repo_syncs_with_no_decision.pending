-- WP8: an organisation's PUBLIC repository is the organisation's (D46 ELECTION).
-- Absent decision ELECTED, authority `organization`, admin-only — while the
-- sync outcome stays true.
--
-- WHAT BREAKS THIS TEST (today): authority is the member's and any member may
-- switch it off. The elected/sync halves pass today and after (guard pins);
-- authority and configurable_by_me go red until WP8.
--
-- Interim pattern until --apply merges: \ir the view DDL under test, seed,
-- assert, rollback. Nothing persists.
begin;

\ir ../../ddl/view/dojo/all_my_repositories.ddl

insert into dojo.principals (id, auth_user_id, display_name) values
  ('a3333333-3333-3333-3333-333333333333', 'aa333333-3333-3333-3333-333333333333', 'Bob');

insert into dojo.tenants (id, key, origin, slug, name, dojo_url, claimed_at) values
  ('b3333333-3333-3333-3333-333333333333', 'organization/ztest-wp8-acme', 'organization', 'ztest-wp8-acme',
   'Acme', 'dojo.sensei-hq.org/organization/ztest-wp8-acme', now());

-- A plain contributor: the member the switch is taken from.
insert into dojo.memberships (tenant_id, user_id, kind, authenticated_via, role, disabled_at) values
  ('b3333333-3333-3333-3333-333333333333', 'a3333333-3333-3333-3333-333333333333',
   'employer', 'github_oauth', 'contributor', null);

insert into dojo.repositories (tenant_id, repo_key, remote_url, name, provider, visibility, visibility_captured_at) values
  ('b3333333-3333-3333-3333-333333333333', 'github.com/ztest-wp8-acme/web',
   'git@github.com:ztest-wp8-acme/web.git', 'web', 'github', 'public', now());

-- No elections, no policy: the absent decision.

do $$
declare
    r record;
begin
    select elected, sync_enabled, may_share, authority, configurable_by_me
      into r
      from dojo.all_my_repositories
     where principal_id = 'a3333333-3333-3333-3333-333333333333'
       and repo_key = 'github.com/ztest-wp8-acme/web';
    if r is null then
        raise exception 'org public row missing entirely.';
    end if;
    if r.elected is not true then
        raise exception 'org public repo with no decision is not elected.';
    end if;
    if r.sync_enabled is not true then
        raise exception 'org public repo with no decision does not sync.';
    end if;
    if r.may_share is not true then
        raise exception 'org public repo is not entitled.';
    end if;
    if r.authority is distinct from 'organization' then
        raise exception 'org public repo authority is %, want organization.', r.authority;
    end if;
    if r.configurable_by_me is not false then
        raise exception 'a contributor may switch an org public repo.';
    end if;
end $$;

rollback;
