-- TG1 · gating eligibility (docs/spec/dojo/targets-and-gates.md §TG1): which
-- catalogue metrics may be a target, read from `sensei.metric_gating`, seeded from
-- `import/staging/metric_gating.jsonl` through `staging.import_metric_gating()`.
--
-- Goes red if: the seed loses `ftr` (an insight) or marks it eligible; the import
-- silently skips a row naming a metric that does not exist; a `neutral` metric can
-- be made eligible (it has no direction, so no comparator); or a re-import of the
-- same rows rewrites them / an older row overwrites a newer one.
begin;

-- an_insight_is_present_and_ineligible (and coverage, target 2, is eligible)
do $$
declare
  ftr_eligible boolean;
  cov record;
begin
  select g.eligible into ftr_eligible
    from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id
   where m.key = 'ftr';
  if ftr_eligible is null then
    raise exception 'an_insight_is_present_and_ineligible: no gating row for ftr';
  end if;
  if ftr_eligible then
    raise exception 'an_insight_is_present_and_ineligible: ftr is an insight, never a target';
  end if;

  select g.eligible, g.delta_scoped, g.min_coverage into cov
    from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id
   where m.key = 'coverage';
  if cov is null or not cov.eligible or cov.delta_scoped or cov.min_coverage <> 0.5 then
    raise exception 'coverage gating row is not (eligible, absolute, 0.5): %', cov;
  end if;
end $$;

-- an_unknown_metric_key_fails_the_import
do $$
begin
  truncate staging.metric_gating;
  insert into staging.metric_gating(metric_key, eligible, delta_scoped, min_coverage, note, modified_at)
  values ('ztest-no-such-metric', true, false, 1.0, 'a metric no catalogue row names', now());
  begin
    call staging.import_metric_gating();
  exception when others then
    if sqlerrm not like '%ztest-no-such-metric%' then
      raise exception 'an_unknown_metric_key_fails_the_import: the error does not name the key: %', sqlerrm;
    end if;
    return; -- raised, naming the key: the expected outcome
  end;
  raise exception 'an_unknown_metric_key_fails_the_import: the import accepted an unknown key';
end $$;

-- a_neutral_metric_cannot_be_eligible
do $$
begin
  truncate staging.metric_gating;
  insert into staging.metric_gating(metric_key, eligible, delta_scoped, min_coverage, note, modified_at)
  values ('session_duration', true, false, 1.0, 'neutral: no direction to compare against', now());
  begin
    call staging.import_metric_gating();
  exception when others then
    if sqlerrm not like '%session_duration%' then
      raise exception 'a_neutral_metric_cannot_be_eligible: the error does not name the key: %', sqlerrm;
    end if;
    if exists (select 1 from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id
                where m.key = 'session_duration' and g.eligible) then
      raise exception 'a_neutral_metric_cannot_be_eligible: the row landed despite the error';
    end if;
    return;
  end;
  raise exception 'a_neutral_metric_cannot_be_eligible: the import made a neutral metric eligible';
end $$;

-- A neutral metric may still carry an ineligible row (saying why it is not a target).
do $$
begin
  truncate staging.metric_gating;
  insert into staging.metric_gating(metric_key, eligible, delta_scoped, min_coverage, note, modified_at)
  values ('session_duration', false, false, 1.0, 'neutral: an insight, never a target', now());
  call staging.import_metric_gating();
  if not exists (select 1 from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id
                  where m.key = 'session_duration' and not g.eligible) then
    raise exception 'an ineligible row for a neutral metric did not land';
  end if;
end $$;

-- reimporting_unchanged_rows_changes_nothing, and an older row never clobbers a newer one
do $$
declare
  before text;
  after text;
  n_before int;
  n_after int;
begin
  truncate staging.metric_gating;
  insert into staging.metric_gating(metric_key, eligible, delta_scoped, min_coverage, note, modified_at)
  select m.key, g.eligible, g.delta_scoped, g.min_coverage, g.note, g.modified_at
    from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id;
  select count(*), string_agg(g::text, '|' order by g.metric_id) into n_before, before from sensei.metric_gating g;
  call staging.import_metric_gating();
  call staging.import_metric_gating();
  select count(*), string_agg(g::text, '|' order by g.metric_id) into n_after, after from sensei.metric_gating g;
  if n_after <> n_before or after is distinct from before then
    raise exception 'reimporting_unchanged_rows_changes_nothing: % rows → %, or a value changed', n_before, n_after;
  end if;

  truncate staging.metric_gating;
  insert into staging.metric_gating(metric_key, eligible, delta_scoped, min_coverage, note, modified_at)
  values ('coverage', false, true, 1.0, 'an older edit', '2000-01-01');
  call staging.import_metric_gating();
  if exists (select 1 from sensei.metric_gating g join sensei.metrics m on m.id = g.metric_id
              where m.key = 'coverage' and not g.eligible) then
    raise exception 'an older staging row overwrote the newer live coverage row';
  end if;
end $$;

rollback;
