.env.local

# Personal capture — staged for import via `dbd import …`. May contain session
# payloads (prompts, file paths, tool output) and per-developer knowledge, so
# these exported capture files must never be committed.
import/staging/assistant_events.jsonl
import/staging/memories.jsonl

# Local DB snapshots produced by `make db-backup` (and by every `make
# install*` invocation, which hooks db-backup first). One pg_dump custom-
# format file per install: backup-YYYYMMDD-HHMMSS.dump. Restore with
# `pg_restore -d sensei -c database/backup/backup-…dump`.
backup/
