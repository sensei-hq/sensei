Table "activity"."assistant_events" {
  "id" bigserial [pk, not null, note: 'Surrogate primary key (bigserial — high write volume).']
  "session_id" text [not null, default: '', note: 'Assistant session ID string. Not a FK — not a DB UUID.']
  "family" sensei.assistant_family [not null, default: 'claude', note: 'Which assistant emitted this event: claude, cursor, zed, codex, aider, etc.']
  "event_type" text [not null, note: 'hook_event_name from payload: SessionStart, PreToolUse, PostToolUse, Stop, etc.']
  "tool_name" text [note: 'tool_name from payload. Populated for PreToolUse and PostToolUse events only.']
  "cwd" text [note: 'Working directory at the time of the event.']
  "ts" bigint [not null, note: 'Unix epoch milliseconds when the event fired (client clock).']
  "success" boolean [note: 'For PostToolUse: true if exit_code == 0. Null for all other event types.']
  "payload" jsonb [not null, default: '{}', note: 'Full JSON payload received from stdin — complete event data.']
  "created_at" timestamptz [not null, default: `now()`, note: 'Server-side timestamp when this row was inserted.']
  "repository_id" uuid [note: 'Derived attributes (populated by the EnrichAssistantEvents worker from tool_name + payload->tool_input + cwd — a base-insert + post-update split so the hot capture path is never blocked and the derivation is re-runnable/backfillable). All nullable; `enriched_at` NULL marks a row the worker has not processed yet.']
  "plugin" text
  "method" text
  "tool_kind" text
  "call_info" text
  "enriched_at" timestamptz

  indexes {
    (session_id, created_at) [name: 'assistant_events_session_id_idx', note: 'order: asc, desc']
    (event_type, created_at) [name: 'assistant_events_event_type_idx', note: 'order: asc, desc']
    created_at [name: 'assistant_events_created_at_idx', note: 'order: desc']
    (family, created_at) [name: 'assistant_events_family_idx', note: 'order: asc, desc']
    id [name: 'assistant_events_unenriched_idx', note: 'where: enriched_at IS NULL']
    (repository_id, created_at) [name: 'assistant_events_repository_id_idx', note: 'where: repository_id IS NOT NULL\norder: asc, desc']
  }

  Note: '''Raw assistant event log — one row per hook/event invocation, from any
assistant family. Captures events emitted by Claude Code, Cursor, Zed, etc.
session_id is the assistant string session ID, not a DB UUID.
family identifies the source assistant (claude, cursor, zed, …).
payload stores the full JSON payload received from stdin.'''
}

Table "activity"."runs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "workspace_id" uuid
  "plan_ref" text [not null, default: '', note: 'Path/ref of the committed plan doc the run executes.']
  "plan_graph" jsonb [note: 'The authored plan graph (phases→tasks with agent/model/spec_ref + per-task state) for a run seeded via register_plan; NULL for ad-hoc/cadence-derived runs. publish_run authors relay segments from this when present, else derives them from run_events. Fetched on demand (off the 16-col RUN_SELECT).']
  "goal" text
  "author_name" text [note: 'Git author name (user.name, local→global) resolved for the run\'s workspace at start_run — who is doing the work. Matches the commit author + the Dōjō sign-in. NULL when git identity was unresolvable.']
  "author_email" text [note: 'Git author email (user.email, local→global) — the identity key. Used to attribute the run to a person; the Dōjō membership resolves it to a login.']
  "status" sensei.run_status [not null, default: 'running']
  "paused_until" timestamptz [note: 'When a limit pause auto-resumes; NULL while running. Reset time parsed from the CLI limit message.']
  "pause_reason" text [note: 'Human-readable pause cause (e.g. "rate limit", "weekly cap") shown in the feed.']
  "current_phase" text
  "current_feature" text
  "dojo_session_id" uuid [note: 'The cloud dojo.relay_sessions(id) mirroring this run. Plain uuid — no cross-DB FK.']
  "max_concurrency" int [not null, default: 1, note: 'Active sub-agent cap; graduated response throttles this to 1 under rate-limit pressure.']
  "started_at" timestamptz [not null, default: `now()`]
  "completed_at" timestamptz
  "heartbeat_at" timestamptz
  "recovery_attempts" int [not null, default: 0, note: 'Bounded auto-recovery counter — incremented on each watchdog recovery; reset to 0 on real progress (a clean drive step); at the cap the run escalates to crashed.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, started_at) [name: 'runs_workspace_idx', note: 'order: asc, desc']
    status [name: 'runs_active_idx', note: 'where: status IN (\'running\', \'paused\', \'stalled\', \'blocked\')']
  }

  Note: '''A daemon-owned autonomous run of a multi-phase plan — the relay engine's executor.
Survives daemon restarts (durable run-state; fixes the vacation run's
session-coupled death). plan_ref points at the committed plan doc. status is
authoritative; the cloud dojo.relay_sessions mirrors it. paused_until + pause_reason
carry limit pauses (rate limit / weekly cap) with auto-resume. dojo_session_id is
the cloud relay session's id (plain uuid — no cross-DB FK). max_concurrency is
throttled to 1 under rate-limit pressure.'''
}

Table "gateway"."models" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "provider_id" uuid [not null, note: 'Foreign key to providers — who created this model.']
  "name" text [not null, note: 'Model line name — version-specific (e.g. "gemma3", "qwen3", "claude", "gpt"). See `family` for the coarser base-architecture grouping.']
  "family" text [note: 'Base architecture family for grouping + diversity (e.g. "gemma", "qwen", "llama", "phi", "claude", "gpt"). Coarser than `name` (gemma2/gemma3/gemma4 all → "gemma"). Consumed by the MOE panel / fan-out routing to pick DIVERSE families per role (proposer vs challenger). Nullable.']
  "version" text [note: 'Version string (e.g. "3", "4o", "4.5").']
  "variant" text [note: 'Variant within version (e.g. "27b", "haiku", "mini"). Nullable.']
  "full_name" text [not null, note: 'Complete model identifier (e.g. "gemma3:27b", "claude-haiku-4-5", "gpt-4o-mini").']
  "display_name" text [not null, note: 'Human-readable display name.']
  "description" text [note: 'Brief description of model strengths and intended use.']
  "capabilities" sensei.model_capability[] [not null, default: '{}', note: 'Array of capabilities this model supports: chat, reasoning, embed, classify, summarize, vision, audio.']
  "context_window" int [note: 'Maximum input context in tokens.']
  "max_output_tokens" int [note: 'Maximum output tokens per request.']
  "parameters_count" bigint [note: 'Model parameter count (e.g. 27000000000 for 27B).']
  "memory_gb" numeric(5,1) [note: 'RAM required to run locally via Ollama. Null for external-only models.']
  "license_type" text [note: 'License type: commercial, apache-2.0, llama-3, gemma, etc.']
  "released_on" date [note: 'Model release date.']
  "deprecated_on" date [note: 'Deprecation date. Null if active.']
  "props" jsonb [not null, default: '{}', note: 'Extensible config: {temperature_range, top_p_range, training_cutoff, ...}.']
  "is_active" boolean [not null, default: true, note: 'Whether this model is available for selection.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (provider_id, full_name) [unique, note: 'unique constraint']
    provider_id [name: 'models_provider_id_idx']
    capabilities [type: gin, name: 'models_capabilities_idx']
  }

  Note: '''AI model definitions with capabilities, sizing, and memory requirements.
- capabilities: array of model_capability enum — chat, reasoning, embed, classify, summarize, vision, audio
- memory_gb: RAM required to run locally via Ollama (null for external-only models)
- parameters_count: model parameter count in raw number (e.g. 27000000000 for 27B)
- props: extensible — {temperature_range, top_p_range, training_cutoff, ...}
Seed data loaded via staging.import_models().'''
}

Table "inference"."reasoning_traces" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [note: 'Foreign key to workspaces — which workspace this reasoning was about. Nullable for system-level.']
  "trigger_event" text [not null, note: 'What triggered this reasoning: ftr_drop, recurring_correction, pattern_emerging, negative_impact, etc.']
  "trigger_detail" jsonb [not null, default: '{}', note: 'Context for the trigger: {ftr_delta, sessions, module, ...}.']
  "models_used" text[] [not null, default: '{}', note: 'Array of model identifiers used in the reasoning panel.']
  "exchanges" jsonb [not null, default: '[]', note: 'Full debate: [{model, role, content, tokens}] in order.']
  "consensus" jsonb [not null, default: '{}', note: 'Final consensus: {conclusion, confidence:0.0-1.0, disagreements:[]}.']
  "action_proposed" jsonb [note: 'Recommendation generated from this reasoning, if any.']

  indexes {
    workspace_id [name: 'reasoning_traces_workspace_id_idx', note: 'where: workspace_id IS NOT NULL']
  }

  Note: '''MOE consensus panel reasoning traces. Stores the full debate between local models.
- trigger_event: what initiated the reasoning (ftr_drop, recurring_correction, pattern_emerging, etc.)
- models_used: ["gemma3:27b", "qwen3:14b", ...]
- exchanges: [{model, role:"proposer"|"challenger"|"synthesizer", content, tokens}]
- consensus: {conclusion, confidence, disagreements:[]}
- action_proposed: the recommendation generated, if any'''
}

Table "sensei"."commits" {
  "repository_id" uuid [pk, not null, note: 'FK to sensei.repositories — the grain, and the reason two checkouts of one remote converge on a single row set instead of each keeping its own. ON DELETE CASCADE: these facts are about the repository and none of them outlive it.']
  "sha" text [pk, not null, note: 'The full commit object id as git reports it (`%H`), verbatim and never truncated. No length constraint — 40 hex characters under sha-1, 64 under sha-256. Unique only WITHIN a repository, hence the composite primary key: a fork, a mirror or a subtree copy legitimately carries the same sha in a different repository.']
  "authored_at" timestamptz [not null, note: 'The AUTHOR date (`%aI`), not the committer date — it survives a rebase and a cherry-pick, so one logical change buckets into the same window through two checkouts. See the table comment for the deliberate divergence from churn.rs. NOT NULL: a commit object always carries an author date, so a value that will not parse is a scan error, never a substituted now().']
  "author_email" text [note: 'The author email as git reports it (`%ae`) — raw, with no mailmap, no lowercasing and no alias folding. Coalescing two addresses into one person is an ownership-READ concern; the stored row stays what git said. NULL when the commit records no author email at all (`<>`): that is UNKNOWN, and it must not become an empty-string pseudo-author that the ownership group-by would count as a contributor. Same rule as a binary file\'s `commit_files.lines_changed`.']

  indexes {
    (repository_id, authored_at) [name: 'commits_repository_id_authored_at_idx', note: 'order: asc, desc']
  }

  Note: '''Every commit of a REPOSITORY — the commit-grain facts the co-change, ownership
and bus-factor derivations read.

- **What it is.** One row per non-merge commit on the TIP SET: `git log
  --branches --remotes --tags`, never `HEAD` alone and never `--all`. HEAD is
  one branch, not the repository; `--all` sweeps `refs/stash` and
  `refs/original`, local debris that two clones will never agree on. On the tip
  set they do agree — of the 4 co-keyed checkout pairs measured on this machine,
  3 produce byte-identical commit sets. Merges are excluded: a merge's numstat
  is a diff against one arbitrary parent, so its touched files record parent
  order rather than a change anyone made. Measured on sensei: 4,060 commits,
  24,588 file touches, median 2 files per commit, p95 20, max 326. Machine-wide
  ~121,780 commits, ~738,000 `commit_files`, ~185 MB.
- **How to use it.** Join `sensei.commit_files` on `(repository_id, sha)` and
  range on `authored_at` for the window — default 90 days, configurable.
  Co-change pairs the files of one commit; ownership groups the same window by
  `author_email` (configurable commits / lines / recency, default commits).
  Drop commits over the bulk cap of 50 files BEFORE pairing: 81.5% of sensei's
  588,865 naive co-change pairs come from the 53 commits that touch more than
  50 files, so the cap is what makes the pair count usable rather than a tuning
  knob.
- **What it is NOT.** Not a mirror of the git object graph — a row outlives the
  commit's reachability, see below. Not scan state: the cursor is
  `sensei.commit_scans`, keyed on `folder_id`, because a scan runs per CHECKOUT
  while these facts are per REPOSITORY. Not the churn metric's source — churn
  walks git live on committer-days and persists nothing.
- **Who writes it.** The `ScanGitHistory` task, insert-only
  (`on conflict do nothing`), running once per checkout but converging on one
  row set per repository. Nothing else writes here and no row is ever updated.

INSERT-ONLY, AND NOTHING IS PRUNED BY REACHABILITY. v1 deleted rows missing from
`rev-list HEAD`, and that was unsound: the facts are repository-grain while scans
run per checkout, and 10 repositories on this machine have more than one anchor
folder — each scan would prune the other's commits and re-walk them, forever.
The prune was also redundant. 4,298 of the 6,654 paths ever touched in sensei
(65%) no longer exist, so they have no `sensei.files` row and cannot reach a
diagram. EXISTENCE on disk is the filter, not reachability. The one deletion is
the age-based retention prune — default 400 days, with an ENFORCED floor of
`retention >= max(window)`, so a prune can never eat the window a derivation is
about to read.

AUTHORED_AT, NOT THE COMMITTER DATE. The author date survives a rebase and a
cherry-pick, so one logical change buckets into the same window through two
checkouts; the committer date is rewritten by both, and the two checkouts would
disagree about when the same change happened. This DIVERGES from `churn.rs`,
which buckets on the committer date (`%cd`). Stated here rather than hidden: the
same commit can land on different days in the two systems, and that is the cost
of making a repository-grain fact stable across checkouts.'''
}

Table "sensei"."dojo_membership_personas" {
  "membership_id" uuid [pk, not null, note: 'sensei.dojo_memberships.id — the service membership id (dojo.memberships.id).']
  "persona_id" uuid [not null, note: 'sensei.personas.id — the person the dōjō lists this membership under (GET /v1/you/memberships).']
  "bound_at" timestamptz [not null, default: `now()`, note: 'When the daemon matched the membership to the persona.']

  indexes {
    persona_id [name: 'dojo_membership_personas_persona_idx']
  }

  Note: '''The persona each local Dōjō membership belongs to — whose session the daemon
presents on that membership's tenant calls (#236 step 4). One persona per
membership; gone with either side.'''
}

Table "sensei"."extension_workspaces" {
  "extension_id" uuid [not null]
  "workspace_id" uuid
  "enabled" boolean [not null, default: true]
  "props" jsonb [not null, default: '{}']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    extension_id [unique, name: 'extension_workspaces_global_uniq', note: 'where: workspace_id IS NULL']
    (extension_id, workspace_id) [unique, name: 'extension_workspaces_scoped_uniq', note: 'where: workspace_id IS NOT NULL']
    workspace_id [name: 'extension_workspaces_workspace_id_idx', note: 'where: enabled AND workspace_id IS NOT NULL']
  }

  Note: '''Many-to-many: extensions (skills/commands/agents/hooks) associated with workspaces or global.
workspace_id NULL = global (active in every workspace).
workspace_id = X  = active only in that workspace.
extensions.scope column is a seeding hint only; this table is authoritative at runtime.'''
}

Table "sensei"."folders" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "root_id" uuid [not null, note: 'Foreign key to folders_to_watch — which watched root this folder was discovered under.']
  "parent_id" uuid [note: 'Self-referencing FK for folder hierarchy. Null means direct child of the watch root.']
  "repository_id" uuid [note: 'FK to sensei.repositories — the global repository this folder belongs to.\n\nSET ON EVERY FOLDER, inherited from its repo anchor at WRITE time by\nupsert_subfolder_kind / upsert_folder. `kind` (git/standalone/subtree) is what\nmarks which folder IS the anchor.\n\nSUPERSEDES I16 (2026-10-01, see docs/decisions.md D-REPO-ANCHOR), which set this\nonly on the anchor and had subfolders resolve via repo_anchor_for. That is a\nset-returning FUNCTION, and a predicate cannot be pushed into a function scan —\n`WHERE workspace = $1` seq-scanned all 13,715 folders with 13,715 function calls to\nanswer a 45-row question, and four of eight views migrated onto it regressed\ncatastrophically (one ~450x). Resolving the anchor once per folder WRITTEN\ninstead of per row READ makes every read a Bitmap Index Scan on\nfolders_repository_id_idx.\n\nNULL only while the scanner has not yet resolved the owning repository.\nON DELETE SET NULL.']
  "workspace_root_id" uuid [note: 'WHICH workspace declares this module as a member — not whether one does.\n\n- Membership is a RELATIONSHIP, so it is stored as one. `kind` says what a\n  folder IS; this says who claims it. Naming the workspace rather than a bare\n  yes/no makes "the members of this workspace" a single indexed lookup.\n- DERIVED from the declaring manifest\'s member list (package.json\n  `workspaces`, Cargo.toml `[workspace] members`), matched on the repo-relative\n  PATH — never on the directory name or its position in the tree. Asserting\n  membership no manifest states is the R4 fabrication.\n- Refreshed on every scan, so a folder that leaves the member list stops\n  reading as a member.\n- NULL means nothing declares it. A real and common state, not "unknown":\n  `marketplace/`, `app/`, `dojo/` and `website/` here are all genuine build\n  units that no workspace lists.\n- KNOWN GAP, named rather than silent: only the REPO ROOT\'s manifest is read\n  today, so a nested workspace root is not detected and its members resolve as\n  undeclared.']
  "kind" sensei.folder_kind [not null, default: 'git', note: 'What this folder IS: git (repository), module (a manifest-bearing build unit inside a repo — a crate, an npm package, a Go module), subtree (nested git repo), standalone (non-git, no git siblings — written only by v1 scan paths, retiring with them), folder (an ordinary directory inside a repo, no manifest).\n\nIt does NOT say who claims the folder. Whether a workspace declares a module is a relationship and lives in workspace_root_id. `workspace_member` and `package` were once two values here; merged, because that split flips for several folders the moment a `workspaces` array is added — nothing about the directory changes — and a kind that moves under an unrelated edit describes the wrong thing.']
  "status" sensei.folder_status [not null, default: 'discovered', note: 'Indexing lifecycle: discovered → queued → indexing → indexed, or failed. Or archived, when the directory is gone but its history is worth keeping.\n\nThere is no "not indexed" state. A folders row exists only for a repo root or a manifest-bearing directory, and every one of those is indexed; a directory we do not index has no row at all.']
  "role" sensei.folder_role [note: 'Workspace role assigned during setup: backend, frontend, library, docs, infra. Null until assigned.']
  "name" text [not null, note: 'Display name — typically the directory basename.']
  "path" text [not null, note: 'Path relative to the watch root (e.g. "clients/acme/api").']
  "abs_path" text [not null, unique, note: 'Absolute filesystem path for watcher setup and deduplication.']
  "stack" jsonb [not null, default: '[]', note: 'Detected technology stack as JSON array: ["rust", "typescript"]. Set by ProcessGitFolder from config files (Cargo.toml, package.json, etc.).']
  "remote_urls" jsonb [not null, default: '[]', note: 'JSON array of git remotes: [{name: "origin", url: "git@..."}]. Empty for non-git folders.']
  "icons" jsonb [not null, default: '{}', note: 'JSON object for display icons: {emoji, devicon, custom}.']
  "props" jsonb [not null, default: '{}', note: 'Extensible JSON metadata. For git/subtree: {role, lang, files, loc, stack:{languages,frameworks,runtimes}, libs, indexed_at, last_error, duplicate_of, label}.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for quick filtering. Vocabulary controlled by sensei.tags table.']
  "branch" text [note: 'The checked-out branch for this checkout folder (develop vs main = two folders, one repository). Metrics-only seam — does NOT make the code graph branch-aware.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    root_id [name: 'folders_root_id_idx']
    parent_id [name: 'folders_parent_id_idx']
    kind [name: 'folders_kind_idx']
    status [name: 'folders_status_idx']
    tags [type: gin, name: 'folders_tags_idx']
    repository_id [name: 'folders_repository_id_idx', note: 'where: repository_id IS NOT NULL']
    workspace_root_id [name: 'folders_workspace_root_id_idx', note: 'where: workspace_root_id IS NOT NULL']
  }

  Note: '''The scanned filesystem tree — every directory sensei considered worth indexing,
discovered by walking a watched root.

## What a row is

- A directory that is either a repository, a manifest-bearing build unit inside
  one, or an ordinary folder beneath those. A directory sensei does not index
  has NO row here — there is no "not indexed" state to look for.
- Unique on `abs_path`, so one directory is one row no matter how many roots or
  scans reach it.

## Three independent axes, deliberately not collapsed

- **What it IS** — `kind`. A property of the directory alone.
- **Where it is in the LIFECYCLE** — `status`. Changes as indexing progresses;
  says nothing about what the folder is.
- **Who CLAIMS it** — `repository_id` (which repository owns it) and
  `workspace_root_id` (which workspace declares it as a member). Both are
  relationships, so both are stored as FKs rather than folded into `kind`.

Collapsing any two of these is the mistake this shape exists to prevent: a
`kind` that moves when an unrelated manifest gains a `workspaces` array is
describing the wrong thing.

## How to find a workspace's folders

A folder does NOT carry a workspace. That column existed until #211 and was
settable per folder, so a repository's folders could disagree about their
workspace — and they did. Membership now lives in
`sensei.repositories_in_workspaces`, keyed on the REPOSITORY. Resolve through
`sensei.folder_workspaces`, which is
`folders.repository_id` -> `repositories_in_workspaces` -> `workspaces`:

    SELECT folder_id FROM sensei.folder_workspaces WHERE workspace = 'sensei'

That resolution is MULTI-VALUED by design: a repository is keyed on its remote,
so one serving two workspaces yields a row for each.

## Common queries

    -- the repositories under a watch root
    SELECT name, abs_path FROM folders WHERE root_id = $1 AND kind = 'git'
    -- the build units a workspace declares
    SELECT name FROM folders WHERE workspace_root_id = $1
    -- what is still mid-flight
    SELECT abs_path, status FROM folders WHERE status NOT IN ('indexed', 'archived')

## Invariants a caller can rely on

- `root_id` is NOT NULL and agrees with `abs_path`: the watch root is always the
  longest `folders_to_watch.path` prefixing it. Checked by the index audit's
  misrooted-folders class, so it is enforced rather than assumed.
- `repository_id` is carried by EVERY folder, inherited from its repo anchor at
  write time — not only by the repo root. `kind` still marks which folder IS the
  anchor.
- `parent_id` NULL means a direct child of the watch root.'''
}

Table "sensei"."library_enablement" {
  "library_id" uuid [not null]
  "workspace_id" uuid
  "enabled" boolean [not null, default: true]
  "props" jsonb [not null, default: '{}']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    library_id [unique, name: 'library_enablement_global_uniq', note: 'where: workspace_id IS NULL']
    (library_id, workspace_id) [unique, name: 'library_enablement_scoped_uniq', note: 'where: workspace_id IS NOT NULL']
    workspace_id [name: 'library_enablement_workspace_id_idx', note: 'where: enabled AND workspace_id IS NOT NULL']
  }

  Note: '''Many-to-many: libraries associated with workspaces or marked global.
workspace_id NULL = global (available in every workspace).
workspace_id = X  = scoped to that workspace only.
Populated by daemon indexer from referenced_libraries; editable by user.'''
}

Table "sensei"."library_packages" {
  "package_name" text [pk, not null, note: 'Ecosystem-qualified name as a dependency file spells it (@rokkit/ui) — matches what detection stored, so resolution is an equality join.']
  "library_id" uuid [not null, note: 'FK to libraries — the parent whose skills/agents this package should resolve to.']
  "source" text [not null, default: 'manifest', note: 'Provenance: manifest (declared) — reserved for a future curated/registry writer.']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    library_id [name: 'library_packages_library_id_idx']
  }

  Note: '''Packages a library publishes under other names (rokkit → @rokkit/ui, …), declared
in its sensei.library.json `packages` array. Lets a workspace that depends on
@rokkit/ui resolve to the library whose skills/agents hang off the `rokkit` row —
the two identities dependency detection and the manifest produce. Declared, never
prefix-inferred: a guess would claim packages in a shared scope that belong to
someone else. Keyed on package_name because a package belongs to one library.'''
}

Table "sensei"."library_versions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "library_id" uuid [not null]
  "version" text [not null, note: 'An ACTUAL version, or \'unknown\' when it has not been established. NEVER \'latest\' — latest is a TAG (is_latest), not a version. Keying content on \'latest\' fabricates: at migration rokkit\'s 94 pages were keyed that way while its real version, 1.4.1, was readable from package.json on disk.\n\nAn ACTUAL version, or the literal \'unknown\' when it has not been established. NEVER \'latest\' — that is a TAG (see is_latest), not a version, and conflating them fabricates: at migration rokkit\'s 94 pages were keyed \'latest\' while its real version, 1.4.1, sat in the package.json on disk. \'unknown\' says what we know; \'latest\' claimed something we had not established.']
  "resolved_version" text [note: 'The concrete version a fetch resolved to when the request was for a moving target. NULL when unknown. This is what makes "is our latest still latest?" answerable — the question library_update_scheduler asks.']
  "source_type" sensei.library_source_type [note: 'How THIS version\'s pages were fetched: llms.txt | http | local.']
  "base_url" text [note: 'Docs root for this version. Version-scoped: a website documents one version and its URL is wrong for older pins.']
  "docs_url" text [note: 'Docs entry point for this version. See base_url.']
  "local_path" text [note: 'On-disk location of this version\'s docs, when source_type is local.']
  "page_count" int [not null, default: 0, note: 'Denormalised count of this version\'s library_content rows of kind \'page\' — per version, not per library.']
  "is_latest" boolean [not null, default: false, note: 'Whether this is the library\'s current version — a movable TAG, at most one per library (partial unique index). Separate from `version` deliberately: "which version is this" and "is this the current one" are different questions, and answering the first with the second is how a stale row starts claiming to be current.\n\nTHE TAG. Which registered version is currently the latest, as a movable pointer rather than a magic value in `version`. At most one per library, enforced by a partial unique index — not merely intended.']
  "fetched_at" timestamptz [note: 'When this version\'s content was last fetched. Migrated from libraries.indexed_at.']
  "props" jsonb [not null, default: '{}']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    (library_id, version) [unique, note: 'unique constraint']
    library_id [name: 'library_versions_library_id_idx']
    library_id [unique, name: 'library_versions_one_latest', note: 'where: is_latest']
  }

  Note: '''One fetched version of a library's documentation (S7b). Pages, skills and
agents reference a VERSION so docs can be version-specific; a workspace pinned at
1.2 must not be served a website's latest-only docs as though they matched.
The fetch columns (source_type, base_url, docs_url, local_path, page_count)
live here rather than on libraries because they are version-scoped — a docs URL
goes stale for older pins, while a repo homepage does not, which is why
libraries.homepage_url stays put.'''
}

Table "sensei"."mcp_servers" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "acp_family" text [not null]
  "mcp_key" text [not null]
  "scope" text [not null]
  "workspace_id" uuid
  "config_source" text [not null]
  "command" text [not null, default: '']
  "args" jsonb [not null, default: '[]']
  "env" jsonb [not null, default: '{}']
  "enabled" boolean [not null, default: true]
  "connection_state" text [not null, default: 'unknown']
  "last_error" text
  "last_seen_at" timestamptz [not null, default: `now()`]
  "discovered_at" timestamptz [not null, default: `now()`]

  indexes {
    (acp_family, mcp_key) [unique, name: 'mcp_servers_user_unique', note: 'where: scope = \'user\'']
    (acp_family, mcp_key, workspace_id) [unique, name: 'mcp_servers_workspace_unique', note: 'where: scope = \'project\'']
    workspace_id [name: 'mcp_servers_workspace_idx']
    acp_family [name: 'mcp_servers_family_idx']
    enabled [name: 'mcp_servers_enabled_idx']
    last_seen_at [name: 'mcp_servers_last_seen_idx']
  }

  checks {
    `scope IN ('user', 'project')`
    `connection_state IN ('unknown', 'connected', 'error', 'disabled')`
    `(scope = 'user' AND workspace_id IS NULL) OR (scope = 'project' AND workspace_id IS NOT NULL)`
  }

  Note: '''#84 T2 Slice A. MCP servers discovered from ACP config files (Claude Code,
Zed, Cursor, Codex, OpenCode, …). One row per (acp_family, mcp_key, scope,
workspace). Scanned on daemon start and manual refresh. Consumed by the
Instruments Playground / Replay / Health tabs.'''
}

Table "sensei"."memory_share_batches" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [not null, note: 'FK to workspaces — batches are always scoped to a single workspace.']
  "status" sensei.memory_share_batch_status [not null, default: 'proposed', note: 'Lifecycle stage. `proposed` and `withdrawn` have decided_at NULL; `approved` and `rejected` require decided_at.']
  "note" text [note: 'Optional free-text rationale attached at approve or reject time.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the batch was proposed.']
  "decided_at" timestamptz [note: 'When the batch was approved or rejected. NULL while proposed or if withdrawn.']

  indexes {
    (workspace_id, status, created_at) [name: 'memory_share_batches_workspace_idx', note: 'order: asc, asc, desc']
    (workspace_id, created_at) [name: 'memory_share_batches_proposed_idx', note: 'where: status = \'proposed\'\norder: asc, desc']
  }

  checks {
    `(status IN ('proposed', 'withdrawn') AND decided_at IS NULL) OR (status IN ('approved', 'rejected') AND decided_at IS NOT NULL)`
  }

  Note: '''Batched proposal to share memories from a workspace to the federation.
Users review a group of learned memories together and approve or reject
the batch as a unit. On approve, the daemon iterates the linked members
and pushes each to the configured DÅjÅ. Kept as a first-class
entity (not a memory-status flag) so verdicts stay auditable and the
UI can surface a per-workspace "pending review" queue.
- proposed: created, awaiting user decision
- approved: user accepted — the federation writer picks it up
- rejected: user declined
- withdrawn: user cancelled before deciding'''
}

Table "sensei"."metric_deactivations" {
  "repository_id" uuid [pk, not null, note: 'The repository, by its stable id. `repo_key` is what the dōjō speaks (it is the identity both planes share), resolved to an id on write so this table joins like every other repo-scoped table and cascades when a repository goes.']
  "metric_key" text [pk, not null, note: 'Catalogue key, not an id — sensei.metrics.id differs between the daemon and dōjō planes. Intentionally not an FK: a dōjō may name a metric this install has not seeded, and an unknown key should match nothing rather than fail the write.']
  "observed_at" timestamptz [not null, default: `now()`, note: 'When the daemon last learned this. Distinguishes a ruling confirmed this cycle from one left behind by a sync that has since stopped running.']

  Note: '''Metrics NO consuming dōjō wants, per repository — the daemon-side UNION of
dojo.metric_activations. One row = every tenant sharing this repository switched
this metric off, so the compute is skippable. Absence = wanted, which is the
default and needs no seeding. Rewritten whole on each successful plan pull;
`observed_at` says when. Caching is correct here and wrong for the entitlement
ruling: staleness costs a cycle of compute, never consent.'''
}

Table "sensei"."metric_watermarks" {
  "repository_id" uuid [pk, not null, note: 'The repository this watermark tracks (FK sensei.repositories, ON DELETE CASCADE).']
  "metric_group" text [pk, not null, note: 'The compute group (registry task_name + cadence, e.g. \'session_outcomes\', \'churn\') this cursor is for. Free text — groups are code-defined.']
  "sealed_through" date [note: 'Day-cadence: the last calendar date the group is settled through (today is never sealed). NULL until the first run.']
  "last_sha" text [note: 'Commit-cadence (churn/quality): the last commit sha the group walked through. NULL for day-cadence groups / until the first run.']
  "updated_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last watermark advance.']

  Note: '''Per-(repository, metric_group) compute watermark — the coverage cursor that retires
covered_days/effective_from + the global metrics.last_run (D4). day-cadence groups
seal calendar days in sealed_through (today never sealed; late data reopens);
commit-cadence groups (churn/quality) track the last walked commit in last_sha.
Advanced only on a group's successful compute — a failed group holds its cursor and
retries (fail-closed, never a silent skip). Cascades on a repository delete.'''
}

Table "sensei"."namespaces" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "scope_key" text [not null, note: 'Which scope this namespace instantiates (FK to scopes.key).']
  "name" text [not null, note: 'Display name (e.g. "Sensei HQ").']
  "slug" text [not null, note: 'Normalized identifier, unique within a scope (e.g. "sensei-hq").']
  "level" int [note: 'Optional per-namespace override of scopes.level. Null = inherit from scope.']
  "props" jsonb [not null, default: '{}', note: 'Extensible metadata (icons, source, etc.).']
  "visibility" sensei.namespace_visibility [not null, default: 'private', note: 'private | public. For workspace-scope namespaces this is the workspace\'s visibility; a member consumes a tenant billing seat only through a `private` workspace. Other scopes carry the default and are ignored by billing. Defaults to private (opt into public, never accidentally out).']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (scope_key, slug) [unique, name: 'namespaces_unique_identity', note: 'unique constraint']
    scope_key [name: 'namespaces_scope_key_idx']
  }

  Note: '''Concrete instances of a scope — e.g. (organization, "Sensei HQ"),
(workspace, "sensei"), (repository, "github.com/sensei-hq/sensei"). A repo belongs
to a SET of these (via repository_namespaces, or for a `workspace` namespace via the
workspace of the same name); there is no parent_id tree — precedence comes from the
scope level (optionally overridden per namespace). Created at scan time from README
frontmatter (organization/workspace); a repository's own namespace is made when a
detected stack adopts its pack there (sensei.repository_namespace, #318 R6).'''
}

Table "sensei"."persona_emails" {
  "persona_id" uuid [pk, not null]
  "email" text [pk, not null]
  "source" text [not null, default: 'git']
  "linked_at" timestamptz [not null, default: `now()`]
  "removed_at" timestamptz [note: 'Soft delete. A removed address still explains the rows it produced, and the auth flow needs "linked then removed" to be distinguishable from "never linked".']

  indexes {
    `lower(email)` [unique, name: 'persona_emails_live_unique', note: 'where: removed_at IS NULL']
    persona_id [name: 'persona_emails_persona_idx', note: 'where: removed_at IS NULL']
  }

  checks {
    `source IN ('git', 'claimed')`
  }

  Note: '''Git author emails belonging to a persona — the lookup that resolves
repository_metrics.identity to a readable working identity.

source = git: observed in commit history, UNVERIFIED (any author can write any
address). Usable locally; never sufficient to attribute work to a person in dōjō.
source = claimed: matched against a provider-verified address, so mailbox control
is proven.'''
}

Table "sensei"."playbook_rules" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" text [not null]
  "match_lifecycle" sensei.chunk_lifecycle
  "match_intent" sensei.chunk_intent
  "match_risk" sensei.chunk_risk
  "playbook" text [not null]
  "rationale" text [not null]
  "priority" int [not null]
  "base_priority" int
  "enabled" boolean [not null, default: true]
  "source" sensei.source_kind [not null, default: 'builtin', note: '`source_kind`, not text+CHECK: the same three values were duplicated as a separate constraint on sensei.playbooks. See ddl/enum/sensei/source_kind.ddl.']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`, note: 'Bumped whenever the row changes. The staging import guards on it: a re-import only overwrites a row when the DATAFILE\'s stamp is at least as new, so an edit made in place survives redeployment. Without this column the import had nothing to compare and fell back to clobbering (playbooks) or to never updating at all (intake_guide, playbook_rules) — see docs/backlog.md.']

  indexes {
    (enabled, priority) [name: 'playbook_rules_match_idx', note: 'order: asc, desc']
    playbook [name: 'playbook_rules_playbook_idx']
    (match_lifecycle, match_intent, match_risk, playbook) [unique, name: 'playbook_rules_learned_uq', note: 'where: source = \'learned\'']
    name [unique, name: 'playbook_rules_name_unique']
  }
}

Table "sensei"."repositories_in_workspaces" {
  "workspace_id" uuid [pk, not null, note: 'The workspace this repository belongs to. CASCADE on delete: membership is a\nstatement about a workspace that exists, so deleting the workspace removes the\nclaim rather than leaving a row pointing at nothing.\n\nA repository may appear here more than once, under different workspaces — that is\nthe point of the table. See the table comment for why a column on `repositories`\ncould not express it.']
  "repository_id" uuid [pk, not null, note: 'The CANONICAL repository (keyed on remote), not a checkout. Two checkouts of one remote share this id, which is precisely why a workspace cannot be stored on the repository row itself.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the membership was recorded. NOT when the repository was scanned and not\nwhen the workspace was created — a repository can be scanned long before anyone\nassigns it, and a workspace can exist with no repositories at all.\n\nCarried so a membership that appeared without anyone intending it can be told\napart from one that was always there. The 2026-09-30 backfill and a user edit\nare otherwise indistinguishable.']

  indexes {
    repository_id [name: 'repositories_in_workspaces_repository_id_idx']
  }

  Note: '''Workspace ↔ repository membership — the ONE place it lives, replacing
`folders.workspace_id` (decision changed 2026-09-30, superseding D1/D2/D10).

WHY A TABLE AND NOT A COLUMN ON `repositories`: a repository is keyed on its
REMOTE, so two checkouts of one remote are one row there. Four repositories
measured 2026-09-30 serve two workspaces each — `kavach` in `kavach` and
`vite-multi-adapter`, `bridge` in `bridge` and `sparsh`. A column would force each
to pick one and drop the other silently.

WHY NOT ON FOLDERS, which is what this replaces: `workspace_id` was settable
independently on all 13,697 folders, so a repository's folders could disagree —
and the client-q documentation repo already did, root in one workspace and its 362
subfolders in another. Keying on the repository makes the drift unrepresentable
instead of merely unlikely.

RESOLUTION IS MULTI-VALUED BY DESIGN. A folder reaches its workspace through its
repo anchor (`repo_anchor_for` → `folders.repository_id` → here). A repository in
two workspaces yields two rows, because its nodes genuinely belong to both; a
consumer needing exactly one must name which, rather than be handed an arbitrary
pick that looks authoritative.'''
}

Table "sensei"."repository_metrics" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "metric_id" uuid [not null, note: 'FK to sensei.metrics — which registered metric this value is for.']
  "repository_id" uuid [not null, note: 'The grain. A value is attributed to the repository, regardless of which workspace(s) include it — which is why the same number is shared rather than recomputed per workspace.\n\nNOT NULL now. It was nullable for "legacy rows pending migration"; that migration is done (0 nulls), so the column states the invariant instead of documenting an exception that no longer exists.']
  "scope" sensei.metric_scope [not null, default: 'user', note: 'repo (whole repository, all authors) vs user (this identity\'s own commits ∩ touched files).']
  "identity" text [note: 'For scope=user, the git author email the value is attributed to. NULL for scope=repo. Kept as the RAW git assertion; a resolved persona FK is layered on top rather than replacing it, so re-attribution stays a re-derivation instead of a destructive edit.']
  "persona_id" uuid [note: 'The persona `identity` resolves to. NULLABLE and DERIVED — never a replacement for the raw email above. Resolving at write time would be a destructive merge: each row came from `git log --author=<email>`, so combining two aliases must SUM, and a later persona reassignment would have no source left to recompute from. Keeping both makes re-attribution a re-derivation over immutable raw attribution.']
  "commit_sha" text [note: 'The sampled commit a commit-cadence value was computed at (quality/churn/coverage). NULL for day-cadence values.']
  "computed_on" date [not null, note: 'The date the value is FOR (not when it was computed).']
  "grain" sensei.metric_grain [not null, note: 'Grain of the row. Only \'daily\' is written today.']
  "value" numeric [not null, note: 'The computed value. Its meaning is defined by metrics.type/unit/direction.']
  "props" jsonb [not null, default: '{}', note: 'Extensible parts: numerator/denominator, session_count, correction_count, low_n, evidence ids.']
  "computed_by" sensei.metric_computed_by [not null, default: 'local', note: 'WHO computed this row — the loop-breaker for pull-else-compute. Without it local cannot tell a value dōjō handed down from one it produced, so it recomputes the shared value and pushes it back, forever.']
  "shared_at" timestamptz
  "source" sensei.metric_source [not null, default: 'measured', note: 'Provenance: measured | estimated. estimated is never rendered as truth.']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    (metric_id, repository_id, scope, identity, commit_sha, computed_on, grain) [unique, name: 'repository_metrics_identity', note: 'nulls not distinct']
    (repository_id, metric_id, computed_on) [name: 'repository_metrics_repository_idx']
    (persona_id, metric_id, computed_on) [name: 'repository_metrics_persona_idx', note: 'where: persona_id IS NOT NULL']
  }

  Note: '''The value store — every computed metric value, at repository + date grain. All
aggregation (week/month/quarter/trend) and the derived health score are views
over this one table.

Never-fabricate invariants:
  - No data => no row. Absence reads as "not yet measured," never a defaulted 0.
  - Ratios carry their parts. A ratio/pct row stores props.numerator +
    props.denominator so roll-ups re-derive (never average-of-averages).
  - Estimates tagged. source='estimated' is never rendered as truth; money-facing
    metrics write no row on a price miss (fail closed).'''
}

Table "sensei"."service_workspaces" {
  "service_id" uuid [not null, note: 'FK to services — the MCP server / inference provider being scoped.']
  "workspace_id" uuid [note: 'FK to workspaces — null for the global row (default for every workspace), otherwise the workspace-specific override.']
  "enabled" boolean [not null, default: true, note: 'Whether this scope activates the service. false disables the service for the given workspace (or globally when workspace_id is null).']
  "props" jsonb [not null, default: '{}', note: 'Per-scope config overrides (JSONB) — e.g. workspace-specific env, endpoint, or budget.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    service_id [unique, name: 'service_workspaces_global_uniq', note: 'where: workspace_id IS NULL']
    (service_id, workspace_id) [unique, name: 'service_workspaces_scoped_uniq', note: 'where: workspace_id IS NOT NULL']
    workspace_id [name: 'service_workspaces_workspace_id_idx', note: 'where: enabled AND workspace_id IS NOT NULL']
  }

  Note: '''Per-workspace scope for services (MCP servers, inference providers).
workspace_id NULL = global (active in every workspace).
workspace_id = X  = active only in that workspace.
services.installed is the top-level "is this installed" flag; this table
controls whether an installed service is enabled for a given workspace so
the Instruments playground can offer per-workspace MCP configurations.'''
}

Table "sensei"."trackers" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "workspace_id" uuid [not null, note: 'The sensei workspace this board belongs to. Unique: a workspace has exactly one tracker. ON DELETE CASCADE, and the delete trigger still tombstones the secret.']
  "kind" sensei.tracker_kind [not null, note: 'Which adapter speaks to this tracker (crate::tracker::adapter_for_kind).']
  "base_url" text [not null, note: 'Adapter-normalised origin, exactly "https://" + lowercase host, no port/path/slash (crate::tracker::http::normalize_base_url). Part of the board identity.']
  "account" text [not null, note: 'The account the token belongs to, as the adapter defines it (Jira: the Atlassian email). Keyring account of secret_service.']
  "external_scope" text [not null, note: 'The provider scope shown to users (Jira: the board\'s project key, or the board name for a multi-project board).']
  "board_ref" text [not null, note: 'The board, in the adapter\'s canonical form (Jira: decimal board id, no leading zeros) so one board cannot be connected twice under two spellings.']
  "params" jsonb [not null, default: '{}', note: 'Adapter-specific extras (e.g. board_name). Never secrets.']
  "secret_service" text [not null, note: 'Keyring service of the API token, com.sensei.tracker.<kind>.<credential uuid>; a fresh uuid on every connect, so an entry is never overwritten in place. Changing it tombstones the old value.']
  "last_attempt_at" timestamptz [note: 'When a sync last started (written before the fetch, outside any transaction).']
  "last_success_at" timestamptz [note: 'When a sync last committed in full. NULL = never (status pending), also reset by a re-connect.']
  "last_error" sensei.tracker_error [note: 'Failure code of the last sync or connect; NULL after a success. Never a raw message.']
  "discovered_through" timestamptz [not null, default: `now()`, note: 'R11 watermark: transcript turns ingested up to here have been checked for ticket keys the tracker does not have yet. Starts at connect time; the first full sync covers what came before.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the connection was first made.']

  indexes {
    workspace_id [unique, note: 'unique constraint']
    (kind, base_url, board_ref) [unique, note: 'unique constraint']
  }

  Note: 'An issue-tracker board connected to a sensei workspace: one tracker per workspace (one sprint calendar) and one workspace per board. Read-only mirror source for sensei.sprints / sensei.tracker_tasks. The API token is never stored here; secret_service names its keyring entry. Deleting a row (or its workspace) tombstones that entry via the tracker_secret_tombstone trigger.'
}

Table "activity"."run_events" {
  "id" bigserial [pk, not null]
  "run_id" uuid [not null]
  "kind" sensei.run_event_kind [not null]
  "phase" text
  "feature" text
  "detail" jsonb [not null, default: '{}', note: 'Structured, stripped event payload (e.g. {"reset_at": …} for paused_on_limit). No code, no diffs.']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (run_id, created_at) [name: 'run_events_run_idx', note: 'order: asc, desc']
    (kind, created_at) [name: 'run_events_kind_idx', note: 'order: asc, desc']
  }

  Note: '''Append-only cadence log for a run — the source of the filtered Relay feed AND the
audit trail. One row per logical event (feature shipped · gate raised · paused on
limit · resumed · crashed · housekeeping · …). Logical progress only — never diffs
or raw tool output (D10). bigserial: high write volume.'''
}

Table "activity"."sessions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [note: 'Raw cwd provenance — the exact folder the session ran in. Nullable + ON DELETE\nSET NULL so pruning that folder can never delete the session (spec 2026-08-18, I2).\nAttribution keys off repo_folder_id, not this.']
  "repo_folder_id" uuid [note: 'The DURABLE repo anchor: the nearest repo-kind ancestor (git/subtree/standalone\nworkspace-root) resolved by sensei.repo_anchor_for. Recency, FTR, metrics, and the\nworkspace rollup key off this so a session belongs to a repo, never a transient folder.']
  "repo_key" text [note: 'Stable repo identity — the primary git remote URL (else the repo abs_path). Lets\nattribution survive a full folder-row rebuild (spec 2026-08-18, D2).']
  "workspace_id" uuid [note: 'Foreign key to workspaces — derived from the repo anchor.']
  "task" text [not null, default: '', note: 'Task description passed at get_session_context.']
  "acp_id" text [note: 'Assistant family name (matches sensei.assistants.family): claude, cursor, codex, aider, etc.']
  "client_session_id" text [note: 'The assistant\'s own session id (e.g. Claude session_id from hooks). Correlates all hook events of one session to a single row; NULL for MCP-created sessions.']
  "outcome" sensei.session_outcome [note: 'Session outcome: completed, corrected, blocked, partial, abandoned.']
  "ftr" boolean [note: 'First-Try Rate: true if zero corrections.']
  "turns" int [not null, default: 0, note: 'Number of user turns.']
  "corrections" int [not null, default: 0, note: 'Number of user corrections (FTR detractor).']
  "tokens_in" bigint [note: 'Total input tokens consumed.']
  "tokens_out" bigint [note: 'Total output tokens generated.']
  "tokens_fresh" bigint [note: 'Fresh (uncached) input tokens for the session. `tokens_in` keeps its meaning as the folded total of everything the model processed; this is its uncached part. Split because cache reads are 96-98% of input and bill far cheaper, so cost read off the folded total is roughly 8x high. See docs/database/activity.md.']
  "cache_read" bigint
  "cache_write" bigint
  "tokens_reasoning" bigint
  "metered_cost" numeric [note: 'Metered cost in whole currency units, where the source knows it (OpenCode). 0.0 is a REAL reading on a subscription plan — distinct from NULL, "not reported". Subscription cost is user-configured; see crate::cost.']
  "list_cost_usd" numeric [note: 'The session\'s cost at list price in US dollars, as Claude Code\'s /cost totals it, reported by the sensei plugin\'s usage mod (SessionMeasure, #238). The largest total any measure reported: it only grows within a session, and a dead-lettered measure may be drained late. NOT billed spend: on a subscription the plan fee is what is paid (crate::cost), and metered_cost holds a source\'s billed figure. NULL when no measure carried a cost.']
  "duration" interval [note: 'Gap-aware active work time (excludes idle gaps > threshold). The full\nwall-clock span is started_at..completed_at; per-turn/segment detail lives in\nactivity.turns.']
  "module" text [note: 'Primary code module touched. For per-module FTR.']
  "summary" text [note: 'Brief summary of what happened in this session. Populated at checkpoint time by the assistant.']
  "provider" text [note: 'Inference provider that ran this session (e.g. anthropic, openai, copilot_chat, ollama). Captured from the transcript at synthesis (#75); NULL for live hook-captured sessions whose model the hook stream doesn\'t carry. Powers effectiveness-by-model.']
  "model" text [note: 'Specific model that ran this session (e.g. claude-opus-4, GPT-5, Grok Code Fast 1). See provider. Powers effectiveness-by-model insights.']
  "props" jsonb [not null, default: '{}', note: 'Extensible: {patterns_matched, personas_applied, workflow_phase, ...}.']
  "evidence" jsonb
  "started_at" timestamptz [not null, default: `now()`, note: 'When this session started.']
  "completed_at" timestamptz [note: 'When this session ended.']
  "analyzed_at" timestamptz [note: 'When the analyzer last enriched this session (#67). The scheduler skips a\nsession whose assistant_events are no newer than this — incremental re-analysis.']
  "backfilled" boolean [not null, default: false]
  "meta_synced_at" timestamptz [note: 'When the transcript backfill last attempted to capture this session\'s\ninference model + token usage from the source transcript. Set once the attempt\nruns (whether or not the source carried the values), so a session whose source has\nno tokens (e.g. a Zed thread) is not re-read on every backfill cycle. NULL ⇒ never\nattempted ⇒ eligible for the one-time metadata backfill.']
  "process_analyzed_at" timestamptz [note: 'When the LLM process-quality analyzer last scored this session (spec\n2026-08-20). Gates the daily incremental pass: NULL ⇒ never scored ⇒ eligible;\nset to now() after a successful pass. Cleared when a transcript re-ingest bumps\nthe session so its judgments are recomputed. props.process holds the judgments;\nactivity.session_process_evidence holds the cited turns.']

  indexes {
    (folder_id, started_at) [name: 'sessions_folder_id_idx', note: 'order: asc, desc']
    (workspace_id, started_at) [name: 'sessions_workspace_id_idx', note: 'where: workspace_id IS NOT NULL\norder: asc, desc']
    (repo_folder_id, started_at) [name: 'sessions_repo_folder_id_idx', note: 'where: repo_folder_id IS NOT NULL\norder: asc, desc']
    ftr [name: 'sessions_ftr_idx', note: 'where: ftr IS NOT NULL']
    client_session_id [unique, name: 'sessions_client_session_id_uniq', note: 'where: client_session_id IS NOT NULL']
  }

  Note: '''AI coding sessions captured by hooks.
- outcome: completed (no corrections), corrected, blocked, partial (crash), abandoned
- ftr: true if corrections == 0 (First-Try Rate)
- module: primary code module touched (for per-module FTR tracking)
- props: {patterns_matched, personas_applied, workflow_phase, ...}'''
}

Table "gateway"."fallback_chain_models" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "chain_id" uuid [not null, note: 'Foreign key to fallback_chains — which chain this entry belongs to.']
  "router_id" uuid [not null, note: 'Foreign key to routers — which API endpoint to use for this attempt.']
  "model_id" uuid [not null, note: 'Foreign key to models — which model to try at this position.']
  "sequence_order" int [not null, note: 'Position in the chain: 1 = primary, 2 = first fallback, etc.']
  "max_retries" int [not null, default: 1, note: 'How many times to retry this specific model before moving to next in chain.']
  "is_active" boolean [not null, default: true, note: 'Whether this chain entry is currently active.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (chain_id, sequence_order) [unique, note: 'unique constraint']
    chain_id [name: 'fallback_chain_models_chain_id_idx']
    router_id [name: 'fallback_chain_models_router_id_idx']
    model_id [name: 'fallback_chain_models_model_id_idx']
  }

  Note: '''Ordered model entries within a fallback chain.
sequence_order defines the try-order: 1 = first attempt, 2 = first fallback, etc.
Seed data loaded via staging.import_fallback_chain_models().'''
}

Table "gateway"."models_in_router" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "router_id" uuid [not null, note: 'Foreign key to routers — which API endpoint serves this model.']
  "model_id" uuid [not null, note: 'Foreign key to models — which model is available.']
  "router_model_id" text [not null, note: 'The model identifier used by this router (e.g. "gemma3:27b", "claude-haiku-4-5-20251001").']
  "cost_per_input_token" numeric(12,10) [not null, default: 0, note: 'Cost per input token in USD. 0 for local models.']
  "cost_per_output_token" numeric(12,10) [not null, default: 0, note: 'Cost per output token in USD. 0 for local models.']
  "cost_per_request" numeric(10,6) [not null, default: 0, note: 'Fixed cost per request in USD. 0 for most models.']
  "is_active" boolean [not null, default: true, note: 'Whether this model-router combination is currently usable.']
  "is_default" boolean [not null, default: false, note: 'Whether this is the primary endpoint for this model.']
  "props" jsonb [not null, default: '{}', note: 'Extensible: {max_concurrent, supports_streaming, supports_tools, ...}.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (router_id, model_id) [unique, note: 'unique constraint']
    router_id [name: 'models_in_router_router_id_idx']
    model_id [name: 'models_in_router_model_id_idx']
  }

  Note: '''Junction: which models are available on which router, with pricing.
- router_model_id: the identifier the router uses for this model (e.g. "gemma3:27b" for Ollama, "claude-haiku-4-5-20251001" for Anthropic)
- cost_per_input/output_token: 0 for local routers (Ollama), per-token pricing for external
- is_default: primary endpoint for this model (if available on multiple routers)
- props: extensible — {max_concurrent, supports_streaming, supports_tools, ...}
Seed data loaded via staging.import_models_in_router().'''
}

Table "inference"."communities" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which repo this community was detected in.']
  "community_id" int [not null, note: 'Leiden-assigned cluster integer. Matches nodes.community_id.']
  "label" text [note: 'Human-readable label for this community (e.g. "auth module", "CRDT sync").']
  "description" text [note: 'One-paragraph summary of what this community does.']
  "node_count" int [not null, default: 0, note: 'Number of nodes assigned to this community.']
  "god_node_ids" uuid[] [not null, default: '{}', note: 'UUIDs of top-5 members by degree, counted from the adjacency detect_communities builds (semantic edges + parent containment). Not from a stored column.']
  "props" jsonb [not null, default: '{}', note: 'Enrichment provenance/metadata. props.source records how `description` was\nproduced: \'narration-cache\' (model-authored) or \'null\' (honest-empty on model\nfailure) — never a static template (D4.5 never-fabricate).']
  "computed_at" timestamptz [not null, default: `now()`, note: 'Timestamp when Leiden algorithm last ran for this cluster.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (folder_id, community_id) [unique, note: 'unique constraint']
    folder_id [name: 'communities_folder_id_idx']
  }

  Note: '''Leiden algorithm community clusters. Computed offline as a batch job.
- community_id: integer cluster ID (referenced by nodes.community_id)
- god_node_ids: top-5 highest-degree nodes in this community. Degree is counted
--   from the adjacency detect_communities already builds, not from a stored column
--   (nodes.degree was dropped: a cache of a count(*) whose only consumer was this)
- node_count: denormalized count of nodes in this cluster'''
}

Table "inference"."detected_patterns" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [not null, note: 'Foreign key to workspaces — the scoping key. Patterns aggregate at workspace level (#82).']
  "folder_id" uuid [note: 'Optional foreign key to folders — the file/folder locus for file-scoped signals (churn). Nullable; SET NULL on folder delete.']
  "name" text [not null, note: 'Pattern name (e.g. "Adapter", "Duplicated auth guard", "God node · router.ts").']
  "family" text [note: 'Pattern family: GoF · structural, GoF · behavioral, resilience, data-access, etc.']
  "lifecycle" sensei.pattern_lifecycle [not null, default: 'suggested', note: 'Pattern state: suggested (emerging), gap (recommended but absent), rule (enforced in sessions).']
  "is_anti_pattern" boolean [not null, default: false, note: 'True for anti-patterns (duplication, god-node, monolith, dead-code, copy-paste).']
  "severity" sensei.pattern_severity [note: 'Anti-pattern severity: low, medium, high. Null for positive patterns.']
  "confidence" numeric(3,2) [note: 'Detection confidence score 0.00-1.00.']
  "instance_count" int [not null, default: 0, note: 'Number of code locations where this pattern is detected.']
  "instances" jsonb [not null, default: '[]', note: 'JSON array: [{file, line, snippet}] — specific code locations.']
  "evidence" jsonb [not null, default: '[]', note: 'JSON array: [{session_id, file, description}] — sessions/files that confirmed this pattern.']
  "fix_pattern_id" uuid [note: 'For anti-patterns: self-ref FK to the constructive pattern that would fix this issue.']
  "description" text [note: 'Human-readable description of the pattern and why it matters.']
  "example" text [note: 'Code example showing the pattern in use (or the anti-pattern to avoid).']
  "enforcement" text [note: 'How this pattern is enforced when lifecycle = rule (e.g. "new auth integrations must adapt, not inline").']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for filtering.']
  "detected_at" timestamptz [not null, default: `now()`, note: 'Timestamp when this pattern was first detected.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (workspace_id, name, is_anti_pattern) [unique, note: 'unique constraint']
    workspace_id [name: 'detected_patterns_workspace_id_idx']
    folder_id [name: 'detected_patterns_folder_id_idx']
    lifecycle [name: 'detected_patterns_lifecycle_idx']
    is_anti_pattern [name: 'detected_patterns_anti_pattern_idx', note: 'where: is_anti_pattern']
    tags [type: gin, name: 'detected_patterns_tags_idx']
    fix_pattern_id [name: 'detected_patterns_fix_pattern_id_idx', note: 'where: fix_pattern_id IS NOT NULL']
  }

  Note: '''Code patterns detected during indexing and analysis, scoped to a workspace.
- workspace_id: the scoping key. Uniqueness is (workspace_id, name, is_anti_pattern)
  so patterns aggregate across every folder in the workspace — a churn pattern
  for the same file that shows in multiple folder passes merges into one row
  (#82).
- folder_id: optional locus pointer for file/folder-scoped signals (churn).
  Nullable so the row survives folder deletes; on-delete-set-null preserves
  the pattern row while dropping the stale locus.
- lifecycle: suggested (emerging, 2+ places) → gap (recommended but absent) → rule (enforced)
- is_anti_pattern: true for duplication, god-nodes, monoliths, dead code, copy-paste
- fix_pattern_id: for anti-patterns, self-ref to the constructive pattern that would fix it
- evidence: [{session_id, file, line, description}] — sessions/files where pattern was observed
- instances: [{file, line, snippet}] — specific code locations
- family: GoF category (structural, behavioral, creational), resilience, data-access, etc.'''
}

Table "inference"."recommendations" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [not null, note: 'Foreign key to workspaces — which workspace this targets.']
  "reasoning_trace_id" uuid [note: 'Foreign key to reasoning_traces — the MOE debate that produced this. Nullable for heuristic.']
  "urgency" sensei.recommendation_urgency [not null, default: 'medium', note: 'Priority: high (recurring failures), medium (emerging patterns), low (housekeeping).']
  "status" sensei.recommendation_status [not null, default: 'pending', note: 'Lifecycle: pending → accepted, dismissed, or superseded.']
  "title" text [not null, note: 'Short title (e.g. "Write an auth integration-test persona").']
  "why" text [not null, note: 'Why this matters, with evidence summary.']
  "impact" text [note: 'Projected impact (e.g. "Projected FTR +14%").']
  "evidence" jsonb [not null, default: '[]', note: 'JSON array: [{session_id, file, description}] — the raw activity that triggered this.']
  "based_on" jsonb [not null, default: '{}', note: 'Provenance links to the derived artifacts this recommendation was built from: {patterns:[id], memories:[id], corrections:[ref]}. Distinct from `evidence` (raw session/file activity) — `based_on` points at the L1/L2 outputs the generator reasoned over.']
  "action_type" text [not null, note: 'What to do (free text; the generator enforces the canonical set): promote_pattern, create_agent, write_skill, archive_memory, enrich_memory, cross_workspace, revise_rule, audit_stale.']
  "action_detail" jsonb [not null, default: '{}', note: 'Specifics: {persona_name, pattern_id, skill_id, cwd, ...}.']
  "prompt" text [note: 'Ready-to-send prompt for the ACP. Shown in the action drawer.']
  "default_acp" text [note: 'Suggested ACP: claude-code, cursor, codex, etc.']
  "baseline_ftr" numeric(4,3) [note: 'Workspace FTR snapshot at time of acceptance (acted_at). Null until accepted.']
  "current_ftr" numeric(4,3) [note: 'Rolling workspace FTR after the change. Updated during measurement.']
  "verdict" sensei.recommendation_verdict [not null, default: 'pending', note: 'Impact: positive (FTR improved), negative (FTR dropped), neutral, pending.']
  "props" jsonb [not null, default: '{}', note: 'Extensible: {baseline_corrections_avg, current_corrections_avg, tool_usage_delta, ...}.']
  "score" numeric(5,2) [note: 'Analyzer-computed priority score 0–100 (ranking.rs): weighted sum of action leverage, urgency, source-pattern confidence, and recurrence. Null until the workspace is ranked. Read path orders by this. Breakdown is mirrored into based_on.score_factors.']
  "focal" boolean [not null, default: false, note: 'The single highest-scoring pending recommendation per workspace — the "do first" / today\'s koan pick the Observatory surfaces. Exactly one per workspace (or zero if none pending).']
  "acted_at" timestamptz [note: 'Timestamp when the user accepted — the point-in-time marker for before/after FTR comparison.']
  "measured_at" timestamptz [note: 'Timestamp when verdict was last computed.']
  "materialized_ref" jsonb [note: 'What accepting this recommendation PRODUCED (spec 2026-08-20 insight-acceptance-\nmaterialization): {kind, ...ref, scope, enforcement}. For a rule-class accept →\n{kind:"rule", memory_id, namespace_id, scope, enforcement}; later phases add\n{kind:"skill"|"agent", file_path} and {kind:"pack_rule", pack_rule_id}. NULL when\nthe accept was a plain status flip (no artifact materialized). The provenance the\neffect-measurement + un-apply read.']

  indexes {
    (workspace_id, status) [name: 'recommendations_workspace_id_idx']
    urgency [name: 'recommendations_urgency_idx']
    (workspace_id, score) [name: 'recommendations_score_idx', note: 'order: asc, desc nulls last']
    verdict [name: 'recommendations_verdict_idx', note: 'where: verdict <> \'pending\'']
    reasoning_trace_id [name: 'recommendations_reasoning_trace_id_idx', note: 'where: reasoning_trace_id IS NOT NULL']
  }

  Note: '''The full lifecycle: insight → recommendation → action → measurement.

A recommendation is a point-in-time event. When accepted, it marks the moment
something changed in the system (persona added, pattern promoted, skill enabled).
FTR trend before vs after that point tells us if it helped.

Lifecycle: pending → accepted (user acts) → measured (verdict assigned)
                   → dismissed (user skips)
                   → superseded (newer recommendation replaces)

- baseline_ftr: workspace FTR at the time recommendation was accepted (acted_at)
- current_ftr: rolling FTR after the change
- verdict: positive (FTR improved), negative (FTR dropped), neutral, pending
- measured_at: when verdict was last computed'''
}

Table "sensei"."assistant_tools" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "assistant_family" text [not null]
  "source_type" text [not null]
  "source_key" text [not null]
  "tool_name" text [not null]
  "invoked_name" text [not null]
  "description" text
  "server_id" uuid
  "discovered_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (assistant_family, source_type, source_key, tool_name) [unique, name: 'assistant_tools_unique']
    invoked_name [name: 'assistant_tools_invoked_idx']
    (assistant_family, source_type, source_key) [name: 'assistant_tools_source_idx']
    server_id [name: 'assistant_tools_server_idx']
  }

  checks {
    `source_type IN ('mcp', 'builtin')`
  }

  Note: '''Unified per-assistant tool inventory (MCP + built-in) — the registry half of
the Instruments · Health share grid. tools_registered per source. Config stays
on the typed source tables (mcp_servers). `invoked_name` is the harness-qualified
name that joins sensei.tool_usage_stats.tool_name (e.g.
mcp__plugin_playwright_playwright__browser_click, or a bare built-in like Bash).
Plugins are captured in sensei.extensions, not here.'''
}

Table "sensei"."benchmark_reports" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [note: 'Foreign key to folders — which folder this report covers. Nullable.']
  "run_name" text [not null, note: 'Human-readable label for this benchmark report.']
  "strategy" text [not null, note: 'Strategy evaluated in this report.']
  "score" numeric [note: 'Benchmark score achieved.']
  "tokens" int [note: 'Total token count consumed.']
  "elapsed_ms" int [note: 'Wall-clock duration in milliseconds.']
  "payload" jsonb [note: 'Detailed results as JSON.']
  "promoted" boolean [not null, default: false, note: 'Whether this strategy has been promoted as active.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    folder_id [name: 'benchmark_reports_folder_id_idx', note: 'where: folder_id IS NOT NULL']
  }

  Note: 'Benchmark reports — results from strategy comparison runs.'
}

Table "sensei"."benchmark_runs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which folder this benchmark ran against.']
  "task_description" text [not null, note: 'Coding task given to the AI during this run.']
  "branch" text [not null, note: 'Git branch the benchmark was executed against.']
  "sensei_enabled" boolean [not null, note: 'Whether sensei MCP tools were available (false = baseline, true = assisted).']
  "started_at" timestamptz [not null, default: `now()`, note: 'Timestamp when the run began.']
  "ended_at" timestamptz [note: 'Timestamp when the run finished. Null if in progress.']
  "total_cost_usd" numeric(10,6) [note: 'Total API cost in USD aggregated from api_requests.']
  "total_input_tokens" int [note: 'Total input tokens across all API calls.']
  "total_output_tokens" int [note: 'Total output tokens across all API calls.']
  "total_cache_read_tokens" int
  "total_cache_creation_tokens" int
  "worktree_path" text [note: 'Path of the temporary git worktree used. Deleted after completion.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (folder_id, task_description, branch) [name: 'benchmark_runs_folder_idx']
  }

  Note: 'One row per benchmark execution (paired: same task + branch, sensei_enabled true/false).'
}

Table "sensei"."commit_files" {
  "repository_id" uuid [pk, not null, note: 'The repository the commit belongs to — the fact grain, and half of the composite FK to `sensei.commits`. Keyed on the repository rather than the checkout so two clones converge on one set of rows: 10 repositories on this machine have more than one anchor folder, and a per-checkout key would give each of them a private copy of the same history.']
  "sha" text [pk, not null, note: 'The commit, as the full 40-character git object name. `text`, matching `repository_metrics.commit_sha`; `char(40)` would buy nothing in Postgres and would blank-pad anything shorter. Purely the join key to `sensei.commits` — `authored_at` and `author_email` are stored only there, so this table cannot disagree with them.']
  "path" text [pk, not null, note: 'Repository-relative path with POSIX separators, exactly as git reported it FOR THIS COMMIT — the path the file had at that commit, which is what a later join against `sensei.files` needs. Read from `--numstat -z`, where paths arrive as NUL-terminated raw bytes: no C-quoting, and no `a/{x => y}/b` rename pseudo-path. Both of those are live defects in the churn path this table replaces — 2,087 of 24,496 records (8.5%) stored a rename pseudo-path that never existed on disk, and 30 more stored octal escapes. A rename contributes ONE row, under the new path. This is not an identity across renames; tracking that is the graph\'s job, not git\'s.']
  "lines_changed" int [note: 'Lines added plus lines deleted for this path in this commit. NULLABLE, and null means UNKNOWN — never zero. `git --numstat` prints `-` for both counts on a binary file, and `churn.rs:234` currently reads that as `add.parse().unwrap_or(0) + del.parse().unwrap_or(0)`, which reports replacing a 4 MB asset as a no-op edit and quietly drags every mean down: that is the bug this column exists not to repeat. The TOUCH is still a fact — the row is here, so co-change and Ownership counts are unaffected — and only its magnitude is unknown. Readers let the null propagate (`sum` and `avg` skip it) and count `lines_changed is null` when they need to report how much is unmeasured. Never `coalesce(lines_changed, 0)`. `integer`, not `bigint`: no single file-touch approaches 2.1 billion lines, and `sum(integer)` already returns `bigint`, so roll-ups cannot overflow.']

  indexes {
    (repository_id, path, sha) [name: 'commit_files_path_idx', note: 'include: lines_changed']
  }

  Note: '''Which PATHS a commit touched, and how far each one moved — the per-touch git
fact behind Hidden coupling (co-change), Ownership and churn.

- **What it is.** One row per (repository, commit, path). Insert-only and
  immutable: a commit that has been walked never changes, so a re-walk is
  `on conflict do nothing`, nothing here is ever updated, and nothing is ever
  pruned by reachability. Written per CHECKOUT — the cursor is
  `commit_scans.folder_id` — but keyed per REPOSITORY, so a second checkout of
  the same repo re-inserts the same rows as a pure no-op instead of duplicating
  them or racing the first checkout to delete them.
- **How to use it.** Co-change: group by sha, take the paths pairwise, and drop
  any commit touching more than 50 files (a sweep, not coupling — 81.5% of the
  588,865 naive pairs in `sensei` come from the 53 commits above that line).
  Ownership and churn: filter `(repository_id, path)`, join `sensei.commits` for
  `authored_at` and `author_email`, window on `authored_at` (default 90 days,
  configurable). Any read that is about files on disk joins `sensei.files` by
  path, and THAT join is the filter — see below.
- **What it is NOT.** Not a graph edge and not a file reference. There is no
  `file_id` and no `node_id`; a path here is a git string that is valid only for
  the commit it sits on. Not a time series either — it carries no timestamp of
  its own, because `commits.authored_at` already owns that fact and a copy here
  would be a second writer for it.
- **Who writes it.** The git-history scan, from
  `git log --no-merges --numstat -z` over the TIP SET
  (`--branches --remotes --tags`; never HEAD alone, never `--all`). Measured in
  `sensei`: 4,060 non-merge commits, 24,588 touches, median 2 files per commit,
  p95 20, max 326. Retention deletes from `sensei.commits` at 400 days and these
  rows follow through the cascade; the floor `retention >= max(window)` is
  enforced so a window can never outrun the data behind it.

**The natural key is load-bearing.** `(repository_id, sha, path)` is the primary
key and there is deliberately no surrogate `id`. Nothing references a row here,
so a surrogate would exist only to be returned — and it could not be. The
writer's idempotent insert is `on conflict do nothing`, and
`on conflict do nothing returning id` returns NOTHING on conflict, so a caller
that needed the id would have to read every already-known row back, or escalate
to `on conflict do update` and write a fresh row version for all ~738,000 of
them on every sweep. That is a tableful of dead tuples burned per re-walk to
maintain a column with no referent. With the natural key a re-walk over
already-recorded commits writes nothing at all.

`repository_id` is not separately a foreign key to `sensei.repositories`. The
composite FK to `sensei.commits` carries it, `commits` holds that reference, and
a repository delete reaches these rows down the chain. A second constraint would
be a second index obligation for a guarantee already made.

**No `file_id`, and that is not an omission.** 4,298 of the 6,654 paths ever
touched in `sensei` (65%) no longer exist on disk, so they have no
`sensei.files` row and the column would be NULL for most of the table. Worse, it
would make a git fact depend on whether the indexer has run: these rows are
insert-only, so a path written before its file was indexed would hold NULL
forever, and the column would be recording scan ORDER rather than truth. Resolve
by path at read time instead. EXISTENCE on disk is the filter — a path that is
gone fails the join to `sensei.files` and so cannot reach a diagram — and a
filter belongs in the query, never frozen into the row.'''
}

Table "sensei"."commit_scans" {
  "folder_id" uuid [pk, not null, note: 'The CHECKOUT this cursor belongs to — the repo-anchor folder the walk ran git in (FK sensei.folders, ON DELETE CASCADE). PRIMARY KEY rather than repository_id because two checkouts of one repository must each keep their own position; see the table comment. The cascade drops the position only: the facts are keyed on the repository and outlive any checkout being pruned.']
  "repository_id" uuid [not null, note: 'The repository the walk wrote facts for (FK sensei.repositories, ON DELETE CASCADE). NOT NULL — a commit is repository-grain, so a folder whose repository the scanner has not resolved yet (`folders.repository_id` is nullable) is not scannable and gets no row here at all, never a row carrying an invented repository.']
  "tips" text[] [not null, default: '{}', note: 'The tip shas the last successful walk covered, from `git rev-list --branches --remotes --tags`. Handed to the next walk as `--not <tips>` so it reads only new commits.\n\nStored SORTED, so an unchanged tip set compares equal and the walk can stop before spawning git. A sha that no longer resolves must be dropped from the exclusion list rather than passed through — see the table comment.\n\n`{}` is a real state: the walk ran and the repository had no branch, tag or remote. No row at all means never walked.']
  "scanned_at" timestamptz [not null, default: `now()`, note: 'When the last successful walk finished. Advanced together with `tips`, in one write — so the pair can never claim coverage the facts do not have.']

  indexes {
    repository_id [name: 'commit_scans_repository_id_idx']
  }

  Note: '''How far the git-history walk has got, per CHECKOUT — the cursor for the facts in
`sensei.commits` and `sensei.commit_files`.

- **What it is.** One row per repo-anchor folder that has been walked at least
  once. `tips` holds the tip shas that walk covered, so the next walk asks git
  only for what is new: `git rev-list <current tips> --not <stored tips>`.
- **How to use it.** Resolve the current tip set with `--branches --remotes
  --tags`. Never HEAD alone — it sees one branch of a checkout that has many.
  Never `--all` — it sweeps `refs/stash` and `refs/original`, which are not
  history anyone authored. Walk the difference, insert the facts, then write the
  new tip set back here.
- **What it is NOT.** It is not the facts, and it governs nothing about their
  lifetime. They are keyed on `repository_id`, insert-only, and never pruned by
  reachability. Losing this row — or the checkout it points at — loses the
  position, not the history: the next walk simply re-walks, and every row it
  re-inserts is absorbed by `ON CONFLICT DO NOTHING`.
- **Who writes it.** The git-history scan handler, in the same transaction that
  commits the walk's rows and ONLY when that walk succeeded. A failed walk
  leaves the previous tips standing, so the next run retries the same range
  instead of stepping over it.

## Why the cursor is per CHECKOUT when the facts are per REPOSITORY

A scan runs in a working directory; a commit belongs to a repository. Two
checkouts of one repository — `develop` in one folder, `main` in another — are
two scans at two positions, and 10 repositories on this machine have more than
one anchor folder. Keying this table on the repository would hand those pairs
ONE cursor to fight over: each walk would advance it past refs the other cannot
see, and each would then be told it had already covered them.

The predecessor shipped a worse form of exactly that. v1 pruned commits by
`rev-list HEAD` reachability — repository-grain rows deleted on checkout-grain
evidence — so two anchors of one repository would prune and re-walk each other
forever. Splitting the grain settles it at the key: a per-folder cursor can be
wrong about its own folder and nothing else, while the facts it feeds stay
shared. The prune it replaced was never needed either; EXISTENCE on disk is the
filter, not reachability. Of 6,654 paths ever touched in this repository, 4,298
(65%) no longer exist, so they have no `sensei.files` row and cannot reach a
diagram however long their commits are kept.

## When a tip disappears

A force-push, a deleted branch or a rewritten history leaves a stored sha that
is no longer an object. Nothing here is repaired and nothing anywhere is
deleted. Filter the stored tips to the shas git can still resolve before passing
them as exclusions — `rev-list --not <missing sha>` aborts the whole command —
and the walk re-covers that range on the shas that remain. Re-walking costs
time; it cannot produce a wrong row, because every row it writes is keyed on the
sha that produced it.'''
}

Table "sensei"."files" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key. Referenced by nodes.file_id — 16 bytes instead of a repeated path, and unchanged when the file moves.']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which folder this file belongs to.']
  "file_path" text [not null, note: 'Folder-relative path of the source file being tracked. UNIQUE with folder_id: the walk resolves a file by path, having no id in hand.']
  "mtime" bigint [not null, note: 'File modification time as Unix epoch milliseconds, used for quick change detection.']
  "content_hash" text [not null, note: 'SHA-256 hash of the file content used to confirm whether it has changed since last index.']
  "skip_reason" sensei.scan_skip_reason [note: 'Null when the file was indexed. Non-null records why it was examined but deliberately not indexed (unsupported format, binary content, invalid UTF-8, parse error, excluded by config). Recording the fingerprint alongside the reason is what stops a skipped file from being re-enqueued on every reconcile; because the skip is keyed to the fingerprint, fixing the file re-triggers indexing automatically.']
  "skip_detail" text [note: 'The parser\'s VERBATIM error with file, line and column, when the grammar produced one (R10.9). skip_reason is the code; this is the text. An agent handed "x.rs:142: expected `}`" can fix the file; one handed "parse_error" can only shrug. Null when there is no detail to record.']
  "parsed_at" timestamptz [note: 'When a parse outcome was last recorded for this file. NULL means the walk created the row and no parse has run yet — the "discovered" state. Together with skip_reason this yields the full file lifecycle: (null, null) discovered; (set, null) parsed; (set, non-null) unparseable or skipped per the reason. It exists because those first two are otherwise indistinguishable, which would make a stalled parse task look identical to a file that parsed and legitimately declared nothing.']
  "indexed_at" timestamptz [not null, default: `now()`, note: 'Timestamp when this file was last examined (indexed, or skipped with a reason).']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (folder_id, file_path) [unique, note: 'unique constraint']
    folder_id [name: 'files_folder_id_idx']
    (folder_id, indexed_at) [name: 'files_indexed_at_idx', note: 'order: asc, desc']
  }

  Note: '''THE FILE ENTITY — one row per file examined by the scan. Renamed from
scan_state (R13), which read as transient bookkeeping and hid the fact that
this IS the level between folders and symbols; nodes.file_id references it.
A row means the file was EXAMINED at this fingerprint — not necessarily indexed.
- id: surrogate key, referenced by nodes.file_id. Stable across a path change.
- (folder_id, file_path): UNIQUE — the walk only ever has a path.
- mtime: file modification time as unix ms
- content_hash: sha256 of file content for change detection
- skip_reason: null = indexed; non-null = examined and deliberately not indexed
- skip_detail: the parser's verbatim message with location, when there is one
- parsed_at: null = discovered (no parse outcome yet); set = a parse ran
- indexed_at: when this file was last examined'''
}

Table "sensei"."folder_commands" {
  "id" bigserial [pk, not null]
  "folder_id" uuid [not null]
  "raw_name" text [not null]
  "command_line" text [not null]
  "category" text
  "ecosystem" text [not null]
  "source_file" text
  "discovered_at" timestamptz [not null, default: `now()`]

  indexes {
    (folder_id, raw_name) [unique, note: 'unique constraint']
    folder_id [name: 'folder_commands_folder_idx']
    category [name: 'folder_commands_category_idx']
    ecosystem [name: 'folder_commands_ecosystem_idx']
  }

  Note: '''#83 T1 commands surface. Discoverable commands per folder — populated from
manifest adapters. One row per (folder_id, raw_name); re-scan replaces the
per-folder set atomically via delete-then-insert.'''
}

Table "sensei"."folder_dependencies" {
  "from_folder_id" uuid [pk, not null, note: 'The folder whose manifest declares the dependency.']
  "to_folder_id" uuid [pk, not null, note: 'The folder the local-protocol path resolves to. Derivable to a workspace via folders.workspace_id — which is why the workspace ids are no longer stored.']
  "source_protocol" text [not null, note: 'link | workspace | file | path — the local protocol the manifest used.']
  "source_manifest" text [pk, not null, note: 'The manifest filename that declared it (package.json, Cargo.toml, ...). Part of the PK so two manifests in one folder are distinct edges.']
  "resolved_target" text [note: 'The raw target string after the protocol prefix, kept for display and re-derivation.']
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    from_folder_id [name: 'folder_dependencies_from_idx']
    to_folder_id [name: 'folder_dependencies_to_idx']
  }

  checks {
    `from_folder_id <> to_folder_id`
  }

  Note: '''Manifest-declared dependency between two FOLDERS (D11). Written when a local
protocol dep (npm link:/workspace:/file:, Cargo path=) resolves to a sibling
folder. Regrained from project_dependencies: a manifest sits at a folder, so
that is the grain of the fact, and workspace/repository answers are views over
this. The composite PK makes it idempotent per declaring manifest; the CHECK
forbids a self-edge.'''
}

Table "sensei"."folder_path_aliases" {
  "alias_abs_path" text [pk, not null, note: 'A former absolute path of the folder (globally unique — a path can alias at most one folder). Matched by the cwd resolvers.']
  "folder_id" uuid [not null]
  "reason" text [not null, default: 'rename', note: 'Why the alias exists: rename (explicit remap) | detected (git-remote reconcile match).']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    folder_id [name: 'folder_path_aliases_folder_idx']
  }

  Note: '''Historical absolute paths a folder previously lived at (before a rename/move).
Workspace/folder identity is path-keyed on folders.abs_path, so a moved repo would
otherwise orphan its history — every transcript/hook cwd recorded under the old
path stops matching. The path resolvers (get_folder_ids_by_path, find_folder_for_path)
match a cwd against folders.abs_path OR an alias here, so old transcripts still
resolve to the CURRENT folder + workspace. Populated on remap — an explicit
`folder remap`, or a git-remote-detected rename during reconcile. A folder keeps
its identity (uuid, workspace, sessions) across a move.'''
}

Table "sensei"."index_errors" {
  "id" serial [pk, not null, note: 'Surrogate primary key (serial).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which folder this error occurred in.']
  "file_path" text [not null, note: 'Path to the file that failed to index.']
  "error" text [not null, note: 'Error message or stack trace.']
  "adapter" text [note: 'Language adapter that produced the error.']
  "phase" text [note: 'Indexing phase when the error occurred.']
  "created_at" timestamptz [not null, default: `now()`, note: 'Timestamp when this error was recorded.']

  indexes {
    folder_id [name: 'idx_index_errors_folder']
  }

  Note: 'Files that failed during indexing. Persisted for debugging.'
}

Table "sensei"."knowledge_sources" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "kind" text [not null]
  "name" text [not null]
  "url" text [not null]
  "namespace_id" uuid
  "direction" text [not null, default: 'both']
  "last_seq" bigint [not null, default: 0]
  "enabled" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    namespace_id [name: 'knowledge_sources_namespace_id_idx', note: 'where: namespace_id IS NOT NULL']
  }

  Note: '''Registered rules-federation endpoints (governance P4). D1: url is the Worker
tenant base {registry}/v1/t/{origin}/{org} (the daemon appends /rules). The row
holds no credential: a source's calls present the session of the persona whose
dojo_memberships row owns that tenant (#236 step 4e). direction gates push vs
pull; last_seq is the per-source monotonic pull cursor.'''
}

Table "sensei"."library_content" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "library_version_id" uuid [not null, note: 'The library VERSION this content describes. Cascade-deletes with it.']
  "kind" sensei.library_content_kind [not null, note: 'skill | agent | page. Part of the unique key, because a library may ship a skill and a page under the same name.']
  "name" text [not null, note: 'Skill/agent name, or a page title. Unique within (version, kind).']
  "body" text [note: 'The markdown or page content, fetched at ingest so a read is self-contained and survives the source being moved or deleted.\n\n`content` for a page, `body` for a skill or agent. Fetched at ingest so a read is self-contained and does not depend on the source still existing.']
  "source" text [not null, default: 'manifest', note: 'PROVENANCE: manifest (declared in sensei.library.json) | generated (auto-generated by skill-gen) | the fetch origin for a page. Distinct from source_type, which is the ROUTE, not the origin.']
  "source_path" text [note: 'Manifest-relative path the body was read from. Null when generated.']
  "version_range" text [note: 'Semver range from the manifest that this content applies to. Free text; not enforced-matched.']
  "focus" text [note: 'Short topic key — the selector for get_library_skill ("styling"), or what an agent reviews. Skills and agents only.']
  "tokens" int [note: 'Approximate token size. Skills only; null until skill-gen runs.']
  "generated_at" timestamptz [note: 'When auto-generated. Skills only; null for manifest-declared content.']
  "package_name" text [note: 'Which published package this row documents, as a dependency file spells it (@rokkit/ui) — matching library_packages.package_name, so resolution is an equality join. NULL means library-level: an overview or guide that is about the library as a whole, which is a real state and not a missing value. Plain TEXT, not an FK: a page can name a package not yet grouped, and an FK would force a phantom library_packages row. The named package MUST belong to the same library as this row\'s version; a cross-library claim is a conflict to report, not to resolve.']
  "url" text [note: 'Remote URL a page was fetched from (http or llms.txt route). Pages only.']
  "local_path" text [note: 'Filesystem path a page was read from (local route). Pages only.']
  "description" text [note: 'Short summary of a documentation page. Pages only.']
  "component" text [note: 'Sub-topic within the library ("routing", "middleware"). Pages only.']
  "source_type" sensei.library_source_type [note: 'The fetch ROUTE: llms.txt | http | local. Pages only. See `source` for the origin — the two are different questions.']
  "embedding" vector(768) [note: '768-dim vector for semantic search over documentation. Pages only.']
  "fetched_at" timestamptz [note: 'When this page was last fetched. Pages only; compare against library_versions.fetched_at to spot staleness.']
  "scope" sensei.entity_scope [not null, default: 'local', note: 'Who may see it, and therefore whether it syncs. Shared vocabulary with sensei.entity_scope.\n\nShared vocabulary (see sensei.entity_scope / sensei.entity_origin). scope answers WHO MAY SEE IT and therefore whether it syncs; origin answers WHERE IT CAME FROM and therefore what a re-import may replace.']
  "origin" sensei.entity_origin [not null, default: 'imported', note: 'Where it came from, and therefore what a re-import may safely replace. Shared vocabulary with sensei.entity_origin.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.\n\n`kind` is IN the key: a library may legitimately ship a skill and a page both called "routing", and without the discriminator one would evict the other.\n\n`package_name` is in it for the same reason one level down. `rokkit` publishes both `@rokkit/ui` and `@rokkit/chart`, and each can document a component called `List`. Keyed without the package, the second `List` page upserts over the first and one of them is simply lost.\n\nDeclared as a standalone index below, NOT as an inline constraint: the NULLS NOT DISTINCT clause is load-bearing and an inline `unique nulls not distinct (...)` is silently reduced to a plain unique by the schema tool, which is exactly the kind of quiet downgrade that looks applied and is not.']

  indexes {
    (library_version_id, kind, package_name, name) [unique, name: 'library_content_identity_uq', note: 'nulls not distinct']
    (library_version_id, kind) [name: 'library_content_version_kind_idx']
    (package_name, kind) [name: 'library_content_package_idx', note: 'where: package_name IS NOT NULL']
    kind [name: 'library_content_kind_idx']
    embedding [type: hnsw, name: 'library_content_embedding_hnsw', note: 'where: embedding IS NOT NULL\nopclass: vector_cosine_ops\nwith: ef_construction = 64, m = 16']
  }

  Note: '''Everything a library VERSION provides — skills, agents and documentation pages
in one table, discriminated by kind (R12).

Replaces library_skills, library_agents and library_pages, which shared nine
columns and differed in a handful. A fifth kind of content now costs a row
rather than a fourth table plus a fourth arm in every UNION.

Keyed to library_versions, not libraries: a library's skills and docs can
differ between releases, and content hung off the identity could not say which
release it described.

Kind-specific columns are nullable BY DESIGN. Each belongs to exactly one kind
— focus/version_range to skills and agents, tokens/generated_at to skills,
url/local_path/description/component/source_type/embedding/fetched_at to pages
— so a null means "not applicable to this kind", never "unknown".

package_name is the exception that is NOT kind-specific: it records WHICH of a
library's published packages a row documents. Skills and agents are
library-level; docs are often package-level (rokkit's List page documents
@rokkit/ui). NULL means library-level, which is a real state, not a gap.'''
}

Table "sensei"."mcp_tool_manifests" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "server_id" uuid [not null, unique]
  "tools" jsonb [not null, default: '[]']
  "tool_count" int [not null, default: 0]
  "probed_at" timestamptz [not null, default: `now()`]
  "ttl_seconds" int [not null, default: 900]
  "error" text
  "protocol_version" text
  "server_name" text
  "server_version" text

  indexes {
    probed_at [name: 'mcp_tool_manifests_probed_at_idx']
  }

  Note: '''#84 T2 Slice B. Cached tool_list JSON-RPC responses per MCP server. Refreshed
on TTL expiry or explicit request. `server_id` is UNIQUE so a manifest re-probe
overwrites in place rather than accumulating.'''
}

Table "sensei"."memories" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [note: 'Foreign key to workspaces. Null = global memory (applies to all workspaces).']
  "scope" sensei.memory_scope [not null, default: 'workspace', note: 'When to surface: global (always), workspace (this workspace), stack (matching tech), task_type (matching task), module (matching code area). Legacy axis — superseded by namespace_id for governance resolution.']
  "scope_filter" text [note: 'Qualifier for scope: stack name (e.g. "rust"), task type (e.g. "fix"), module path (e.g. "src/api"). Null for global/workspace scope.']
  "namespace_id" uuid [note: 'Governance scope instance this rule applies to (organization/workspace/repository). Null = unscoped (general). Resolution gathers rules across a repo\'s member namespaces + always-on general/user.\n\nGovernance plane: a memory positioned on a namespace (where it applies) + enforcement (how much authority it carries). namespace_id supersedes the legacy scope/scope_filter/workspace_id triple for resolution; the old columns are retained during the transition so the flat assemble_context keeps working.']
  "enforcement" sensei.enforcement [not null, default: 'recommended', note: 'Authority axis: advisory < recommended < required < mandatory. mandatory = non-overridable constitution tier (a more specific scope cannot weaken it).']
  "origin" text [not null, default: 'learned', note: 'Provenance: learned (knowledge plane), authored (written directly), promoted (elevated from a narrower scope), federated (pulled from a DÅjÅ), dojo (applied from a Dōjō downstream artifact — see sensei.dojo_inbox).']
  "source_id" uuid [note: 'When origin=promoted/federated, the id of the source memory (or remote record) this was derived from. Null otherwise.']
  "type" sensei.memory_type [not null, note: 'Knowledge category: decision (architectural), pattern (code convention), convention (team norm), preference (style rule), continuity (session handoff), question (open issue).']
  "title" text [not null, note: 'Short label used as heading in context output.']
  "content" text [not null, note: 'The rule or learning — full body text surfaced to the agent. LOCAL REFERENCE: verbatim as captured, so it may quote real code, paths, ids and decisions. It is NOT the shareable form. Never sent on the collective/contribute lane: batch_share_items selects generalised_content only, with no fallback to this column — an un-generalised memory is held, not shipped. It is NOT unconditionally local: the separate federation rule-push (federation::push_promoted → POST /rules) sends this column verbatim, ungeneralised and unstripped, for an origin=promoted memory at a shareable namespace whose knowledge source is push-enabled. That is an explicit publish of the raw rule the user promoted, on a different lane with a different consent model — do not read this column as unsendable.']
  "impact" text [note: 'Consequence of ignoring this memory. Answers "what breaks if you skip this?"']
  "strength" real [not null, default: 1.0, note: 'Confidence score 0–5. Created at 1.0, reinforced +1.0, confirmed = 5.0, decayed over time. Below 1.0 = auto-archived.']
  "status" sensei.memory_status [not null, default: 'active', note: 'Lifecycle: active (newly learned), reinforced (evidence accumulated), challenged (violated recently), battle_tested (high strength + zero violations over time), archived (retained for history, not surfaced).']
  "reinforced_count" int [not null, default: 0, note: 'Number of times evidence has confirmed this memory.']
  "violated_count" int [not null, default: 0, note: 'Number of times this memory was violated (assistant acted contrary to it).']
  "last_relevant_at" timestamptz [note: 'Timestamp of last reinforcement or violation. Used for recency-based surfacing.']
  "session_id" uuid [note: 'Session that created this memory. Null for imported or collective memories.']
  "tags" text[] [not null, default: '{}', note: 'Free-form tags (e.g. security, performance, compliance). GIN-indexed for &&/@> filters.']
  "spine_slot" sensei.spine_slot [note: 'Which doc spine slot this memory anchors to, for slot-scoped retrieval. With `feature` NULL the scope is the workspace; both NULL means unanchored. See docs/database/sensei.md.']
  "feature" text
  "triage_signal" text [note: 'Which capture heuristic surfaced this memory (revert/correction/actually/repeat_pattern/override/test_failure). Null for explicit /save.']
  "category" sensei.memory_category [note: 'Quality dimension for the learnings UI anatomy, orthogonal to `type`: correctness, convention, pattern, preference. Null until classified.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When this memory was first learned/created (stable). Distinct from modified_at, which moves on every reinforcement; the UI shows this as "learned".']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']
  "generalised" boolean [not null, default: false, note: 'Ready-to-share flag: true once sensei has rewritten this memory into a workspace-agnostic rule (stored in generalised_content), meaning it is ready to widen up the scope ladder. Set only by an explicit /generalise action; never fabricated.\n\nReady-to-share lane: sensei\'s assessment that this memory has been rewritten workspace-agnostic and is ready to widen up the scope ladder, plus the portable rewrite itself and its invented illustration (both null until generalised). Everything named `generalised_*` is a candidate to leave this machine; `content` above is not. That naming IS the rule — see the column comments.']
  "generalised_content" text [note: 'The workspace-agnostic rewrite of `content` — identifiers (workspace/repo/file/service/person names) stripped and restated as a general principle. Null until generalised. SHAREABLE: this, not `content`, is what the upstream contribute path sends.']
  "generalised_example" text [note: 'A SYNTHETIC illustration of generalised_content: the generalise prompt asks the model to invent a situation similar in SHAPE to the original while quoting none of it. Optional (null when the model produced none) and never fabricated by the daemon to fill a gap. "Synthetic" is a GENERATION CONTRACT carried by the prompt, not a checked invariant: nothing compares this text against `content`, so a model that parrots its input can land real names here. What IS enforced before it leaves the machine is the same deterministic identifier strip the body gets — a KNOWN workspace/repo/person/path token is removed, and residual risk holds the whole artifact. SHAREABLE, and rewritten together with generalised_content so an example never outlives the rule it illustrates.']

  indexes {
    (workspace_id, scope, status) [name: 'memories_workspace_id_idx']
    (scope, scope_filter) [name: 'memories_scope_idx', note: 'where: status = \'active\'']
    (workspace_id, spine_slot) [name: 'memories_spine_slot_idx', note: 'where: status = \'active\'']
    (namespace_id, enforcement, status) [name: 'memories_namespace_idx', note: 'where: status IN (\'active\', \'reinforced\', \'battle_tested\')']
    strength [name: 'memories_strength_idx', note: 'where: status = \'active\'\norder: desc']
    tags [type: gin, name: 'memories_tags_idx']
  }

  Note: '''Multi-level, reasoned, evolving knowledge system.
Replaces memory_items (workspace-scoped only) and inference.preferences (style rules).
- scope: determines when this memory is surfaced — global, workspace, stack, task_type, module
- scope_filter: qualifier for non-global scopes (stack name, task type, module path)
- impact: consequence of ignoring this memory — the "why"
- strength: 0–5 score, reinforced by evidence, decayed by time
- session_id: session that created this memory (provenance)

Context assembly: SELECT active memories matching scope hierarchy for current session.'''
}

Table "sensei"."referenced_libraries" {
  "folder_id" uuid [pk, not null, note: 'Foreign key to folders — the folder that uses this library.']
  "library_id" uuid [pk, not null, note: 'Foreign key to libraries — the library dependency.']
  "version_used" text [note: 'Version of the library pinned in this folder, as observed from the package manifest.']
  "props" jsonb [not null, default: '{}', note: 'Extensible metadata: {source, usage_count, skill_path, skill_generated_at, ...}.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    library_id [name: 'referenced_libraries_library_id_idx']
  }

  Note: '''Junction table linking folders (git/subtree folders) to their library dependencies.
- version_used: the pinned version observed in the folder (from package.json, Cargo.toml, etc.)
- props: extensible — {source:"Cargo.toml", usage_count, skill_path, skill_generated_at, ...}'''
}

Table "sensei"."repository_namespaces" {
  "repository_id" uuid [pk, not null, note: 'FK to sensei.repositories — the repo, by identity rather than by checkout, so every clone resolves the same rules.']
  "namespace_id" uuid [pk, not null, note: 'FK to sensei.namespaces — a scope instance the repository belongs to. Never a `workspace`-scope namespace; see the table comment.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    namespace_id [name: 'repository_namespaces_namespace_id_idx']
  }

  Note: '''Which namespaces a REPOSITORY belongs to — the set membership governance
resolves rules through.

- **What it is.** One row per (repository, namespace). A repository joins one
  namespace per applicable scope: its organization, and its own namespace on the
  `repository` rung (sensei.repository_namespace) — where the packs of its
  detected stacks are adopted (#318 R6, D33).
- **How to use it.** Resolve a cwd to its folder, lift to
  `folders.repository_id`, then union the rules of every member namespace with
  the always-present `user` and `general` scopes, ordered by scope level. There
  is no tree to walk — multi-membership falls out for free, so a repository can
  belong to two organizations with no special case.
- **What it is NOT.** It is not workspace membership. That is
  `repositories_in_workspaces`, and it is the only place a workspace is recorded. A
  `workspace`-scope namespace must never be bound here: it would be a second
  writer for a fact `repositories_in_workspaces` already owns, which is exactly how
  the predecessor drifted.
- **Who writes it.** The scan, from README frontmatter (organization) and, through
  sensei.adopt_stack_pack, the detected stack (the repository's own namespace).

Keyed on the REPOSITORY, not on a folder. The predecessor
(`folder_namespaces`) keyed the binding on a folder, and all 447 live rows sat
on repo-ROOT folders — none on a `folder` or `module` kind. The folder grain
was therefore never used as one; it only allowed two checkouts of the same
repository to disagree about which rules governed them, which four repositories
already did.'''
}

Table "sensei"."rule_check_runs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "folder_id" uuid [not null]
  "rule_statement" text [not null]
  "checker_ref" text [not null]
  "command" text [not null]
  "verdict" sensei.check_verdict [not null]
  "exit_code" int
  "output_tail" text [not null, default: '']
  "ran_at" timestamptz [not null, default: `now()`]

  indexes {
    (folder_id, ran_at) [name: 'rule_check_runs_folder_idx', note: 'order: asc, desc']
  }
}

Table "sensei"."rule_packs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "slug" text [not null]
  "name" text [not null]
  "kanji" text
  "area" sensei.rule_pack_area [not null]
  "attribution" text [not null, note: 'Human-readable credit for where this pack\'s rules come from — "OWASP · sensei",\n"Kent Beck · XP · sensei". Free text, deliberately.\n\nNamed `source` until 2026-08-24, which put a citation in the same column name\nfour other tables used for provenance. It is neither a scope nor an origin: those\nare now sensei.entity_scope and sensei.entity_origin.']
  "summary" text
  "enforcement" sensei.enforcement [not null, default: 'recommended', note: 'The pack\'s DEFAULT enforcement tier. Each rule (rule_pack_rules.enforcement) may set its own; an adoption may override per-namespace (rule_pack_adoptions.enforcement).']
  "owner_namespace_id" uuid [note: 'The org namespace that authored a private pack; NULL = a global curated library pack. Never a workspace — a pack is reusable across repos and scopes.']
  "version" int [not null, default: 1, note: 'Pack version, bumped on any change to its rules/membership. An adoption pins the version it adopted (rule_pack_adoptions.pinned_version); re-adopt to take an update.\n\nthe ORG that authored a PRIVATE pack; NULL = global curated library. Never a workspace — packs are cross-repo.']
  "status" text [not null, default: 'active']
  "published_by" text [not null]
  "published_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "scope" sensei.entity_scope [not null, default: 'local', note: 'Shared vocabulary (see sensei.entity_scope / sensei.entity_origin). scope answers WHO MAY SEE IT and therefore whether it syncs; origin answers WHERE IT CAME FROM and therefore what a re-import may safely replace.']
  "origin" sensei.entity_origin [not null, default: 'builtin']

  indexes {
    (owner_namespace_id, slug) [unique, name: 'rule_packs_owner_slug', note: 'unique constraint']
    slug [unique, name: 'rule_packs_global_slug', note: 'where: owner_namespace_id IS NULL']
    area [name: 'rule_packs_area_idx']
  }

  Note: '''A rule pack: a namespace-agnostic library bundle of governance rules (curation +
distribution + adoption). Rules live in sensei.rule_pack_rules (they own their text);
a namespace adopts the pack via sensei.rule_pack_adoptions. Shared plane
(D-LOCAL-PACKS) — deploys to both the local daemon DB and the Dōjō Supabase; curated
packs resolve offline, never poured into sensei.memories. Distinct from
dojo.shared_rules (the Dōjō-plane per-namespace resolved registry).'''
}

Table "sensei"."sprints" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tracker_id" uuid [not null, note: 'The board this sprint belongs to.']
  "external_id" text [not null, note: 'The provider\'s sprint id, as text.']
  "seq" bigint [not null, note: 'Adapter-supplied creation order (Jira: the numeric sprint id). The tie-break for a ticket\'s current sprint; never compare external_id text.']
  "name" text [not null, note: 'Sprint name as the provider shows it.']
  "state" text [not null, note: 'Common lifecycle state: future, active or closed (adapters map theirs onto these).']
  "start_at" timestamptz [note: 'Planned or actual start; NULL for a future sprint without dates.']
  "end_at" timestamptz [note: 'Planned end.']
  "complete_at" timestamptz [note: 'When the sprint was actually closed; NULL while open.']
  "members_fetched_state" text [note: 'The state at the last membership fetch. A sprint closed when fetched is never fetched again (closed sprints do not change).']
  "removed_at" timestamptz [note: 'When a full sync stopped seeing it. Set once; never advanced by later syncs.']
  "last_seen_at" timestamptz [not null, default: `now()`, note: 'When a sync last saw it.']

  indexes {
    (tracker_id, external_id) [unique, note: 'unique constraint']
  }

  Note: 'Sprints of a tracker board, mirrored read-only from the provider. A sprint missing from a full sync gets removed_at (never deleted), so history and links survive.'
}

Table "sensei"."stances" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_key" text [not null, note: 'The user this stance belongs to — the git identity (user.email, resolved like get_user_for_workspace). Stance follows the user, not a tenant.']
  "namespace_id" uuid [note: 'The scope instance this stance applies at (organization/workspace/repository); NULL = the user\'s default across scopes. Most-specific rung overrides.']
  "autonomy" sensei.stance_autonomy [not null, default: 'ask_on_guarded']
  "sharing" sensei.stance_sharing [not null, default: 'patterns']
  "review" sensei.stance_review [not null, default: 'one_maintainer']
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (user_key, namespace_id) [unique, name: 'stances_user_namespace', note: 'unique constraint']
    user_key [unique, name: 'stances_user_default', note: 'where: namespace_id IS NULL']
    namespace_id [name: 'stances_namespace_idx', note: 'where: namespace_id IS NOT NULL']
  }

  Note: '''A user's behavioural stance at a scope — autonomy (how far a run goes before
asking), sharing (what surfaces to the dōjō), review (approvers before a rule
adopts). Governs HOW work runs, complementing the rules (WHAT). User-scoped +
daemon-local (D-STANCE-SCOPE); per-namespace with a NULL-namespace default;
most-specific rung wins on the sensei.scopes ladder.'''
}

Table "sensei"."tracker_unknown_keys" {
  "tracker_id" uuid [pk, not null, note: 'The tracker whose board was asked.']
  "key" text [pk, not null, note: 'The key as the adapter shaped it (Jira: upper-cased).']
  "checked_at" timestamptz [not null, default: `now()`, note: 'When the board last answered that it does not have this key.']

  Note: 'Ticket keys named in AI sessions that the tracker\'s board does not have, as of checked_at. On-demand discovery does not ask the provider again for a key here until its TTL (6 h) passes; a full sync deletes the row of any key it now has.'
}

Table "activity"."memory_loads" {
  "id" bigserial [pk, not null, note: 'Surrogate primary key (bigserial — high write volume).']
  "session_id" uuid [note: 'Optional FK to activity.sessions. NULL in v1 (per-session correlation deferred); set null when the session is deleted.']
  "client_session_id" text [note: 'Optional assistant-side session id string (not a DB UUID). Reserved for future per-session correlation; NULL in v1.']
  "workspace_id" uuid [note: 'The workspace the context was assembled for (not necessarily the memory\'s own scope — global/stack memories load into many workspaces). Null when unknown or after the workspace is deleted.']
  "memory_id" uuid [not null, note: 'Foreign key to memories — which memory was loaded/injected.']
  "source" text [not null, default: 'get_layered_context', note: 'Which delivery path logged this load (e.g. get_layered_context).']
  "loaded_at" timestamptz [not null, default: `now()`, note: 'When the memory was delivered into context (server clock).']

  indexes {
    (memory_id, loaded_at) [name: 'memory_loads_memory_id_idx', note: 'order: asc, desc']
    (session_id, loaded_at) [name: 'memory_loads_session_idx', note: 'order: asc, desc']
    workspace_id [name: 'memory_loads_workspace_id_idx', note: 'where: workspace_id IS NOT NULL']
  }

  Note: '''Per-memory load log — one row per (memory, delivery) event. Written when a
memory is injected into an assistant's context (e.g. get_layered_context /
assemble_context). The read counterpart of sensei.memory_outcomes: loads here
plus applied/ignored outcomes there answer "did injected memory help?" over a
rolling window (loaded vs followed vs skipped). High write volume — bigserial
key. Insertion is non-fatal on the context-delivery hot path: a failure to log
must never block context delivery.
v1 logs with session_id NULL (per-memory COUNT needs no session join);
per-session correlation is a deferred follow-up.'''
}

Table "activity"."snapshots" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "session_id" uuid [not null, note: 'Foreign key to sessions.']
  "folder_id" uuid [not null, note: 'Foreign key to folders.']
  "kind" sensei.snapshot_kind [not null, note: 'Snapshot type: manual or checkpoint.']
  "progress_summary" text [not null, note: 'Summary of work completed, used for recovery.']
  "next_step_hint" text [note: 'Optional hint for next action when resuming.']
  "completed_steps" text[] [not null, default: '{}', note: 'Ordered list of completed step descriptions.']
  "in_flight_files" text[] [not null, default: '{}', note: 'Paths of files being actively modified at snapshot time.']
  "worktree_refs" jsonb [not null, default: '[]', note: 'JSON array of active git worktrees [{branch, path, status}].']
  "diff_stat_summary" text [note: 'Human-readable diff-stat summary at snapshot time.']
  "created_at" timestamptz [not null, default: `now()`, note: 'Timestamp when snapshot was taken.']

  indexes {
    (session_id, created_at) [name: 'snapshots_session_id_idx', note: 'order: asc, desc']
    (folder_id, created_at) [name: 'snapshots_folder_id_idx', note: 'order: asc, desc']
  }

  Note: '''Point-in-time session state for crash recovery and history.
- kind=manual: take_snapshot at a step boundary
- kind=checkpoint: task complete marker
- in_flight_files: flagged for consistency check on recovery
- worktree_refs: [{branch, path, status}] active git worktrees'''
}

Table "activity"."task_sessions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "session_id" uuid [note: 'Foreign key to sessions.']
  "folder_id" uuid [not null, note: 'Foreign key to folders.']
  "task_description" text [note: 'Task description passed at get_session_context.']
  "task_type" sensei.task_type_kind [note: 'Auto-detected: feat, fix, refactor, docs, test, chore, unknown.']
  "status" sensei.task_status [not null, default: 'in_progress', note: 'Lifecycle: in_progress → completed or abandoned.']
  "ftr_score" numeric(4,3) [note: 'First-Try-Right score 0.000–1.000. Null until checkpoint.']
  "ftr_signals" jsonb [note: 'Raw signal values used to compute ftr_score.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of last modification.']
  "completed_at" timestamptz [note: 'Timestamp when task reached terminal state.']

  indexes {
    (folder_id, modified_at) [name: 'task_sessions_folder_id_idx', note: 'order: asc, desc']
    session_id [name: 'task_sessions_session_id_idx', note: 'where: session_id IS NOT NULL']
  }

  Note: '''Task boundaries within sessions. One row per checkpoint boundary.
- ftr_score: 0.000–1.000, null until checkpoint
- status: in_progress → completed or abandoned
Task-level events (task_start, task_end) are in the events table.'''
}

Table "activity"."turns" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "session_id" uuid [not null, note: 'Foreign key to sessions — which session this turn belongs to.']
  "turn_number" int [not null, note: '1-based turn index within the session.']
  "segment" int [not null, default: 1, note: 'Sub-session marker: +1 after an idle gap > threshold. Group by this for work-session boundaries.']
  "started_at" timestamptz [not null, note: 'First event of the turn (the UserPromptSubmit).']
  "ended_at" timestamptz [not null, note: 'Last event of the turn (before the next prompt or session end).']
  "duration" interval [note: 'Active time within the turn (gap-aware).']
  "is_correction" boolean [not null, default: false, note: 'True if this turn\'s prompt corrected the previous turn (FTR detractor).']
  "triage_signal" text [note: 'Which correction heuristic matched (revert/correction/actually/...). Null if not a correction.']
  "tool_calls" int [not null, default: 0, note: 'Number of tool invocations (PostToolUse) in the turn.']

  indexes {
    (session_id, turn_number) [unique, note: 'unique constraint']
    (session_id, turn_number) [name: 'turns_session_id_idx']
    (session_id, segment) [name: 'turns_segment_idx']
  }

  Note: '''Per-turn breakdown of an assistant session, derived from the hook-event stream
(analyzer L0, #66). A turn spans one UserPromptSubmit to the next. `segment`
marks sub-sessions: it increments when the idle gap before a turn exceeds the
threshold, so a multi-day resumed session splits into work segments without
breaking the one-row-per-session model. Sub-sessions are a GROUP BY segment.'''
}

Table "inference"."corrections" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID). Stable across runs via upsert-on-signature.']
  "signature" text [not null, unique, note: 'Deterministic cluster identity: hash(seed_session + normalized seed prompt). Stable as the cluster grows.']
  "text" text [not null, note: 'Canonical correction statement (LLM). Falls back to the seed member\'s normalized snippet when no chat model is available.']
  "suggestion" text [note: 'LLM advisory on what to do (reinforce a memory / add a rule / write a skill). Null when no chat model.']
  "count" int [not null, default: 0, note: 'Number of corrective prompts in the cluster.']
  "workspace_ids" uuid[] [not null, default: '{}', note: 'Distinct workspaces the correction appeared in. Names resolved by the API.']
  "last_seen" timestamptz [note: 'Most recent corrective prompt in the cluster.']
  "memory_id" uuid [note: 'Related learned memory (LLM-matched from a shortlist), or null.']
  "instances" jsonb [not null, default: '[]', note: 'Provenance: [{workspace_id, session_id, ts, prompt}] — the member corrective prompts (snippet).']
  "detected_at" timestamptz [not null, default: `now()`, note: 'When this cluster was first derived.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'When this row was last upserted.']

  indexes {
    workspace_ids [type: gin, name: 'corrections_workspace_ids_idx']
    count [name: 'corrections_count_idx', note: 'order: desc']
    memory_id [name: 'corrections_memory_id_idx', note: 'where: memory_id IS NOT NULL']
  }

  Note: '''Recurring developer corrections, clustered globally across workspaces (analyzer #65 step 5).
One row per recurring correction cluster: similar corrective prompts grouped by
embedding (or lexical) similarity. Re-derived idempotently by the AggregateCorrections
task; `signature` is the stable natural key.'''
}

Table "sensei"."dojo_inbox" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "membership_id" uuid [not null, note: 'Source Dōjō connection (sensei.dojo_memberships.id). Cascade-deletes with the membership.']
  "artifact_seq" bigint [not null, note: 'The federation cursor seq of the source artifact (dojo.artifacts seq). The per-membership pull cursor itself lives on sensei.dojo_memberships.last_seq.']
  "artifact_signature" text [not null, note: 'dojo-protocol artifact signature (content hash over kind/title/body/payload). The dedup key: unique per membership so a re-pull cannot duplicate.']
  "remote_id" text
  "kind" text [not null, note: 'principle | pattern | prompt | guard | skill | agent. Only principle/pattern auto-land on Apply (→ sensei.memories); the rest stay pending with a note.']
  "title" text [not null]
  "body" text [not null]
  "scope" jsonb [not null, default: '{}']
  "attribution" jsonb [not null, default: '{}']
  "state" text [not null, default: 'pending', note: 'pending | applied | muted | pinned. applied = landed into sensei.memories (applied_memory_id set); muted = hidden from the default Upgrades list; pinned = floated to the top / outranks ambiguous local alternatives.']
  "note" text [note: 'Reason an Apply did not land: a deferred kind (skill/agent/prompt/guard) or a scope that does not apply to this install. Null otherwise.']
  "applied_memory_id" uuid [note: 'The sensei.memories row this artifact landed as (origin=dojo). Null until applied (or for kinds that do not land).']
  "received_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (membership_id, artifact_signature) [unique, note: 'unique constraint']
    state [name: 'dojo_inbox_state_idx']
    membership_id [name: 'dojo_inbox_membership_idx']
    applied_memory_id [name: 'dojo_inbox_applied_memory_idx', note: 'where: applied_memory_id IS NOT NULL']
  }

  checks {
    `state IN ('pending', 'applied', 'muted', 'pinned')`
  }

  Note: '''Daemon-local downstream inbox (C7). One row per (source membership, pulled
artifact): the Dōjō service distributes approved artifacts to a membership; the
daemon pulls them (cursor = sensei.dojo_memberships.last_seq) and mirrors them
here as `pending` for the Upgrades screen. The DOWNSTREAM twin of
sensei.dojo_outbox. Apply lands a principle/pattern as a sensei.memories row
(origin='dojo', applied_memory_id links it); skill/agent/prompt/guard are held
pending (consent-sensitive install, deferred). mute/pin are local overrides that
never land anything. The unique (membership_id, artifact_signature) key makes a
re-pull idempotent.'''
}

Table "sensei"."dojo_outbox" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "membership_id" uuid [not null, note: 'Destination Dōjō (sensei.dojo_memberships.id). Cascade-deletes with the membership.']
  "batch_id" uuid
  "memory_id" uuid
  "signature" text [not null, note: 'dojo-protocol artifact signature (content hash over the CHECKED publish-safe kind/title/body/payload). The dedup key: unique per membership.']
  "state" text [not null, default: 'pending', note: 'pending | sent | held | queued | error. `held` is the confidentiality outcome (dereference could not guarantee safety); `queued` is a retryable transport failure.']
  "sent_seq" bigint [note: 'The federation cursor seq the Dōjō assigned on publish. NULL until sent.']
  "remote_id" text [note: 'The dojo.artifacts.id the Dōjō assigned on publish. NULL until sent.']
  "last_attempt_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (membership_id, signature) [unique, note: 'unique constraint']
    state [name: 'dojo_outbox_state_idx']
    batch_id [name: 'dojo_outbox_batch_idx']
    memory_id [name: 'dojo_outbox_memory_idx', note: 'where: memory_id IS NOT NULL']
  }

  checks {
    `state IN ('pending', 'sent', 'held', 'queued', 'error')`
  }

  Note: '''Durable upstream-contribution ledger (C6). One row per (destination membership,
artifact signature): a batch approved for sharing fans out to every routed Dōjō
and every member memory, each producing an artifact whose send state is tracked
here. The unique (membership_id, signature) key makes replay after a federation
drop idempotent — a retry never double-publishes. Mirrors the
sensei.federated_memories ledger used by the rules-federation push path.
- pending: planned, not yet attempted
- sent:    published; sent_seq / remote_id carry the Dōjō-assigned identity
- held:    confidentiality gate refused it (residual identifier risk) — not sent
- queued:  a transient (network / 5xx) failure — awaits replay
- error:   a permanent (4xx / undecodable) failure — logged, not auto-retried'''
}

Table "sensei"."federated_memories" {
  "knowledge_source_id" uuid [pk, not null]
  "remote_rule_id" uuid [pk, not null]
  "content_hash" text [not null]
  "memory_id" uuid
  "remote_seq" bigint [not null]
  "synced_at" timestamptz [not null, default: `now()`]

  indexes {
    memory_id [name: 'federated_memories_memory_id_idx', note: 'where: memory_id IS NOT NULL']
  }

  Note: '''Local↔remote rule mapping + per-rule cursor (federation sync bookkeeping — NOT
a parallel rules table). Pull upserts by (knowledge_source_id, remote_rule_id),
making ingestion idempotent; it is also the echo-guard — a rule this daemon
pushed is recorded here, so pulling it back links to the existing memory instead
of creating a federated duplicate. memory_id is the local memory; null after the
linked memory is hard-deleted.'''
}

Table "sensei"."impact_verdicts" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "workspace_id" uuid [not null, note: 'FK to workspaces — every impact entry belongs to exactly one workspace.']
  "session_id" uuid [note: 'Optional FK to the session that shipped the change. Null for retrospective entries.']
  "title" text [not null, note: 'Short label — the "what" being logged.']
  "note" text [note: 'Optional context — why the change was worth logging or what to watch for.']
  "verdict" sensei.impact_verdict [not null, default: 'pending', note: 'Outcome: pending (not yet judged), success (delivered as intended), mixed (delivered value but not clean), failure (regressed or missed the goal).']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the entry was logged.']
  "decided_at" timestamptz [note: 'When the verdict was assigned. NULL while pending; enforced by CHECK constraint.']

  indexes {
    (workspace_id, created_at) [name: 'impact_verdicts_workspace_idx', note: 'order: asc, desc']
    (workspace_id, verdict, created_at) [name: 'impact_verdicts_verdict_idx', note: 'where: verdict <> \'pending\'\norder: asc, asc, desc']
    session_id [name: 'impact_verdicts_session_idx', note: 'where: session_id IS NOT NULL']
  }

  checks {
    `(verdict = 'pending' AND decided_at IS NULL) OR (verdict <> 'pending' AND decided_at IS NOT NULL)`
  }

  Note: '''Impact log — retrospective judgments about shipped changes. Users file
an entry per meaningful change (feature, refactor, incident response),
then verdict it later as success / mixed / failure once the effect has
had time to settle. Powers the Impact screen in the workspace window and
feeds the analyzer's effectiveness signals. Session linkage is optional
so pre-capture history can be backfilled.'''
}

Table "sensei"."memory_evidence" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "memory_id" uuid [not null, note: 'Foreign key to memories — which memory this evidence supports.']
  "session_id" uuid [note: 'References activity.sessions.id (nullable). No FK — cross-schema reference. Null for a save-time source note.']
  "note" text [note: 'What happened: correction, reinforcement, or contradiction.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    memory_id [name: 'memory_evidence_memory_id_idx']
  }

  Note: '''Evidence that proves or reinforces a memory. Each row is one piece — a session
where the memory was learned/confirmed/contradicted, OR a source reference
supplied at save time (file:line, test name, run id). Used for strength scoring
and provenance.

- session_id: references activity.sessions.id (nullable). No FK — sessions may be in
  a separate schema/DB. Null when the evidence is a save-time source note, not a session.
- note: what happened / the source (e.g. "user corrected indentation twice", "crates/x.rs:42").'''
}

Table "sensei"."memory_examples" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "memory_id" uuid [not null, note: 'Foreign key to memories — which memory this example supports.']
  "node_id" text [not null, note: 'References hierarchy_nodes.id. No FK — survives node deletion.']
  "is_good" boolean [not null, note: 'True = good example (follow this), false = bad example (avoid this).']
  "note" text [note: 'Why this code is a good or bad example for this memory.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    memory_id [name: 'memory_examples_memory_id_idx']
  }

  Note: '''Code examples grounding a memory in real code.
- node_id: references a hierarchy node (file, function, class, etc.)
- is_good: true = canonical implementation to follow, false = divergence to avoid
- note: why this example matters for this memory

No FK on node_id — nodes may be deleted when code changes, but the example record
stays as historical evidence. The note should describe the example independently.'''
}

Table "sensei"."memory_links" {
  "parent_id" uuid [pk, not null, note: 'The consolidated memory that replaced the children.']
  "child_id" uuid [pk, not null, note: 'An original memory that was merged into the parent.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    child_id [name: 'memory_links_child_id_idx']
  }

  Note: '''Memory-to-memory relationships for consolidation.
When multiple memories are combined into one, the combined memory becomes the parent
and the originals become children. Children are then historized into past_memories.

- parent_id: the consolidated/surviving memory
- child_id: the original memory that was merged in'''
}

Table "sensei"."memory_outcomes" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "memory_id" uuid [not null, note: 'Foreign key to memories — which memory this event is about.']
  "session_id" uuid [note: 'Foreign key to activity.sessions. Null when unknown or after the session is deleted.']
  "outcome" sensei.memory_outcome [not null, note: 'What happened: applied (used in output), consulted (loaded but not used), violated (user overruled), ignored (loaded but discarded).']
  "context" text [note: 'Optional free-form note (e.g. file path, brief reason).']
  "recorded_at" timestamptz [not null, default: `now()`, note: 'When the event was recorded (server clock).']

  indexes {
    (memory_id, recorded_at) [name: 'memory_outcomes_memory_id_idx', note: 'order: asc, desc']
    session_id [name: 'memory_outcomes_session_id_idx', note: 'where: session_id IS NOT NULL']
  }

  Note: '''Per-memory event log: applied/consulted/violated/ignored.
Insert triggers update memories.reinforced_count / violated_count / strength / status.'''
}

Table "sensei"."memory_share_batch_members" {
  "batch_id" uuid [pk, not null, note: 'FK to memory_share_batches — the batch this membership belongs to.']
  "memory_id" uuid [pk, not null, note: 'FK to memories — the memory being proposed for share via this batch.']
  "added_at" timestamptz [not null, default: `now()`, note: 'When the memory was attached to the batch (may differ from batch created_at if members are added later).']

  indexes {
    memory_id [name: 'memory_share_batch_members_memory_idx']
  }

  Note: '''Join between memory_share_batches and memories. One row per (batch,
memory) pair. Both foreign keys cascade on delete so removing a memory
or a batch cleanly clears the association.'''
}

Table "sensei"."nodes" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which repo this node belongs to.']
  "parent_id" uuid [note: 'Self-referencing FK for containment hierarchy. Null = top-level in file.']
  "kind" sensei.node_kind [not null, note: 'Node classification. See table comment for full list.']
  "name" text [not null, note: 'Identifier name or heading text.']
  "file_id" uuid [note: 'The file this node is DECLARED in, as a key rather than a repeated path. ON DELETE RESTRICT, never CASCADE: a file\'s removal goes through reconcile, one declaration at a time. NULL for reference stubs and external `lib·` nodes, which have no file by definition. See docs/database/sensei.md.']
  "fqn" text [note: 'Fully-qualified name (SCIP/LSIF moniker). Definitions and references\nget-or-create the same node by (folder_id, fqn) so call edges resolve at emit.\nNULL for legacy / not-yet-migrated nodes, which fall back to bare-name matching.']
  "resolved" boolean [not null, default: false, note: 'True once a definition has been seen for this fqn (file_id/signature/line\nfilled). False for a reference-first stub awaiting its definition. External `lib·`\nnodes are resolved=true (the external symbol IS the definition; nothing to enrich).']
  "language" text [note: 'Language slug (rust/python/typescript/…) derived from the file extension at\nwrite time. Scopes the bare-name fallback to same-language candidates during the\nper-language FQN rollout so a co-resident un-migrated language never cross-matches.']
  "signature" text [note: 'Abbreviated type signature (L0 level). For code symbols.']
  "description" text [note: 'Human-readable description (L1 level). For code symbols or doc summary.']
  "content" text [note: 'Full content text (L2/L3). For doc sections: markdown body. For rationale: comment text.']
  "docstring" text [note: 'Extracted JSDoc/TSDoc/rustdoc comment. For code symbols.']
  "line_start" int [note: 'One-based line number where this node begins in the source file.']
  "line_end" int [note: 'One-based line number where this node ends.']
  "is_exported" boolean [not null, default: false, note: 'True when the symbol is exported from its file. Only meaningful for code symbols.']
  "is_test" boolean [not null, default: false, note: 'True when this node belongs to a test file (path-convention: tests/ dirs,\n*.test.*/*.spec.*, *_test.*, test_*.py, *Test.java, …; see languages::is_test_path).\nLets the UI filter tests out when focusing on production code. External `lib·`\nnodes are never test. Reference stubs inherit it from their definition.']
  "community_id" int [note: 'Leiden community cluster ID. Batch-computed. Null until computed.']
  "embedding" vector(384) [note: '384-dim vector embedding for semantic search. Computed by local model during indexing. HNSW indexed.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for filtering.']
  "props" jsonb [not null, default: '{}', note: 'Extensible metadata. For sections: {level:2}. For rationale: {tag:"WHY"}. For files: {language:"rust"}.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (folder_id, file_id, kind, name, parent_id, line_start) [unique, name: 'nodes_unique_identity', note: 'where: file_id IS NOT NULL\nnulls not distinct']
    (folder_id, fqn) [unique, name: 'nodes_unique_fqn', note: 'where: fqn IS NOT NULL']
    (folder_id, kind, name) [unique, name: 'nodes_unique_structural', note: 'where: file_id IS NULL AND fqn IS NULL']
    file_id [name: 'nodes_file_id_idx']
    folder_id [name: 'nodes_folder_id_idx']
    parent_id [name: 'nodes_parent_id_idx', note: 'where: parent_id IS NOT NULL']
    kind [name: 'nodes_kind_idx']
    (folder_id, name) [name: 'nodes_name_idx']
    (folder_id, is_exported) [name: 'nodes_exported_idx', note: 'where: is_exported']
    community_id [name: 'nodes_community_id_idx', note: 'where: community_id IS NOT NULL']
    embedding [type: hnsw, name: 'nodes_embedding_hnsw', note: 'where: embedding IS NOT NULL\nopclass: vector_cosine_ops\nwith: ef_construction = 64, m = 16']
    tags [type: gin, name: 'nodes_tags_idx']
  }

  Note: '''Unified node table for the code graph. Every structural element is a node:
files, code symbols, doc sections, rationale comments.

Hierarchy via parent_id:
  file → class → method → parameter
  file → section (H1) → section (H2) → section (H3)
  file → function
  function → rationale (from comments)

Node kinds:
  file — source or doc file within a repo
  module, package — structural containers
  class, interface — type definitions
  function, method — callable code
  property, field, parameter — members
  type, const, enum, enum_variant — value definitions
  section — documentation heading (level stored in props)
  rationale — extracted from NOTE/WHY/HACK/TODO/IMPORTANT comments

file_id references the files table (R13) — a key, not a repeated path, so a
rename rewrites one row instead of every node in the file, and a node naming an
untracked file is UNREPRESENTABLE rather than merely wrong.
Relationships between nodes are stored in the edges table.'''
}

Table "sensei"."playbook_run" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "session_id" uuid
  "feature" text
  "lifecycle" sensei.chunk_lifecycle [not null]
  "intent" sensei.chunk_intent [not null]
  "risk" sensei.chunk_risk [not null]
  "rule_id" uuid
  "playbook" text [not null]
  "rationale" text [not null]
  "confirmed" boolean [not null, default: false]
  "outcome" text
  "classified_by" text
  "model_fallback" boolean [not null, default: false]
  "outcome_ftr" boolean
  "workspace_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    session_id [name: 'playbook_run_session_idx']
    workspace_id [name: 'playbook_run_workspace_idx']
    playbook [name: 'playbook_run_playbook_idx']
    rule_id [name: 'playbook_run_rule_idx', note: 'where: rule_id IS NOT NULL']
  }
}

Table "sensei"."rule_pack_adoptions" {
  "pack_id" uuid [pk, not null]
  "namespace_id" uuid [pk, not null, note: 'The adopting namespace — a concrete sensei.namespaces instance, polymorphic over the scope ladder (organization / workspace / repository). Org-level adoption uses the org\'s namespace id.']
  "pinned_version" int [not null]
  "enforcement" sensei.enforcement
  "adopted_by" text [not null]
  "adopted_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    namespace_id [name: 'rule_pack_adoptions_ns_idx']
  }

  Note: '''A namespace's adoption of a rule pack — the bind that makes a library pack govern.
namespace_id is the adopting scope instance (org at the dōjō level, workspace at
workspace-level, repository at repository-level — a stack pack is adopted there). Resolution unions an adopted pack's rules for
every repo whose namespace set includes namespace_id. Pins a pack version; a per-
adoption enforcement override can raise (or lower) the whole pack's tier locally.'''
}

Table "sensei"."rule_pack_rules" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "pack_id" uuid [not null]
  "ordinal" int [not null, default: 0]
  "statement" text [not null]
  "body" text [not null, default: '']
  "rationale" text
  "enforcement" sensei.enforcement [not null, default: 'recommended']
  "verification" sensei.rule_check [not null, default: 'manual', note: 'How conformance is decided (sensei.rule_check): manual | checker | test | review. `checker`/`test` name the verifier in checker_ref.']
  "checker_ref" text
  "remediation" text
  "skill_ref" text
  "applies_to" jsonb [not null, default: `'{}'::jsonb`, note: 'Applicability predicate finer than scope — e.g. {"path_globs":["**/auth/**"],"languages":["ts"]}. Empty = applies wherever the adopting namespace applies.']
  "evidence" jsonb [not null, default: `'{}'::jsonb`, note: 'Grounding for a learned rule — e.g. {"corrections":4,"incidents":["INC-12"],"cite":"OWASP A02"}. Ties governance to the correction/incident data sensei already captures.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (pack_id, ordinal) [unique, name: 'rule_pack_rules_pack_uq']
  }

  Note: '''A pack's owned rules, with their full text + enforcement structure. The authored
SOURCE of a rule (namespace-agnostic); adoption of the parent pack surfaces these
for a namespace. Prose (examples/exceptions) lives in `body`; the behaviour-driving
parts (verification/checker_ref/skill_ref/applies_to) are structured so the daemon
can scope injection to relevant files and point at (or run) the checker.'''
}

Table "sensei"."tracker_tasks" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "tracker_id" uuid [not null, note: 'The board this ticket belongs to.']
  "external_id" text [not null, note: 'The provider\'s immutable issue id.']
  "key" text [not null, note: 'The provider\'s display key (Jira: AUTH-420, stored upper-case). Overwritten when the issue is renamed or moved.']
  "scope" text [note: 'What the key is relative to, when it is not globally unique (GitLab: normalize_repo_key of the project URL). NULL for Jira.']
  "summary" text [note: 'Issue title. Client-confidential: never leaves the machine.']
  "issue_type" text [note: 'Provider issue type, raw (Story, Bug, Task, ...). Not mapped in v1.']
  "status" text [note: 'Provider workflow status, raw.']
  "current_sprint_id" uuid [note: 'The sprint the ticket is in now: among non-removed sprints listing it, active > future > closed (crate::tracker::sprint::pick_current_sprint). NULL = backlog.']
  "removed_at" timestamptz [note: 'When a full sync stopped seeing it. Set once.']
  "last_seen_at" timestamptz [not null, default: `now()`, note: 'When a sync last saw it.']

  indexes {
    (tracker_id, external_id) [unique, note: 'unique constraint']
    (tracker_id, key) [name: 'tracker_tasks_tracker_id_key_idx']
  }

  Note: 'Tickets (issues) of a tracker board, mirrored read-only. Keyed on the provider\'s immutable issue id so a renamed key updates in place. A ticket missing from a full sync gets removed_at; its session links survive. No assignee or other person data, by design.'
}

Table "inference"."drift_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which folder this drift was detected in.']
  "doc_node_id" uuid [not null, note: 'Foreign key to nodes — the doc section that references the code.']
  "code_node_id" uuid [note: 'Foreign key to nodes — the code symbol being referenced. Null if broken (deleted).']
  "status" sensei.drift_status [not null, default: 'current', note: 'Drift status: current (valid), drifted (signature changed), broken (target deleted).']
  "expected_signature" text [note: 'What the documentation says the symbol looks like.']
  "actual_signature" text [note: 'What the code actually has. Null if the target no longer exists.']
  "detail" text [note: 'Human-readable description of the drift.']
  "detected_at" timestamptz [not null, default: `now()`, note: 'Timestamp when this drift was first detected.']
  "resolved_at" timestamptz [note: 'Timestamp when the drift was resolved (doc updated or code reverted). Null if unresolved.']

  indexes {
    folder_id [name: 'drift_items_folder_id_idx']
    status [name: 'drift_items_status_idx', note: 'where: status <> \'current\'']
    doc_node_id [name: 'drift_items_doc_node_id_idx']
    code_node_id [name: 'drift_items_code_node_id_idx', note: 'where: code_node_id IS NOT NULL']
  }

  Note: '''Doc-to-code drift tracking. One row per reference from a doc node to a code node.
- current: reference is valid, signatures match
- drifted: target exists but signature changed
- broken: target was deleted or renamed
- expected_signature: what the doc says the symbol looks like
- actual_signature: what the code actually has (null if broken)'''
}

Table "sensei"."call_sites" {
  "id" bigserial [pk, not null]
  "folder_id" uuid [not null]
  "file_path" text [not null]
  "from_node_id" uuid [not null, note: 'The declaration the call sits in.']
  "at" jsonb [not null, note: 'The invocation\'s span, [start_line, start_col, end_line, end_col] — the same span its `calls` occurrence carries.']
  "callee" text [not null, note: 'The method name as written, without type arguments.']
  "type_args" text[] [not null, default: '{}', note: 'Type arguments verbatim: `Entity<Order>()` → {Order}.']
  "receiver" jsonb [not null, note: '{"kind":"none"} | {"kind":"call","at":[…]} | {"kind":"name","name":…} | {"kind":"other"}.']
  "args" jsonb [not null, note: 'Positional: {"str":…} | {"lambda":{"params":[…],"member":…|null,"at":[…]}} | {"other":true}.']

  indexes {
    (folder_id, file_path) [name: 'call_sites_folder_file_idx']
    (folder_id, callee) [name: 'call_sites_folder_callee_idx']
  }

  Note: '''What a call site was handed beyond its callee — string literals, lambdas, type
arguments and the receiver — for the calls that carry any of them (spec 20 §7b,
#251). A fact about the SOURCE: the walk records `.ToTable("orders")` without
knowing it is EF Core's; the EF Core derivation reads these rows. Keyed by the
file that states them and REPLACED per file on re-index — the fact belongs to the
file, unlike a node.'''
}

Table "sensei"."edges" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "folder_id" uuid [not null, note: 'Foreign key to folders — which repo this edge belongs to.']
  "source_id" uuid [not null, note: 'Foreign key to nodes — the source node of this relationship.']
  "target_id" uuid [note: 'Foreign key to nodes — the target node. Null if unresolved.']
  "target_name" text [note: 'Name of the target for unresolved edges. Allows lookup without a node.']
  "target_file" text [note: 'File path of the target for unresolved edges.']
  "kind" sensei.edge_kind [not null, note: 'Relationship type. See table comment for full list.']
  "confidence" sensei.edge_confidence [not null, default: 'extracted', note: 'Edge confidence: extracted (AST-certain), inferred (embedding/BM25), ambiguous (drift/gap).']
  "confidence_score" numeric(3,2) [note: 'Numeric confidence 0.00-1.00. Used for similarity/duplicate edges.']
  "props" jsonb [not null, default: '{}', note: 'Extensible metadata, MERGED on re-insert (props || EXCLUDED.props) so a later writer cannot erase an earlier one. For imports: {names:["a","b"]}. For duplicates: {similarity:0.86}. For extends/implements: {relation:"extends"|"implements"|"trait_impl"} — the discriminant that separates a Rust trait impl from Java-style interface implementation, which share the implements kind.']
  "resolved_via" text [note: 'Which resolution rung placed this edge — the reduction over the per-use rungs in props.occurrences. NULL on an edge that was not placed. Exactly one of resolved_via / unresolved_reason is set; both NULL means the writer recorded no verdict, which is the pre-v2 shape. See docs/database/sensei.md.']
  "unresolved_reason" text [note: 'Why this edge could not be placed — the reduction over the per-use reasons in props.occurrences. NULL on a placed edge. NOT an error list: external_boundary and dynamic_dispatch are correct outcomes, not defects. See docs/database/sensei.md.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    folder_id [name: 'edges_folder_id_idx']
    source_id [name: 'edges_source_id_idx']
    target_id [name: 'edges_target_id_idx', note: 'where: target_id IS NOT NULL']
    kind [name: 'edges_kind_idx']
    folder_id [name: 'edges_owns_folder_idx', note: 'where: (props ->> \'relation\') = \'owns\'\ninclude: target_id']
    (folder_id, kind) [name: 'edges_folder_kind_cover_idx', note: 'where: target_id IS NOT NULL\ninclude: source_id, target_id']
    confidence [name: 'edges_confidence_idx']
    `(props -> 'occurrences')` [type: gin, name: 'edges_occurrences_gin']
    (folder_id, source_id, target_id, kind) [unique, name: 'edges_unique_resolved', note: 'where: target_id IS NOT NULL']
    (folder_id, source_id, target_name, target_file, kind) [unique, name: 'edges_unique_unresolved', note: 'where: target_id IS NULL\nnulls not distinct']
  }

  Note: '''Typed relationships between nodes in the code graph.

Edge kinds:
  calls — function/method calls another function/method
  implements — class implements interface
  extends — class/interface extends another
  imports — file imports from file/module (props: {names:["useState","useEffect"]})
  depends_on — module-level dependency
  traces_to — documentation traces to code symbol
  references — doc section references a symbol or file
  covers — doc file covers source file
  rationale_for — comment explains a symbol
  duplicates — structurally identical code (confidence_score = similarity)
  similar_to — semantically similar (inferred from embeddings)

target_id is nullable — null when the target node is unresolved (external symbol, unindexed file).
target_name and target_file provide lookup info for unresolved edges.'''
}

Table "sensei"."schema_entities" {
  "node_id" uuid [pk, not null]
  "kind" sensei.schema_object_kind [not null]
  "db_schema" text [not null]
  "source" sensei.schema_source [not null]
  "naming" sensei.schema_naming [not null]
  "note" text
  "note_md" text
  "modified_at" timestamptz [not null, default: `now()`]

  Note: '''One database object — a table, view, materialized view, function or procedure —
described in detail. The object itself is a NODE (`nodes.id`), which is what puts
it in the code graph; this row and its children carry what the graph does not:
the schema it lives in, who described it, and (in schema_columns /
schema_indexes / schema_refs) its columns, indexes and column-level foreign keys.

- **Why a separate store.** Columns as nodes would multiply the SQL half of the
  graph ~10x and force an embedding decision per column; detail in
  `nodes.props` would bloat every node read to serve one screen. Decision
  2026-10-08, docs/history/plan/decisions.md; spec docs/spec/indexer/20-schema-entities.md.
- **Who writes it.** `persist::write_schema`, from the dbd importer (a
  `SchemaBatch`) and from ORM extractors (`FileFacts.schema`), in the same
  transaction as the node. A re-index REPLACES an object's detail.
- **Lifetime.** Cascades from the node: an object removed by a re-index takes
  its columns, indexes and refs with it.'''
}

Table "sensei"."session_task_links" {
  "session_id" uuid [pk, not null, note: 'The AI session.']
  "task_id" uuid [pk, not null, note: 'The ticket.']
  "source" sensei.link_source [pk, not null, note: 'Where the key was found: branch or prompt (commit is reserved).']
  "matched_key" text [not null, note: 'The key as matched, upper-cased with its digits as written (an old key of a renamed issue stays as it was typed).']
  "mentions" int [not null, note: 'branch: distinct branches carrying the key; prompt: occurrences across the session\'s prompts.']
  "linked_at" timestamptz [not null, default: `now()`, note: 'When the link was (re)computed.']

  indexes {
    task_id [name: 'session_task_links_task_id_idx']
  }

  checks {
    `mentions > 0`
  }

  Note: 'A session linked to a tracker ticket because its branch or prompts carry one of the ticket\'s keys (current or former). Recomputed on every sync of the ticket\'s tracker (a full relink in the sync\'s apply transaction). Only keys the board actually has can link.'
}

Table "sensei"."tracker_task_keys" {
  "task_id" uuid [pk, not null, note: 'The ticket.']
  "key" text [pk, not null, note: 'One key the ticket has had, in the adapter\'s canonical form.']
  "first_seen_at" timestamptz [not null, default: `now()`, note: 'When a sync first saw the ticket under this key.']

  indexes {
    key [name: 'tracker_task_keys_key_idx']
  }

  Note: 'Key aliases of tracker tickets: the current key plus every former one (rename, move). Written by each sync\'s apply (on conflict do nothing), read when matching session text, so history survives a rename.'
}

Table "sensei"."tracker_task_sprints" {
  "task_id" uuid [pk, not null, note: 'The ticket.']
  "sprint_id" uuid [pk, not null, note: 'A sprint that lists it.']

  indexes {
    sprint_id [name: 'tracker_task_sprints_sprint_id_idx']
  }

  Note: 'Sprint membership of tickets (many-to-many). Replaced per fetched sprint on each sync; a removed sprint\'s rows are deleted.'
}

Table "sensei"."schema_columns" {
  "node_id" uuid [pk, not null]
  "ordinal" int [not null]
  "name" text [pk, not null]
  "sql_type" text [not null]
  "primary_key" boolean [not null, default: false]
  "not_null" boolean [not null, default: false]
  "unique_key" boolean [not null, default: false]
  "foreign_key" boolean [not null, default: false]
  "enum_typed" boolean [not null, default: false]
  "default_expr" text
  "note" text

  Note: '''The columns of a schema object, in declaration order. dbd SchemaModel v2's
`Column {name, ty, pk, nn, uq, fk, en, def, note}`, renamed only where a SQL
keyword collides: `sql_type` is the declared type VERBATIM, `default_expr` the
default expression as written. `foreign_key` is the flag a renderer needs
without scanning schema_refs; WHICH key it is lives there. Unique per
(object, name). Replaced wholesale when the object is re-indexed.'''
}

Table "sensei"."schema_indexes" {
  "id" bigserial [pk, not null]
  "node_id" uuid [not null]
  "name" text
  "definition" text [not null]
  "unique_index" boolean [not null, default: false]

  indexes {
    node_id [name: 'schema_indexes_node_id_idx']
  }

  Note: '''The indexes of a schema object: dbd SchemaModel v2's `Index {def, unique,
name}`. `definition` is the column spec as written — `(status, placed_at DESC)`
— an expression, so text and not a structured column list. `name` may be NULL:
dbd reports unnamed indexes. Replaced wholesale when the object is re-indexed.'''
}

Table "sensei"."schema_refs" {
  "id" bigserial [pk, not null]
  "from_node_id" uuid [not null]
  "from_column" text [not null]
  "to_node_id" uuid [not null]
  "to_column" text [not null]
  "on_delete" sensei.fk_action

  indexes {
    from_node_id [name: 'schema_refs_from_node_id_idx']
    to_node_id [name: 'schema_refs_to_node_id_idx']
  }

  Note: '''Column-level foreign keys: one row per column PAIR, which is how dbd
SchemaModel v2 carries a composite key (`Ref {from {s,t,c}, to {s,t,c},
action}`). The TABLE-level relationship is also a `references` edge in
sensei.edges, so the graph answers "what touches this table"; this row is the
detail an ER diagram draws. Cascades from BOTH ends: removing either object
removes the line rather than leaving one to nothing. `on_delete` NULL means
the source stated no action.'''
}

