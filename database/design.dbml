Table "activity"."capture_watermarks" {
  "source" text [pk, not null]
  "file_path" text [pk, not null]
  "session_id" text
  "last_mtime_ns" bigint [not null]
  "turns_ingested" int [not null, default: 0]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: '''Resumable cursor for transcript ingest (#73): per-file mtime so re-runs skip
unchanged transcripts. Shared by the backfill and forward-capture workers.'''
}

Table "activity"."session_facet_tags" {
  "session_id" text [pk, not null]
  "kind" sensei.facet_tag_kind [pk, not null]
  "value" text [pk, not null, note: 'Deliberately text, not an enum: the goal and friction vocabularies grow as more\nACPs are seen, and a new value should not need a migration. The analyzer discards\nvalues outside its current closed list before writing, so a model inventing a\ncategory cannot break a group-by. `kind` IS an enum because it is closed.']
  "weight" int [not null, default: 1, note: 'How strongly the tag applies. 1 for a plain occurrence; higher when the analyzer\nsaw a session dominated by one kind of work.']

  indexes {
    (kind, value) [name: 'session_facet_tags_kind_value_idx']
  }

  Note: '''Goal categories and friction kinds per session, one row per tag (spec 2026-08-26).
One table for both multisets, discriminated by `kind`. Rewritten in place when a
session is re-analyzed.'''
}

Table "activity"."session_facets" {
  "session_id" text [pk, not null, note: 'The assistant\'s own session id (activity.sessions.client_session_id), matching\nsession_process_evidence.session_id — the join key for the cited turns. Not an FK:\na session row can be pruned while its derived record and quotes stay legible.']
  "underlying_goal" text [note: 'One sentence describing what the person was trying to achieve. NULL until the\nfull facet pass has run — a row may exist carrying only a stage, written by the\nprocess analyzer, before anything else about the session has been derived.']
  "goal_outcome" sensei.goal_outcome [note: 'Whether the session achieved its goal, read from the transcript. Distinct from\nactivity.sessions.outcome, which is mechanical — a session is routinely both\n`corrected` and `mostly_achieved`. NULL means the analyzer would not commit to a\nreading.']
  "primary_success" text [not null, default: '']
  "friction_detail" text [not null, default: '', note: 'One sentence naming what got in the way. Empty string means the analyzer saw no\nfriction — distinct from a session with no record at all, which is simply absent\nfrom this table.']
  "stage" sensei.work_stage [note: 'Which stage of the work this session was doing. NULL when the analyzer would\nnot commit to one — such a session is EXCLUDED from stage rollups rather than\nbucketed into a default, so a rollup never reports a guess as a measurement.']
  "stage_source" sensei.stage_source [note: 'Where the stage came from: `recorded` (the developer declared it, e.g. via a\nplaybook phase) or `inferred` (read from the transcript). Any surface showing a\nstage rollup must be able to say which, because the two carry different weight.']
  "analyzed_at" timestamptz [not null, default: `now()`]

  indexes {
    goal_outcome [name: 'session_facets_outcome_idx', note: 'where: goal_outcome IS NOT NULL']
    stage [name: 'session_facets_stage_idx', note: 'where: stage IS NOT NULL']
  }

  checks {
    `(stage IS NULL) = (stage_source IS NULL)` [name: 'session_facets_stage_attributed']
  }

  Note: '''LLM-derived retrospective record, one row per session (spec 2026-08-26).
Scalar facets only; the goal/friction multisets live in
activity.session_facet_tags and the grounding quotes in
activity.session_process_evidence. brief_summary is NOT here — it is
activity.sessions.summary.'''
}

Table "activity"."session_process_evidence" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "session_id" text [not null, note: 'The assistant\'s own session id (activity.sessions.client_session_id), matching\ntranscript_turns.session_id — the join key for the cited turn.']
  "signal" text [not null, note: 'Which judgment this quote grounds: spec_depth | spec_deviation | refuted_findings\n| incomplete_analysis_llm.']
  "turn_index" int [not null]
  "quote" text [not null]
  "kind" text [note: 'Optional role of the quote within an evidence pair: plan/action (deviation) or\nassertion/retraction (refuted_findings). NULL for single-quote signals.']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    session_id [name: 'session_process_evidence_session_idx']
    (session_id, signal) [name: 'session_process_evidence_session_signal_idx']
  }

  Note: '''Evidence quotes grounding the LLM process-quality judgments (spec 2026-08-20).
One row per cited transcript turn per signal. Not FK-linked to transcript_turns
(turns may be pruned) — the verbatim quote keeps the drill-down legible. Every
row corresponds to a real cited turn: ungrounded judgments are dropped, not
stored (spec D5).'''
}

Table "activity"."task_execution_daily" {
  "day" date [pk, not null]
  "task_kind" sensei.task_execution_kind [pk, not null]
  "status" text [pk, not null]
  "runs" bigint [not null, note: 'Rows collapsed into this bucket.']
  "failures" bigint [not null, default: 0, note: 'Of those runs, how many ended failed. Redundant with status but kept so a\nsingle row answers "how bad was this day" without a second scan.']
  "items_processed" bigint [note: 'Sum of the handlers own return values (files queued, rows written …) —\nNULL when no row in the bucket reported one.']
  "p50_ms" int [note: 'Median wall-clock duration. NULL when no row in the bucket completed.\n\nDuration percentiles, not just an average: task duration is heavily skewed (a cold embedded model, a huge repo) and a mean hides exactly the tail that matters when the queue feels slow.']
  "p95_ms" int
  "max_ms" int
  "rolled_up_at" timestamptz [not null, default: `now()`]

  indexes {
    day [name: 'task_execution_daily_day_idx', note: 'order: desc']
  }

  Note: '''Daily aggregate of activity.task_executions, written by the retention pass
before it deletes the raw rows. One row per (day, kind, status).

The raw table answers "what did task #4711 do"; this one answers "how much ran,
how slow, how often did it fail" — the questions that outlive an individual run.

Idempotent: the retention pass upserts on (day, task_kind, status), so
re-running over a day already rolled up produces the same row rather than
double-counting.'''
}

Table "activity"."task_executions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "task_id" bigint [not null, note: 'In-memory queue task ID. Unique per daemon session (resets on restart).']
  "parent_task_id" bigint [note: 'Parent task ID for hierarchy. process_file → process_git_folder → scan_root.']
  "task_kind" sensei.task_execution_kind [not null, note: 'TaskKind::to_string() — scan_root, process_file, resolve_edges, etc.']
  "folder_path" text [not null, default: '', note: 'Git folder abs path — groups all tasks for a repo.']
  "path" text [not null, default: '', note: 'Specific path this task operates on (file, folder, URL).']
  "status" text [not null, default: 'running', note: 'running, completed, or failed.']
  "items_processed" int [note: 'Count of items handled: symbols parsed, edges resolved, files queued, etc.']
  "duration_ms" int [note: 'Wall-clock milliseconds from start to completion.']
  "retry_number" int [not null, default: 0, note: '0 for first attempt. Incremented if the same task is retried.']
  "error_message" text [note: 'Error detail if status = failed.']
  "started_at" timestamptz [not null, default: `now()`]
  "completed_at" timestamptz

  indexes {
    task_kind [name: 'task_executions_task_kind_idx']
    folder_path [name: 'task_executions_folder_path_idx']
    parent_task_id [name: 'task_executions_parent_task_id_idx', note: 'where: parent_task_id IS NOT NULL']
    started_at [name: 'task_executions_started_at_idx']
    status [name: 'task_executions_status_idx']
  }

  Note: '''Task execution history — one row per task run. Forms a tree via parent_task_id.

status: running → completed | failed
retry_number: 0 for first attempt, incremented on retry.
duration_ms and items_processed set on completion.
started_at vs completed_at shows wall-clock execution time.

Common queries:
  -- Execution tree for a scan
  WITH RECURSIVE tree AS (
    SELECT * FROM task_executions WHERE task_id = $1
    UNION ALL
    SELECT e.* FROM task_executions e JOIN tree t ON e.parent_task_id = t.task_id
  ) SELECT * FROM tree ORDER BY started_at
  -- Slowest tasks
  SELECT task_kind, avg(duration_ms), max(duration_ms) FROM task_executions WHERE status = 'completed' GROUP BY task_kind
  -- Failed tasks in last hour
  SELECT * FROM task_executions WHERE status = 'failed' AND started_at > now() - interval '1h\''''
}

Table "activity"."transcript_turns" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "source" text [not null]
  "session_id" text [not null]
  "family" text [not null, note: 'NOT NULL: `TranscriptAdapter::family()` returns `&\'static str`, so the ingest path cannot produce a null — the column being nullable let stale fixtures hold one, which then broke a repair query that legitimately assumed the contract.']
  "provider" text
  "model" text
  "turn_index" int [not null]
  "user_text" text
  "assistant_text" text
  "char_count" int [not null, default: 0]
  "started_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "attrs" jsonb [not null, default: `'{}'::jsonb`, note: 'Every per-turn attribute the transcript carried, verbatim, including the fields not promoted to columns. Keeps a new signal a query rather than a re-ingest of files the user may have rotated away. See docs/database/activity.md.']
  "tokens_in" bigint
  "tokens_out" bigint
  "cache_read" bigint
  "cache_write" bigint
  "stop_reason" text
  "is_sidechain" boolean
  "skill" text [note: 'Which skill/plugin drove the turn — the "are our skills used?" question, the same shape as the unused-tools signal but for skills.']
  "plugin" text
  "git_branch" text
  "effort" text
  "service_tier" text

  indexes {
    (source, session_id, turn_index) [unique, note: 'unique constraint']
    session_id [name: 'transcript_turns_session_idx']
    (source, session_id) [name: 'transcript_turns_source_session_idx']
    skill [name: 'transcript_turns_skill_idx', note: 'where: skill IS NOT NULL']
  }

  Note: '''Per-turn assistant/user prose parsed from agent transcripts (#73). Backfills the
prose the hook stream lacks; consumed by the analyzer LLM tiers. Grain = one
user-prompt -> assistant-response turn. Identity = (source, session_id, turn_index).'''
}

Table "gateway"."fallback_chains" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" text [not null, unique, note: 'Unique chain name (e.g. "reasoning", "embed", "classify", "consensus-proposer").']
  "capability" sensei.model_capability [not null, note: 'Which capability this chain serves: chat, reasoning, embed, classify, summarize, vision, audio.']
  "description" text [note: 'What this chain is for (e.g. "MOE proposer — strong reasoning models").']
  "role" sensei.inference_role [note: 'Sensei inference role this chain serves. Null for utility chains (e.g. consensus-*) that the gateway invokes by name for internal orchestration. Unique when set — one chain per role.']
  "max_fallback_attempts" int [not null, default: 3, note: 'Maximum number of models to attempt before failing.']
  "is_active" boolean [not null, default: true, note: 'Whether this chain is available for use.']
  "sequence" int [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    role [unique, name: 'fallback_chains_role_uidx', note: 'where: role IS NOT NULL']
  }

  Note: '''Ordered model fallback sequences per capability.
When a model fails (timeout, rate limit, error), the gateway tries the next in sequence.
- capability: which model_capability this chain handles (chat, reasoning, embed, etc.)
- role: which sensei inference role this chain serves (nullable — utility chains
  like consensus-* stay null). Enforced unique when set, so a role points at
  exactly one chain and vice versa.
- max_fallback_attempts: how many models to try before giving up
Seed data loaded via staging.import_fallback_chains().'''
}

Table "gateway"."providers" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" text [not null, unique, note: 'Unique slug identifier (e.g. "anthropic", "meta", "google").']
  "display_name" text [not null, note: 'Human-readable name (e.g. "Anthropic", "Meta").']
  "description" text [note: 'Brief description of the provider.']
  "website_url" text [note: 'Provider homepage URL.']
  "is_open_source" boolean [not null, default: false, note: 'Whether the provider primarily offers open-source models.']
  "is_active" boolean [not null, default: true, note: 'Whether models from this provider are available for selection.']
  "sequence" int [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''AI model organizations — OpenAI, Anthropic, Meta, Google, Alibaba, etc.
Seed data loaded via staging.import_providers().'''
}

Table "gateway"."routers" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" text [not null, unique, note: 'Unique slug identifier (e.g. "ollama", "anthropic", "openai").']
  "display_name" text [not null, note: 'Human-readable name (e.g. "Ollama (local)", "Anthropic").']
  "description" text [note: 'Brief description of this router.']
  "router_type" sensei.router_type [not null, note: 'Router category: direct (single provider), aggregator (multi-provider), local (on-device).']
  "api_base_url" text [note: 'Base URL for API calls (e.g. "http://localhost:11434", "https://api.anthropic.com").']
  "api_key_env_var" text [note: 'Environment variable name containing the API key (e.g. "ANTHROPIC_API_KEY"). Null for local routers.']
  "authentication_type" sensei.auth_type [not null, default: 'api_key', note: 'How to authenticate: api_key (header-based) or none (local).']
  "default_headers" jsonb [not null, default: '{}', note: 'Default HTTP headers for requests to this router.']
  "rate_limits" jsonb [not null, default: '{}', note: 'Rate limits: {requests_per_minute, tokens_per_minute}.']
  "config" jsonb [not null, default: '{}', note: 'Connection config: {timeout_ms, retry_limit, retry_delay_ms, circuit_breaker_threshold, circuit_breaker_window_minutes}.']
  "is_active" boolean [not null, default: true, note: 'Whether this router is available for use.']
  "sequence" int [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''API access points for LLM gateway.
- direct: single-provider API (anthropic, openai)
- aggregator: multi-provider proxy (openrouter)
- local: on-device runtime (ollama)
- config: connection settings — {timeout_ms, retry_limit, retry_delay_ms, circuit_breaker_threshold, ...}
- rate_limits: {requests_per_minute, tokens_per_minute}
Seed data loaded via staging.import_routers().'''
}

Table "history"."past_extensions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "extension_id" uuid [not null, note: 'References sensei.extensions.id. No FK — survives hard deletes.']
  "plugin_id" uuid
  "kind" text [not null]
  "name" text [not null]
  "version" text
  "description" text
  "content" text
  "props" jsonb [not null, default: '{}']
  "scope" text [not null]
  "enabled" boolean [not null]
  "source" text [not null]
  "icons" jsonb [not null, default: '{}']
  "tags" text[] [not null, default: '{}']
  "operation" sensei.dml_operation [not null, note: 'DML that produced this entry: INSERT, UPDATE, or DELETE.']
  "revision" int [not null, default: 0, note: 'Revision number of the extension at this snapshot.']
  "recommendation_id" uuid [note: 'Which recommendation triggered this change. Null for manual edits. Links to inference.recommendations.']
  "effective_from" timestamptz [not null, note: 'When this revision became the live state.']
  "effective_to" timestamptz [note: 'When this revision was superseded. Null if still current or if source was deleted.']
  "changed_at" timestamptz [not null, default: `now()`, note: 'When this history entry was written.']
  "changed_by" text [note: 'Who triggered the change: user, recommendation:{id}, system.']

  indexes {
    extension_id [name: 'past_extensions_extension_id_idx']
    recommendation_id [name: 'past_extensions_recommendation_idx', note: 'where: recommendation_id IS NOT NULL']
  }

  Note: '''History table for sensei.extensions — auto-populated by historize_extensions trigger.
Captures every INSERT, UPDATE, and DELETE so that skill/persona/rule changes can be
audited and correlated with FTR impact via recommendation_id.

- extension_id: references sensei.extensions.id with no FK — survives hard deletes
- recommendation_id: which recommendation triggered this change (null for manual edits)
- effective_from/to: when this revision was the live state
- operation: INSERT, UPDATE, or DELETE'''
}

Table "history"."past_memories" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "memory_id" uuid [not null, note: 'References sensei.memories.id. No FK — survives hard deletes.']
  "workspace_id" uuid
  "scope" text [not null]
  "scope_filter" text
  "type" text [not null]
  "title" text [not null]
  "content" text [not null]
  "impact" text
  "strength" real [not null]
  "status" text [not null]
  "session_id" uuid
  "operation" sensei.dml_operation [not null, note: 'DML that produced this entry: INSERT, UPDATE, or DELETE.']
  "effective_from" timestamptz [not null, note: 'When this revision became the live state.']
  "effective_to" timestamptz [note: 'When this revision was superseded. Null if still current or if source was deleted.']
  "changed_at" timestamptz [not null, default: `now()`, note: 'When this history entry was written.']

  indexes {
    memory_id [name: 'past_memories_memory_id_idx']
  }

  Note: '''History table for sensei.memories — auto-populated by historize_memories trigger.
Captures every INSERT, UPDATE, and DELETE so that memory evolution can be audited.

- memory_id: references sensei.memories.id with no FK — survives hard deletes
- effective_from/to: when this revision was the live state
- operation: INSERT, UPDATE, or DELETE'''
}

Table "public"."logs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "level" varchar [not null]
  "running_on" varchar [not null]
  "module" varchar
  "logged_at" timestamptz [not null]
  "message" varchar
  "context" jsonb [not null, default: '{}']
  "data" jsonb
  "error" jsonb
  "written_at" timestamptz [not null, default: `now()`]

  indexes {
    level [name: 'logs_level_idx']
    running_on [name: 'logs_running_on_idx']
    logged_at [name: 'logs_logged_at_idx']
    module [name: 'logs_module_idx']
  }

  Note: '''Generic structured log table — shared across daemon, CLI, MCP, and app.
Follows the kavach logger pattern: level, running_on, context jsonb, data jsonb, error jsonb.

running_on: daemon, cli, mcp, app — identifies which component wrote the log.
module: top-level component bucket (tasks, api, indexer, gateway) — a first-class
  indexed column (like running_on), NOT a context prop, so it queries/indexes plainly.
context: flexible jsonb bag — callers inject attributes like method, task_id, tool, etc.
data: structured payload — task metrics (duration_ms, items_processed), API params, etc.
error: structured error — message, stack, code.

Common queries:
  -- All task executions sorted by duration
  SELECT * FROM logs WHERE module = 'tasks' ORDER BY (data->>'duration_ms')::int DESC
  -- Errors in the last hour
  SELECT * FROM logs WHERE level = 'error' AND logged_at > now() - interval '1h'
  -- All activity from a specific component
  SELECT * FROM logs WHERE running_on = 'mcp' ORDER BY logged_at DESC'''
}

Table "sensei"."assistants" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "family" sensei.assistant_family [not null, note: 'Assistant product family: claude, cursor, zed, continue, codex, aider, opencode, kiro.']
  "name" text [not null, note: 'Specific variant or display name (e.g. "Claude Code CLI", "Cursor").']
  "version" text [note: 'Detected version of the assistant binary/app.']
  "path" text [note: 'Filesystem path to the assistant binary or config directory.']
  "transport" text [not null, default: 'stdio', note: 'Communication transport: stdio (pipes) or http (localhost).']
  "configured" boolean [not null, default: false, note: 'True once sensei has registered its extensions (skills, commands, hooks, MCP) with this assistant.']
  "configured_at" timestamptz [note: 'Timestamp of the last configuration/registration run. Null if never configured.']
  "configured_version" text [note: 'Sensei version string at last configuration. Bootstrap compares this to running version to trigger upgrade reconfiguration.']
  "props" jsonb [not null, default: '{}', note: 'Extra metadata: {detected_at, install_method, registration_log, capabilities, supported_hooks, last_health_check}.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (family, name) [unique, note: 'unique constraint']
    family [name: 'assistants_family_idx']
    configured [name: 'assistants_configured_idx', note: 'where: configured = true']
  }

  Note: '''Detected AI coding assistants (ACPs) and their configuration state.
Bootstrap detects installed assistants and upserts rows here.
Setup wizard (step 3) registers sensei plugins/skills/commands per assistant.
On upgrade, bootstrap compares configured_version against the running sensei
version — if stale, the upgrade flow re-pushes skills, agents, hooks, and
commands to each configured assistant.

- family: groups variants of the same product (e.g. claude covers claude-code CLI and claude-code desktop)
- transport: stdio or http — how sensei communicates with this assistant
- configured: true once sensei has registered its extensions with this assistant
- configured_at: when registration last ran (null = never configured)
- configured_version: sensei version at last configuration — drives upgrade reconfiguration
- props: extra metadata — {detected_at, install_method, registration_log, capabilities}'''
}

Table "sensei"."collective_preferences" {
  "singleton" boolean [pk, not null, default: true, note: 'Fixed true (CHECK) — enforces exactly one row; the upsert keys ON CONFLICT (singleton).']
  "destination" text [not null, default: 'none', note: 'Where insights go: none | global (public commons) | dojo (company) | both. Default none — nothing leaves the machine.']
  "cadence" text [not null, default: 'manual', note: 'How often batches are prepared: manual | daily | weekly. manual pauses batching until the user triggers next-batch.']
  "categories" jsonb [not null, default: `'{}'::jsonb`, note: 'Per-category share toggles as jsonb {category: bool}. Categories: memory, pattern, rule, prompt, guard, skill, agent (spec Purpose list). A false value drops that kind from the next batch.']
  "attribution_default" text [not null, default: 'anonymous', note: 'Default credit applied when an insight leaves the machine: named | anonymous (mirrors dojo.attribution_mode / dojo_protocol::AttributionMode). Default anonymous — no personal credit. Source-dereference is a separate always-on invariant.']
  "updated_at" timestamptz [not null, default: `now()`]

  checks {
    `singleton`
  }

  Note: '''Single-row (singleton boolean PK) collective-intelligence sharing preferences for
the local user. Backs GET/PUT /api/preferences/collective and gates the Dōjō
contribute loop: destination (none|global|dojo|both), cadence (manual|daily|weekly),
per-category share toggles (jsonb), and the default attribution mode. When no row
exists the API returns conservative defaults (destination none, manual, attribution
anonymous).'''
}

Table "sensei"."config" {
  "key" text [pk, not null, note: 'Preference key.']
  "value" text [not null, note: 'Preference value stored as text (JSON-encoded for complex values).']

  Note: '''Key-value user preferences.
setup_complete, active_project, sidebar_max_items, etc.'''
}

Table "sensei"."consolidated_rulesets" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "scope" text [not null, note: 'What was merged: \'global\' (always-on user/general rules) in v1; later a repo abs_path or namespace key.']
  "version" int [not null, note: 'Monotonic per scope. New consolidation = max(version)+1.']
  "content" text [not null, note: 'The merged markdown ruleset produced by the model.']
  "conflicts" jsonb [not null, default: '[]', note: 'Conflicts the model surfaced during the merge (JSON array). Empty when none/unextracted.']
  "model" text [note: 'Model that produced this merge (e.g. gemma4).']
  "source_hash" text [not null, note: 'Hash of the Tier-1 input rules. A consolidate is skipped when the latest version already has this hash (no change to merge).']
  "status" text [not null, default: 'proposed', note: 'proposed (awaiting approval) | approved (active, feeds rules.md) | superseded (an older approved version).']
  "created_at" timestamptz [not null, default: `now()`, note: 'When this version was produced.']
  "origin" sensei.entity_origin [not null, default: 'learned', note: 'Only `origin` from the shared vocabulary (sensei.entity_origin).\n\nNOT `scope`: this table already has one, and it means something else — the GOVERNANCE scope the ruleset belongs to (it keys the unique constraint with `version`, and matches sensei.scopes). That is applicability, not visibility. Adding a second column of the same name would have been the exact confusion this vocabulary exists to end.']

  indexes {
    (scope, version) [unique, name: 'consolidated_rulesets_scope_version', note: 'unique constraint']
    (scope, status) [name: 'consolidated_rulesets_scope_status_idx']
  }

  Note: '''Governance Tier-2 output: an LLM-merged, human-approved ruleset for a scope.
Tier-1 resolution (resolve_rules_raw / resolve_global_rules) gathers + orders the
raw rules; Tier-2 asks a model to merge them into one coherent, deduped,
conflict-flagged markdown ruleset. Each consolidation is a kept version; the row
with status=approved for a scope is the active merged ruleset (it feeds
~/.sensei/rules.md). Versioning IS the history — no separate history table.'''
}

Table "sensei"."dojo_memberships" {
  "id" uuid [pk, not null, note: 'The service membership id (dojo.memberships.id), as GET /v1/you/memberships lists it. sensei.workspaces.dojo_id references this value.']
  "registry_url" text [not null]
  "tenant_key" text [not null]
  "dojo_url" text [not null]
  "kind" text [not null, note: 'employer | client | community | personal — drives client-precedence routing (see dojo/routing.rs). client-bound work routes to the client Dōjō (credited anonymous); employer is excluded. All shared work is source-dereferenced regardless (always-on invariant).']
  "org_slugs" text[] [not null, default: '{}', note: 'Git-remote owner slugs this membership covers (lowercased), mirrored from dojo.memberships.org_slugs. dojo/routing.rs::infer_binding matches a workspace\'s repo owner against this set to SUGGEST a binding (confirm-inferred in the About panel) — it never auto-commits.']
  "role" text [not null, default: 'contributor']
  "authenticated_via" text [not null, default: 'device_code']
  "attribution_default" text [not null, default: 'named']
  "sync_status" text [not null, default: 'authenticating', note: 'Intended: last-known connection health (healthy | stale | error | authenticating), derived on the daemon side from last_heartbeat_at. NOT IMPLEMENTED — the producer does not exist. Nothing writes last_heartbeat_at anywhere in the codebase, and the only sync_status setter (dojo::memberships::set_sync_status) is dead code with no callers, so every row is stuck at the \'authenticating\' literal written once when the sync joins it. Treat this column as a designed seam, not as data.']
  "last_seq" bigint [not null, default: 0]
  "last_heartbeat_at" timestamptz [note: 'Intended: the last successful federation heartbeat, driving the sync_status derivation. HAS NO WRITER. There is no heartbeat endpoint and no UPDATE against this column anywhere — daemon, dojo or app. The only real heartbeat in the system is activity.runs.heartbeat_at, which is run liveness and never touches memberships. Always NULL today.']
  "enabled" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    kind [name: 'dojo_memberships_kind_idx']
  }

  Note: '''Daemon-local mirror of the Dōjōs this install belongs to. Fork 1: the
authoritative dojo.memberships row lives in the Dōjō service DB; this row records
the registry URL, tenant_key, service membership id (as the PK) and routing
fields so the daemon can route and federate. sensei.workspaces.dojo_id points at
id. Created by the sync from the signed-in persona's memberships (#236 step 4e);
holds no credential.'''
}

Table "sensei"."dojo_preferences" {
  "scope" text [pk, not null, default: 'user', note: 'Preference scope: \'user\' now; later a dojo / org / namespace key. PK part.']
  "capability" text [pk, not null, note: 'Canonical command verb the preference applies to (test / build / lint / run / format / typecheck / e2e / bench / docs / start / dev). PK part.']
  "preferred" text [not null, note: 'Match token for the preferred command — matched against a command\'s raw_name (exact) or command_line (substring), case-insensitively. E.g. \'nextest\'.']
  "note" text [note: 'Optional human note on why this preference exists.']
  "updated_at" timestamptz [not null, default: `now()`, note: 'When the preference was last set.']

  Note: '''Capability → preferred-tool bias for the command surface (the get_commands MCP
tool + the workspace-window action buttons). When a workspace exposes several
commands of the same canonical category — e.g. two `test` commands, `cargo test`
and `cargo nextest` — the preference marks/ranks the one to prefer. `scope` is
`user` today (the local developer's own choice); when a Dōjō exists it will also
carry org / team / dojo scopes that override the user default (the same
specificity ladder as governance). One row per (scope, capability).'''
}

Table "sensei"."extensions" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "plugin_id" uuid [note: 'Self-referencing FK: null = standalone, set = belongs to a plugin extension.']
  "kind" sensei.extension_kind [not null, note: 'Extension type: plugin (container), skill, command, agent, or hook.']
  "name" text [not null, unique, note: 'Unique identifier (e.g. "zero-errors-policy", "sensei:build").']
  "version" text [note: 'Semantic version string.']
  "description" text [note: 'Triggering conditions or purpose description (starts with "Use when..." for skills).']
  "content" text [note: 'Markdown body — the actual skill protocol, command instructions, or agent definition.']
  "props" jsonb [not null, default: '{}', note: 'Parsed frontmatter + config: {triggers, inputs, tool_access, hook_event, ...}.']
  "scope" sensei.extension_scope [not null, default: 'global', note: 'Visibility: global (all workspaces), workspace (one workspace), folder (one repository).']
  "enabled" boolean [not null, default: true, note: 'Whether this extension is currently active.']
  "source" sensei.extension_source [not null, default: 'local', note: 'Origin: builtin (ships with sensei), marketplace (installed from registry), local (user-created).']
  "icons" jsonb [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "revision" int [not null, default: 0]
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']
  "modified_by" text

  indexes {
    plugin_id [name: 'extensions_plugin_id_idx']
    kind [name: 'extensions_kind_idx']
    tags [type: gin, name: 'extensions_tags_idx']
  }

  Note: '''Skills, commands, agents, hooks, and plugins.
Plugins are containers — other extensions reference them via plugin_id (self-ref).
- content: markdown body — the actual skill/command text, editable and round-trippable to .md files
- props: parsed frontmatter + additional config (triggers, inputs, tool_access, etc.)
- scope: global (all workspaces), workspace (specific workspace), folder (specific repository)
- source: builtin (ships with sensei), marketplace (installed), local (user-created)
- plugin_id: null = standalone extension; set = belongs to a plugin'''
}

Table "sensei"."folders_to_watch" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "path" text [not null, unique, note: 'Absolute filesystem path to the watched root directory.']
  "name" text [not null, note: 'Display name for the root (e.g. "Developer", "Work Workspaces").']
  "note" text [note: 'Optional user note about this root (e.g. "monorepo root, 3 packages").']
  "status" sensei.watch_status [not null, default: 'scanning', note: 'Lifecycle: scanning (initial scan in progress), watching (watchers active), paused (content retained, watchers stopped).']
  "excluded" jsonb [not null, default: '[]', note: 'JSON array of relative folder names/paths excluded from scanning, e.g. ["node_modules","dist",".git"].']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''Configuration: directories the user has pointed sensei at.
Initial status is scanning; transitions to watching after first scan completes.
Exclusions are user configuration — adding an entry deletes matching folders + children;
removing an entry triggers a re-scan of that subtree.'''
}

Table "sensei"."intake_guide" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "kind" text [not null]
  "axis" text
  "prompt" text [not null]
  "help" text
  "enabled" boolean [not null, default: true]
  "source" text [not null, default: 'builtin']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`, note: 'Bumped whenever the row changes. The staging import guards on it: a re-import only overwrites a row when the DATAFILE\'s stamp is at least as new, so an edit made in place survives redeployment. Without this column the import had nothing to compare and fell back to clobbering (playbooks) or to never updating at all (intake_guide, playbook_rules) — see docs/backlog.md.']
  "scope" sensei.entity_scope [not null, default: 'local', note: 'Shared vocabulary (see sensei.entity_scope / sensei.entity_origin). scope answers WHO MAY SEE IT and therefore whether it syncs; origin answers WHERE IT CAME FROM and therefore what a re-import may safely replace.']
  "origin" sensei.entity_origin [not null, default: 'builtin']

  indexes {
    (kind, axis) [unique, name: 'intake_guide_kind_axis_unique', note: 'nulls not distinct']
  }

  checks {
    `kind IN ('frame', 'axis')` [name: 'intake_guide_kind_chk']
    `(kind = 'axis') = (axis IS NOT NULL)` [name: 'intake_guide_axis_chk']
    `source IN ('builtin', 'org', 'learned')` [name: 'intake_guide_source_chk']
  }
}

Table "sensei"."libraries" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "kind" sensei.library_kind [not null, default: 'detected', note: 'Library classification: detected (from package manifests) or imported (manually registered).']
  "name" text [not null, note: 'Package name within the ecosystem (e.g. "react", "tokio", "@lumen/icons").']
  "ecosystem" sensei.library_ecosystem [not null, note: 'Package registry: npm, pypi, cargo, go, or docs (pure documentation source).']
  "description" text [note: 'Human-readable description of the library.']
  "repository_url" text [note: 'Where the library\'s source lives, taken from the registry\'s own record (npm repository.url, crates.io crate.repository, pypi project_urls Source). Unwrapped of packaging — a leading git+ and a trailing .git are removed — but never rewritten: an ssh:// remote stays ssh://. NULL means the registry stated none; it is never derived from the package name. Identity-level, so it sits here rather than on library_versions, which carries where a given release\'s docs were fetched from.']
  "homepage_url" text [note: 'URL of the library homepage or repository.']
  "embedding" vector(384) [note: '384-dimensional vector embedding on description for similarity search.']
  "icons" jsonb [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "props" jsonb [not null, default: '{}', note: 'Extensible metadata: {llms_txt, llms_txt_fetched_at, skill_path, skill_generated_at, ...}.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "indexed_at" timestamptz [note: 'Timestamp of the last successful index run for this library.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    (ecosystem, name) [unique, note: 'unique constraint']
    kind [name: 'libraries_kind_idx']
    embedding [type: hnsw, name: 'libraries_embedding_hnsw', note: 'where: embedding IS NOT NULL\nopclass: vector_cosine_ops\nwith: ef_construction = 64, m = 16']
    tags [type: gin, name: 'libraries_tags_idx']
  }

  Note: '''Libraries — the IDENTITY of a known package or documentation source.
S7b moved every VERSION-SCOPED fact to library_versions: source_type, base_url,
docs_url, local_path, page_count and version itself. A website documents one
version, so its docs URL is wrong for an older pin; a repo homepage is not, so
homepage_url stays here.
Consolidates the former libraries, lib_meta, and shared_libs tables.
- kind: detected (from Cargo.toml, package.json) or imported (manual, internal SDKs, llms.txt)
- ecosystem: npm, pypi, cargo, go, or docs (for pure documentation sources)
- source_type: how pages are fetched — llms.txt, http, or local
- page_count: denormalized count of library_content rows of kind 'page'
- props: extensible — {llms_txt, llms_txt_fetched_at, skill_path, skill_generated_at, ...}
- embedding: 384-dim vector on description for similarity search'''
}

Table "sensei"."metrics" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "key" text [not null, unique, note: 'Stable slug used by code and views (e.g. \'ftr\', \'rework_ratio\'). Unique.']
  "name" text [not null, note: 'Human-readable display name.']
  "description" text [not null, note: 'Short description of the metric.']
  "family" sensei.metric_family [not null, note: 'Metric family — the UI groups/colours from this, never a hardcoded name.']
  "type" sensei.metric_type [not null, note: 'Value type — drives how roll-ups aggregate (ratio/pct re-derive, count/currency sum, value/score take period end).']
  "unit" text [note: 'Display unit (\'%\', \'tokens\', \'$\'); null for pure ratios.']
  "direction" sensei.metric_direction [not null, note: 'Which way is better — used to normalize the value in the health score.']
  "purpose" text [not null, note: 'What the metric tells you.']
  "how_to_read" text [not null, note: 'How to interpret it, including its companion metric and the gotcha that makes it lie if read alone.']
  "formula" text [not null, note: 'Human-readable computation.']
  "task_name" text [not null, note: 'Maps to the compiled TaskKind that computes this metric. Indexed (metrics_task_idx) for the scheduler\'s distinct-active-task_name read.']
  "cadence" sensei.metric_cadence [not null, default: 'day', note: 'How the metric\'s group advances against its watermark: commit (immutable, new commits only) vs day (calendar-day, reopens the trailing day). Groups are (repository, task_name, cadence) so a mixed-cadence task like churn splits (churn-rate/concentration=commit, rework_density=day).']
  "capture_source" sensei.metric_capture [not null, default: 'snapshot', note: 'Whether this metric AUTHORIZES the activity-pruner to reclaim a day\'s raw sessions (invariant I20). session = session_outcomes/autonomy (authorizes); git = churn/quality; snapshot = knowledge/tool/health + rework_density (never authorize). Defaults to snapshot (fail-closed: a new metric never wrongly authorizes reclaim).']
  "weight" numeric [not null, default: 1, note: 'Contribution to the composite health score.']
  "target" numeric [note: 'Normalization bound for counts/durations in the health score; null excludes the metric from the score.']
  "rating_scale" jsonb
  "derives_from" text[] [note: 'Metric keys whose relationship to this metric is definitional or mechanical rather than informative — the suppression list for correlation analysis, so a ranking is not topped by arithmetic. See docs/database/sensei.md.']
  "effective_from" date [not null, default: `current_date`, note: 'First day the metric is active (inclusive). Defaults to current_date.']
  "effective_until" date [note: 'Last-active boundary (exclusive). Null = active; a past date = retired.']
  "retire_reason" text [note: 'Why the metric was retired (set alongside a past effective_until).']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    task_name [name: 'metrics_task_idx']
  }

  Note: '''Metric registry — the data-driven catalog of what to compute, how to describe it,
and which scheduled task produces it. Seeded from features/metrics/catalog.md via the
staging + import procedure pattern (only rows whose task_name handler exists).

A metric is ACTIVE on a day when day is in [effective_from, coalesce(effective_until,
'infinity')). Retirement = a past effective_until; retire_reason records why. A
genuinely new computation still needs a compiled TaskKind + handler (task_name maps to
a variant — no string dispatch), so a blocked metric is not seeded until its handler
ships. Values live in sensei.workspace_metrics; all roll-ups and the health score are
views over that one store.'''
}

Table "sensei"."narration_cache" {
  "kind" text [pk, not null, note: 'Stable snake_case insight key (e.g. tool_dormant) — InsightKind::as_str.']
  "facts_hash" text [pk, not null, note: 'sha256(kind + canonical_json(facts)); any facts change makes a new key.']
  "title" text [not null, note: 'Model-generated card title (validated against the char + voice limits).']
  "detail" text [not null, note: 'Model-generated card detail (validated against the char + voice limits).']
  "model_provider" text [note: 'Provider/router that produced the copy (e.g. ollama), NULL when unknown.']
  "model_id" text [note: 'Model id that produced the copy (e.g. gemma4), NULL when unknown.']
  "generated_at" timestamptz [not null, default: `now()`, note: 'When this copy was generated (reset on regeneration).']
  "last_used_at" timestamptz [not null, default: `now()`, note: 'Bumped to now() on every cache read; drives the 30-day eviction sweep.']

  indexes {
    last_used_at [name: 'narration_cache_last_used_idx']
  }

  Note: '''Persisted mentor-voice insight copy produced by the narration-cache pipeline.
Keyed on (kind, facts_hash) so identical facts reuse the same generated copy;
the static per-call-site fallback template is used only on cold start,
timeout, or model failure. Rows evict after 30 days of no use.'''
}

Table "sensei"."personas" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "label" text [not null, note: 'Display name, unique case-insensitively. PROVISIONAL until verified_at is set — before a sign-in it can only be inferred from a git email or repo owner, and such inferences are wrong (sensei-hq vs the real sensei-hq-org). NOT a category of repo — one persona spans many owners.\n\nDISPLAY name. Provisional until the persona is connected: before OAuth it can only be a guess derived from a git email or a repository owner, and guesses are wrong — `sensei-hq` was inferred from an email domain when the real GitHub login is `sensei-hq-org`.']
  "github_login" text [note: 'The GitHub login, proven by OAuth. NULL until the persona is connected — an unproven identity should look unproven rather than merely unlabelled.']
  "github_user_id" bigint [note: 'GitHub\'s stable numeric id. Matched on in preference to the login, which the user can rename.\n\nThe stable GitHub id. A login can be RENAMED — the id cannot — so this, not the login, is what an identity is matched on across time.']
  "verified_at" timestamptz [note: 'When OAuth last confirmed this identity. NULL = discovered from git only.']
  "is_self" boolean [not null, default: true, note: 'FALSE when this persona is another contributor, not the local user — so their commits are never counted as "mine".\n\nFALSE for a contributor who is NOT the local user. `contributor@example.com` above may well be someone else; folding it into the user\'s own numbers would be a fabricated attribution, so an unrecognised email gets its own persona with is_self = false rather than a guess.']
  "principal_id" uuid [note: 'The dōjō login this persona pushes under (dojo.principals.id). Plain uuid — the referent is in another database. NULL until linked.\n\nThe dōjō login this persona pushes under. Plain uuid, no FK: the referent lives in another database, exactly as `sensei.repositories.tenant_id` does. NULL until the user links this persona (Phase 6).']
  "session_slot" text [note: 'The Keychain slot holding this persona\'s dōjō session (session.rs::account_for formats refresh_token.<slot>). NOT the label: a successful sign-in rewrites label to the verified GitHub login, so signing in as "default" yields a row labelled "sensei-hq-org" whose session is still at refresh_token.default. Looking the session up by label finds nothing and silently skips the persona. NULL = never signed in from this machine.\n\nThe KEYCHAIN SLOT this persona\'s dōjō session is stored under, as chosen by whoever started the sign-in (`/api/auth/signin?persona=X`).\n\nDistinct from `label`, and that distinction is the whole reason the column exists. `label` is a DISPLAY name that a successful sign-in REWRITES to the verified GitHub login — a user who signs in as `default` ends up with a row labelled `sensei-hq-org`. An unattended task that looked up the session by `label` would read `refresh_token.sensei-hq-org`, find nothing, and skip the persona while reporting the cycle successful. Observed, not theorised.']
  "forge_token_state" sensei.forge_token_state [not null, default: 'unknown', note: 'What we believe about this persona\'s FORGE (GitHub) token — a different credential from the dōjō session, with a different lifetime. The session refreshes on every use; the GitHub token expires on a measured ~8h cycle. `unknown` is the default and a REAL state: a persona nothing has asked GitHub about has no standing, and defaulting to `active` would claim a credential never tested.']
  "forge_token_expires_at" timestamptz [note: 'When the forge token stops working, as the forge states it. NULL = not yet known, never "does not expire" — GoTrue\'s exchange does not report the provider\'s deadline, so it can only come from GitHub\'s `github-authentication-token-expiration` response header.\n\nWhen the token stops working, as the FORGE states it. Null when no expiry has ever been learned — GoTrue\'s exchange does not report the provider\'s deadline, so it can only come from GitHub\'s own `github-authentication-token-expiration` response header. Null therefore means "not yet known", never "does not expire".']
  "forge_token_checked_at" timestamptz [note: 'When anything was last learned about the forge token. Deliberately NOT stamped when a probe could not reach the forge: recording a check that told us nothing would make a stale belief look fresh.']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    `lower(label)` [unique, name: 'personas_label_unique']
    github_user_id [unique, name: 'personas_github_user_unique', note: 'where: github_user_id IS NOT NULL']
    principal_id [unique, name: 'personas_principal_unique', note: 'where: principal_id IS NOT NULL']
    session_slot [unique, name: 'personas_session_slot_unique', note: 'where: session_slot IS NOT NULL']
  }

  Note: '''A working identity kept separate from the user's others — business vs personal
vs employer. Local-only: personas group git author emails so metrics can be read
per identity, and each may link to at most one dōjō login.

Not a "people" table. One human may own several personas by choice, and a
persona may belong to someone else entirely (is_self = false).'''
}

Table "sensei"."playbooks" {
  "name" text [pk, not null]
  "title" text [not null]
  "when_to_use" text [not null]
  "opening_tone" text [not null]
  "method_ref" text
  "enabled" boolean [not null, default: true]
  "source" sensei.source_kind [not null, default: 'builtin', note: '`source_kind`, not text+CHECK: the same three values were duplicated as a separate constraint on sensei.playbooks. See ddl/enum/sensei/source_kind.ddl.']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`, note: 'Bumped whenever the row changes. The staging import guards on it: a re-import only overwrites a row when the DATAFILE\'s stamp is at least as new, so an edit made in place survives redeployment. Without this column the import had nothing to compare and fell back to clobbering (playbooks) or to never updating at all (intake_guide, playbook_rules) — see docs/backlog.md.']
  "scope" sensei.entity_scope [not null, default: 'local', note: 'Shared vocabulary (see sensei.entity_scope / sensei.entity_origin). scope answers WHO MAY SEE IT and therefore whether it syncs; origin answers WHERE IT CAME FROM and therefore what a re-import may safely replace.']
  "origin" sensei.entity_origin [not null, default: 'builtin']
}

Table "sensei"."reason_codes" {
  "domain" text [pk, not null, note: 'The subsystem whose vocabulary this belongs to (repository_sharing, schedule, metric_push, …). Scopes `precedence`, which is meaningless across domains.\n\nWhich subsystem\'s vocabulary. Scoping by domain is what keeps `precedence` meaningful: "fix the subscription before the election" is a real ordering, "fix the subscription before the schedule window" is not.']
  "code" text [pk, not null]
  "kind" sensei.reason_kind [not null, note: 'normal | refusal | fault. The axis is "does this clear itself without a human?", not "did anyone decide?".']
  "precedence" smallint [not null, note: 'Lower = fix first, WITHIN a domain. A thing failing several ways reports the lowest; without this the answer depends on SQL branch order.\n\nLower = fix this FIRST, ordered within a domain. A thing can fail several ways at once; without an explicit order the answer depends on which SQL branch happened to run first, which is the accidental behaviour this registry exists to remove. Unique per domain so an accidental overlap fails loudly rather than silently picking one.']
  "summary" text [not null]
  "detail" text [not null]
  "remedy" text [note: 'What the reader can do about it. NULL when nobody can — and always NULL for a `normal` code, which the CHECK enforces.']
  "actor" sensei.reason_actor [note: 'Who the remedy addresses. NULL when nobody can act.']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`]

  indexes {
    (domain, precedence) [unique, note: 'unique constraint']
  }

  checks {
    `kind <> 'normal' OR (remedy IS NULL AND actor IS NULL)` [name: 'reason_codes_normal_is_silent']
  }

  Note: '''Human-readable reasons, keyed (domain, code). REPORTING ONLY — the domain
decides which code applies; this says what it means and who can act.

Delete every row and behaviour must be identical, losing only the prose. That is
the test for whether logic has leaked in.

Seeded from database/import/staging/reason_codes.jsonl.'''
}

Table "sensei"."repositories" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "repo_key" text [unique, note: 'Normalized remote identity (host/org/repo, lowercased). Unique. NULL = local-only (no remote) — never federated; multiple NULLs coexist.']
  "remote_url" text [note: 'A representative raw remote URL for display / re-derivation; repo_key is the identity.']
  "name" text [not null, note: 'Display name — typically the repository basename.']
  "tenant_id" uuid [note: 'The dojo.tenants.id this repository is enrolled with when federated. NULL = not federated. Distinct from workspaces.dojo_id, which holds a MEMBERSHIP id — the ambiguity that forced this rename.\n\nThe dōjō TENANT this repository is enrolled with. Named `dojo_id` until the sync slice needed to store one: `workspaces.dojo_id` holds a MEMBERSHIP id, so one name meant two things and the plan consumer could not say which it had. Plain uuid, no FK — the referent lives in another database.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the repository was first registered.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']
  "visibility" sensei.repo_visibility [not null, default: 'private', note: 'Whether this repository participates in sync. Private by default: sync is gated on authentication, but signing in should not silently start sharing a repo the user never chose to share.']
  "synced_at" timestamptz

  Note: '''Canonical global repository registry — the metric grain. Identified by repo_key
(the normalized remote: git@host:Org/Repo.git and https://host/Org/Repo both →
host/org/repo; scheme/creds/port/.git stripped, host lowercased). One row per real
repository regardless of how many times or where it is checked out. A UNIQUE repo_key
that is NULL means a local-only repo with no remote — never federated, and multiple
such rows coexist (nulls distinct).

NO OWNING WORKSPACE, and that is about CHECKOUTS rather than ownership: one canonical
repository can be checked out twice and each checkout belong to a different workspace.
Measured 2026-09-30, 4 repositories do — `kavach` serves `kavach` and
`vite-multi-adapter`, `bridge` serves `bridge` and `sparsh` — so a workspace_id on
this table would collapse them.

The workspace is owned by the repo-ANCHOR FOLDER (the checkout); every folder beneath
derives from it. One authoritative row per checkout, not per folder. That supersedes
the folder-grain junction described in D1/D2/D10 — see the header for why.'''
}

Table "sensei"."schedules" {
  "name" text [pk, not null, note: 'The worker this schedules. Must match a tasks::schedule::SCHEDULABLE entry.']
  "enabled" boolean [not null, default: true, note: 'False = never run on a schedule. On-demand paths (an API enqueue) are unaffected: disabling a SCHEDULE must not disable a CAPABILITY.']
  "interval_secs" int [not null, note: 'How often, in seconds. CHECK > 0 — a zero interval would busy-loop.']
  "window_start" time [note: 'Start of the allowed time-of-day window (local time). NULL with window_end = any time. A window whose start is AFTER its end wraps midnight: 22:00-05:00 means overnight, not an empty range.']
  "window_end" time [note: 'End of the allowed window (local time), inclusive. NULL with window_start = any time.']
  "days" smallint[] [note: 'ISO weekdays the worker may run on (1=Mon..7=Sun). NULL = every day — an unset mask must never mean "never".']
  "last_run_at" timestamptz [note: 'When the worker last completed a scheduled pass. NULL = never run, which is always due (a freshly seeded schedule runs on its first tick).']
  "last_ok" boolean [note: 'Outcome of that last pass. NULL until one has run — never a fabricated success.']
  "last_error" text [note: 'Why the last pass failed, when it did. Cleared on success, so a stale error never sits beside a healthy run.']
  "runs" int [not null, default: 0, note: 'Passes timed since durations were recorded (#96). With total_ms gives the average; passes before that are not counted, so no average is invented for them.']
  "total_ms" bigint [not null, default: 0, note: 'Summed wall-clock duration of the timed passes, in milliseconds (#96).']
  "running_since" timestamptz [note: 'When the pass now in progress started (#283); NULL when idle. Set as a pass starts, cleared as it ends and at daemon start, so a pass blocked for an hour reads as running for an hour rather than as an hour-old result.']
  "created_at" timestamptz [not null, default: `now()`]
  "modified_at" timestamptz [not null, default: `now()`]

  checks {
    `interval_secs > 0`
    `days IS NULL OR (array_length(days, 1) BETWEEN 1 AND 7 AND days <@ ARRAY[1, 2, 3, 4, 5, 6, 7]::smallint[])`
  }

  Note: '''When each background worker runs. One row per schedulable task; the legal names
live in code (tasks::schedule::SCHEDULABLE) and a test asserts code and table
agree, so a worker added without a row — or a row naming no worker — fails the
build rather than silently never running.

Seeded from database/import/staging/schedules.jsonl. The import guards on
modified_at, so a user edit is never clobbered by a re-deploy.'''
}

Table "sensei"."scopes" {
  "key" text [pk, not null, note: 'Stable identifier: general, user, organization (the dōjō), workspace, repository (#318 R6: the ladder is dōjō → workspace → repository; a stack is a pack applied at a level, not a level).']
  "name" text [not null, note: 'Human-readable label.']
  "level" int [not null, note: 'Precedence rank. Higher = more specific = wins. general=0 … repository=70.']
  "shareable" boolean [not null, default: false, note: 'Whether knowledge at this scope federates to a shared DÅjÅ (organization = true).']
  "description" text [note: 'What this scope is for.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''The governance scope ladder. Each row is one level at which rules/knowledge
and identity can apply. Precedence is the integer `level` — higher = more
specific = wins on conflict (most-specific-scope-wins), with enforcement as a
separate override axis (see governance concept doc). A repo is a member of a
SET of namespaces across these scopes (no single-parent tree); resolution
orders by level. Seeded via staging.import_scopes().'''
}

Table "sensei"."services" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" text [not null, unique, note: 'Unique identifier for the service (e.g. "postgres-mcp").']
  "display_name" text [not null, note: 'Human-readable name (e.g. "PostgreSQL MCP").']
  "publisher" text [note: 'Who publishes this service (e.g. "supabase", "stripe").']
  "protocol" sensei.service_protocol [not null, default: 'mcp', note: 'Communication protocol: mcp (tools via http/stdio), ollama (local inference), anthropic/openai (external LLM providers).']
  "kind" sensei.service_kind [not null, note: 'Service category: data (databases), api (external APIs), devtool (dev tools), service (monitoring etc.), inference (local/external LLM providers).']
  "summary" text [note: 'Short description of what this service provides.']
  "trigger_stacks" text[] [not null, default: '{}', note: 'Stack names that trigger recommendation of this service (e.g. ["PostgreSQL","Redis"]).']
  "tools_count" int [not null, default: 0, note: 'Number of tools exposed by this service.']
  "verified" boolean [not null, default: false, note: 'Whether the service is verified/official.']
  "installed" boolean [not null, default: false, note: 'Whether the service is currently installed and configured.']
  "config" jsonb [not null, default: '{}', note: 'Connection config: MCP: {transport, command, args, url, env}. Ollama: {url, models, default_model}. External: {api_key_env, default_model}.']
  "icons" jsonb [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    kind [name: 'services_kind_idx']
    installed [name: 'services_installed_idx', note: 'where: installed = true']
    tags [type: gin, name: 'services_tags_idx']
  }

  Note: '''External service registry for MCP servers and inference providers.
- kind: data (databases), api (stripe, github), devtool (playwright, figma), service (sentry, etc.), inference (Ollama, external LLM providers)
- protocol: mcp (tools via http/stdio), ollama (local inference), anthropic/openai (external inference)
- trigger_stacks: which detected stacks recommend this service (e.g. ["PostgreSQL"])
- config: connection config, env vars, transport settings, model preferences'''
}

Table "sensei"."symbol_names" {
  "name" text [pk, not null, note: 'The symbol name (matches sensei.nodes.name). Primary key — global, deduped.']
  "first_seen" timestamptz [not null, default: `now()`, note: 'When this name was first recorded as an indexed symbol.']
  "last_seen" timestamptz [not null, default: `now()`, note: 'When this name was last seen as a current indexed symbol (updated each scan).']

  Note: '''Global registry of every code-symbol name ever indexed. The doc-drift scan
(scan_workspace_doc_drift) uses it as the "was ever a real symbol" gate: a doc
mention is flagged broken only when the name IS in this registry (it was a real
symbol at some point) but no longer resolves to a current sensei.nodes row
(removed / renamed). Identifiers that were NEVER symbols — Rust enum variants,
serde-renamed camelCase API fields, string-dispatched MCP tool names — are prose
or config, not drift, so their absence from the graph is not flagged (this
killed the ~408 false-positive drift rows). Populated each drift scan by
record_symbol_names (a monotonic upsert of the current symbol names); never
pruned, so a removed symbol stays known and its stale doc references surface as
real drift.'''
}

Table "sensei"."sync_state" {
  "entity" sensei.sync_entity [pk, not null]
  "entity_key" text [pk, not null, note: 'The entity\'s DURABLE key, not a local uuid: repo_key for a repository, metric key for the catalogue. A local uuid differs between installs, so a sync row keyed on one could never be reconciled against the other side.']
  "direction" sensei.sync_direction [pk, not null]
  "local_version" bigint
  "remote_version" bigint
  "state" text [not null, default: 'pending', note: 'pending → not yet reconciled; synced → both sides agree; partial → they agree except what last_error names (a file over the request cap), synced_at set; error → last attempt failed (see last_error); skipped → deliberately not synced (private repo, deactivated metric).']
  "last_error" text [note: 'Kept, not cleared on the next attempt: a sync that fails, retries and fails differently is a different problem, and overwriting loses the first cause.']
  "attempted_at" timestamptz
  "synced_at" timestamptz
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (entity, direction) [name: 'sync_state_pending_idx', note: 'where: state <> \'synced\'']
  }

  checks {
    `state IN ('pending', 'synced', 'partial', 'error', 'skipped')`
  }

  Note: '''One row per (entity, key, direction) describing where that thing stands with
dōjō. Upserted, never appended — the table stays the size of the shared surface
instead of growing with every sync run.

`entity_key` is the durable cross-install key (repo_key, metric key), never a
local uuid: uuids differ per machine, so a row keyed on one could not be
reconciled against the other side.'''
}

Table "sensei"."tags" {
  "tag" text [pk, not null, note: 'Tag text value — the controlled vocabulary entry.']
  "category" text [note: 'Optional category for grouping tags (e.g. "stack", "domain", "status").']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp when this tag was first created.']

  Note: '''Controlled vocabulary for tags used across the system.
Tables that need tags carry a tags text[] column for quick access.
This table provides autocomplete and validation.
- category: optional grouping (e.g. "stack", "domain", "status")'''
}

Table "sensei"."tool_call_verdicts" {
  "id" bigserial [pk, not null]
  "session_id" text [not null]
  "event_id" bigint [not null, unique]
  "tool_name" text
  "verdict" text [not null]
  "confidence" real [not null, default: 1.0]
  "reason" text
  "classified_at" timestamptz [not null, default: `now()`]

  indexes {
    session_id [name: 'tool_call_verdicts_session_idx']
    event_id [name: 'tool_call_verdicts_event_idx']
    verdict [name: 'tool_call_verdicts_verdict_idx']
  }

  checks {
    `verdict IN ('used', 'partial', 'ignored', 'unknown')`
  }

  Note: '''#90 Per-tool-call usage verdict (used / partial / ignored). Classified from
the (PostToolUse, next-event) pair on the same session. Rebuildable at any
time — the classifier is idempotent, so re-running against a new heuristic
just refreshes the table. Read-time joined by the Replay tab (#84).'''
}

Table "sensei"."tool_insights" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "tool_name" text [not null, note: 'Tool being insighted — matches assistant_events.tool_name.']
  "computed_at" timestamptz [not null, default: `now()`, note: 'When this snapshot was written.']
  "metrics" jsonb [not null, default: '{}', note: 'Raw aggregates: call_count, error_count, avg_duration_ms, last_used_at, error_rate.']
  "signal_variant" text [note: 'Signal card variant (warn / opportunity / unused / win) or NULL when no signal fires.']
  "signal_title" text [note: 'Card title copy (matches derive_signals output).']
  "signal_detail" text [note: 'Card detail copy (matches derive_signals output).']

  indexes {
    (tool_name, computed_at) [name: 'tool_insights_tool_time_idx', note: 'order: asc, desc']
    computed_at [name: 'tool_insights_time_idx', note: 'order: desc']
  }

  Note: '''Cached per-tool insight snapshots produced by the AggregateToolInsights
scheduled task. Append-only — each run writes a fresh row per known tool.
The observatory tool-signals endpoint picks the latest row per tool
(via a distinct-on / row_number window) and returns them ordered by
variant priority. Cache-miss (no rows yet) falls back to the on-the-fly
derivation.'''
}

Table "sensei"."tracker_secret_tombstones" {
  "secret_service" text [pk, not null, note: 'The keyring service to delete.']
  "account" text [not null, note: 'The keyring account of that entry.']
  "not_before" timestamptz [not null, note: 'Do not drain before this time. now() for an orphaned secret; now() + grace for a connect still in progress.']
  "created_at" timestamptz [not null, default: `now()`, note: 'When the tombstone was written.']

  indexes {
    not_before [name: 'tracker_secret_tombstones_not_before_idx']
  }

  Note: 'Keyring entries pending deletion. Written by the tracker_secret_tombstone trigger for the OLD secret of a deleted or re-keyed tracker (due now), and by connect for the NEW secret before it is written (due after a grace period, deleted when the connect commits). Drained by the tracker_sync tick.'
}

Table "sensei"."workflow_state" {
  "workspace" text [pk, not null, note: 'Workspace identifier.']
  "active_phase" text [note: 'Current phase name.']
  "active_plan" text [note: 'Current plan or goal.']
  "active_task" text [note: 'Current task description.']
  "active_issue" int [note: 'Current issue number being addressed.']
  "last_checkpoint" text [note: 'Timestamp of last checkpoint command.']
  "rules_hash" text [note: 'Hash of active rules for this workspace.']
  "updated_at" timestamptz [not null, default: `now()`, note: 'Timestamp of last update.']

  Note: '''Workflow state — current phase/task/issue per workspace.
Updated by checkpoint and phase commands.'''
}

Table "sensei"."workspaces" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" text [not null, note: 'Workspace display name — initially derived from parent folder name or git remote.']
  "root_abs_path" text [note: 'The workspace\'s collection root on disk — the shallowest member repo\'s abs_path (spec\n2026-08-18). Lets a workspace own a repo-collection boundary (e.g. ~/Work/client-a spanning\nmany repos) and drive grouping. Single-repo workspaces: the repo\'s abs_path.']
  "description" text [note: 'Optional workspace description.']
  "client" text [note: 'Optional client or owner name.']
  "maturity" sensei.workspace_maturity [not null, default: 'discovery', note: 'Lifecycle stage: discovery (just scanned), active (in development), maintenance, or archived.']
  "goal" text [note: 'What this workspace is for — populated from README, sensei.json, or user input.']
  "icon" jsonb [not null, default: '{}', note: 'Display icon: {kind:"kanji"|"emoji"|"custom", value:"工", bg:"color", fg:"color"}.']
  "stack" jsonb [not null, default: '{}', note: 'Detected technology stack: {languages:[], frameworks:[], runtimes:[], services:[]}. Derived from member folders.']
  "commands" jsonb [not null, default: '{}', note: 'JSON object of common commands: {dev, test, build, lint, ...}. Derived from config files.']
  "links" jsonb [not null, default: '[]', note: 'External references: [{id, kind, label, url}]. Kinds: docs, dashboard, issues, runbook, design, wiki.']
  "guidelines" jsonb [not null, default: '[]', note: 'Workspace rules: [{id, rule, source}]. Source can be "house-style", a session id, or "manual".']
  "preferred_acp" text [note: 'Default AI coding tool for sessions in this workspace: claude-code, cursor, zed, etc.']
  "backlog" jsonb [not null, default: '[]', note: 'Task backlog items: [{id, task, added}]. Surfaced in workspace settings.']
  "privacy" jsonb [not null, default: '{}', note: 'Per-workspace privacy settings: {logPrompts:bool, logFileContents:bool, redactSecrets:bool, shareWithCloud:bool}. Defaults to empty = inherit global config.']
  "excluded_globs" jsonb [not null, default: '[]', note: 'Glob patterns to exclude from indexing for this workspace: ["dist/**", "*.generated.*"]. Layered on top of folders_to_watch.excluded.']
  "tags" text[] [not null, default: '{}', note: 'Array of tag strings for quick filtering. Vocabulary controlled by sensei.tags table.']
  "dojo_id" uuid [note: 'Optional binding to the Dōjō membership this workspace routes findings to (dojo.memberships.id in the separate Dōjō service DB). Nullable — most workspaces have no Dōjō. Not a DB-level FK: dojo.* lives in another database (Fork 1). Client-membership bindings take precedence over employer ones.']
  "modified_at" timestamptz [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    maturity [name: 'workspaces_maturity_idx']
    tags [type: gin, name: 'workspaces_tags_idx']
    dojo_id [name: 'workspaces_dojo_id_idx']
  }

  Note: '''Workspaces — independent grouping entity for 1+ folders.
One workspace per git/subtree folder by default, but users can merge or split.
- maturity: discovery → active → maintenance → archived
- stack: {languages, frameworks, runtimes, services} — derived from member folders
- icon: {kind, value, bg, fg} — e.g. {kind:"kanji", value:"工", bg:"var(--shu-soft)", fg:"var(--shu)"}
- links: external references [{id, kind, label, url}] — docs, dashboards, issue trackers
- guidelines: workspace rules [{id, rule, source}]
- preferred_acp: default AI coding tool for this workspace (claude-code, cursor, etc.)
- backlog: task items [{id, task, added}]
- privacy: per-workspace privacy settings {logPrompts, logFileContents, redactSecrets, shareWithCloud}
- excluded_globs: file/folder patterns to exclude from indexing ["dist/**", "*.generated.*"]'''
}

