Table "activity"."assistant_events" {
  "id" bigserial [pk, not null, note: 'Surrogate primary key (bigserial — high write volume).']
  "session_id" TEXT [not null, default: '', note: 'Assistant session ID string. Not a FK — not a DB UUID.']
  "family" assistant_family [not null, default: 'claude', note: 'Which assistant emitted this event: claude, cursor, zed, codex, aider, etc.']
  "event_type" TEXT [not null, note: 'hook_event_name from payload: SessionStart, PreToolUse, PostToolUse, Stop, etc.']
  "tool_name" TEXT [note: 'tool_name from payload. Populated for PreToolUse and PostToolUse events only.']
  "cwd" TEXT [note: 'Working directory at the time of the event.']
  "ts" BIGINT [not null, note: 'Unix epoch milliseconds when the event fired (client clock).']
  "success" BOOLEAN [note: 'For PostToolUse: true if exit_code == 0. Null for all other event types.']
  "payload" JSONB [not null, default: '{}', note: 'Full JSON payload received from stdin — complete event data.']
  "created_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Server-side timestamp when this row was inserted.']

  indexes {
    (session_id, created_at) [name: 'assistant_events_session_id_idx']
    (event_type, created_at) [name: 'assistant_events_event_type_idx']
    created_at [name: 'assistant_events_created_at_idx']
    (family, created_at) [name: 'assistant_events_family_idx']
  }

  Note: '''
Raw assistant event log — one row per hook/event invocation, from any
assistant family. Captures events emitted by Claude Code, Cursor, Zed, etc.
session_id is the assistant string session ID, not a DB UUID.
family identifies the source assistant (claude, cursor, zed, …).
payload stores the full JSON payload received from stdin.
'''
}

Table "activity"."task_executions" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`]
  "task_id" BIGINT [not null, note: 'In-memory queue task ID. Unique per daemon session (resets on restart).']
  "parent_task_id" BIGINT [note: 'Parent task ID for hierarchy. process_file → process_git_folder → scan_root.']
  "task_kind" TEXT [not null, note: 'TaskKind::to_string() — scan_root, process_file, resolve_edges, etc.']
  "folder_path" TEXT [not null, default: '', note: 'Git folder abs path — groups all tasks for a repo.']
  "path" TEXT [not null, default: '', note: 'Specific path this task operates on (file, folder, URL).']
  "status" TEXT [not null, default: 'running', note: 'running, completed, or failed.']
  "items_processed" INTEGER [note: 'Count of items handled: symbols parsed, edges resolved, files queued, etc.']
  "duration_ms" INTEGER [note: 'Wall-clock milliseconds from start to completion.']
  "retry_number" INTEGER [not null, default: 0, note: '0 for first attempt. Incremented if the same task is retried.']
  "error_message" TEXT [note: 'Error detail if status = failed.']
  "started_at" TIMESTAMPTZ [not null, default: `now()`]
  "completed_at" TIMESTAMPTZ

  indexes {
    task_kind [name: 'task_executions_task_kind_idx']
    folder_path [name: 'task_executions_folder_path_idx']
    parent_task_id [name: 'task_executions_parent_task_id_idx']
    started_at [name: 'task_executions_started_at_idx']
    status [name: 'task_executions_status_idx']
  }

  Note: '''
Task execution history — one row per task run. Forms a tree via parent_task_id.

status: running → completed | failed
retry_number: 0 for first attempt, incremented on retry.
duration_ms and items_processed set on completion.
started_at vs completed_at shows wall-clock execution time.

Common queries:
  -- Execution tree for a scan
  WITH RECURSIVE tree AS (
    SELECT * FROM task_executions WHERE task_id = $1
    UNION ALL
    SELECT e.* FROM task_executions e JOIN tree t ON e.parent_task_id = t.task_id
  ) SELECT * FROM tree ORDER BY started_at
  -- Slowest tasks
  SELECT task_kind, avg(duration_ms), max(duration_ms) FROM task_executions WHERE status = 'completed' GROUP BY task_kind
  -- Failed tasks in last hour
  SELECT * FROM task_executions WHERE status = 'failed' AND started_at > now() - interval '1h'
'''
}

Table "activity"."transcript_cursor" {
  "source" TEXT [pk, not null]
  "file_path" TEXT [pk, not null]
  "session_id" TEXT
  "last_mtime_ns" BIGINT [not null]
  "turns_ingested" INTEGER [not null, default: 0]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Note: '''
Resumable cursor for transcript ingest (#73): per-file mtime so re-runs skip
unchanged transcripts. Shared by the backfill and forward-capture workers.
'''
}

Table "activity"."transcript_turns" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`]
  "source" TEXT [not null]
  "session_id" TEXT [not null]
  "family" TEXT
  "provider" TEXT
  "model" TEXT
  "turn_index" INTEGER [not null]
  "user_text" TEXT
  "assistant_text" TEXT
  "char_count" INTEGER [not null, default: 0]
  "started_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  indexes {
    session_id [name: 'transcript_turns_session_idx']
    (source, session_id) [name: 'transcript_turns_source_session_idx']
  }

  Note: '''
Per-turn assistant/user prose parsed from agent transcripts (#73). Backfills the
prose the hook stream lacks; consumed by the analyzer LLM tiers. Grain = one
user-prompt -> assistant-response turn. Identity = (source, session_id, turn_index).
'''
}

Table "gateway"."fallback_chains" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" TEXT [not null, unique, note: 'Unique chain name (e.g. "reasoning", "embed", "classify", "consensus-proposer").']
  "capability" model_capability [not null, note: 'Which capability this chain serves: chat, reasoning, embed, classify, summarize, vision, audio.']
  "description" TEXT [note: 'What this chain is for (e.g. "MOE proposer — strong reasoning models").']
  "role" inference_role [note: 'Sensei inference role this chain serves. Null for utility chains (e.g. consensus-*) that the gateway invokes by name for internal orchestration. Unique when set — one chain per role.']
  "max_fallback_attempts" INTEGER [not null, default: 3, note: 'Maximum number of models to attempt before failing.']
  "is_active" BOOLEAN [not null, default: true, note: 'Whether this chain is available for use.']
  "sequence" INTEGER [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    role [unique, name: 'fallback_chains_role_uidx']
  }

  Note: '''
Ordered model fallback sequences per capability.
When a model fails (timeout, rate limit, error), the gateway tries the next in sequence.
- capability: which model_capability this chain handles (chat, reasoning, embed, etc.)
- role: which sensei inference role this chain serves (nullable — utility chains
  like consensus-* stay null). Enforced unique when set, so a role points at
  exactly one chain and vice versa.
- max_fallback_attempts: how many models to try before giving up
Seed data loaded via staging.import_fallback_chains().
'''
}

Table "gateway"."providers" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" TEXT [not null, unique, note: 'Unique slug identifier (e.g. "anthropic", "meta", "google").']
  "display_name" TEXT [not null, note: 'Human-readable name (e.g. "Anthropic", "Meta").']
  "description" TEXT [note: 'Brief description of the provider.']
  "website_url" TEXT [note: 'Provider homepage URL.']
  "is_open_source" BOOLEAN [not null, default: false, note: 'Whether the provider primarily offers open-source models.']
  "is_active" BOOLEAN [not null, default: true, note: 'Whether models from this provider are available for selection.']
  "sequence" INTEGER [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''
AI model organizations — OpenAI, Anthropic, Meta, Google, Alibaba, etc.
Seed data loaded via staging.import_providers().
'''
}

Table "gateway"."routers" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" TEXT [not null, unique, note: 'Unique slug identifier (e.g. "ollama", "anthropic", "openai").']
  "display_name" TEXT [not null, note: 'Human-readable name (e.g. "Ollama (local)", "Anthropic").']
  "description" TEXT [note: 'Brief description of this router.']
  "router_type" router_type [not null, note: 'Router category: direct (single provider), aggregator (multi-provider), local (on-device).']
  "api_base_url" TEXT [note: 'Base URL for API calls (e.g. "http://localhost:11434", "https://api.anthropic.com").']
  "api_key_env_var" TEXT [note: 'Environment variable name containing the API key (e.g. "ANTHROPIC_API_KEY"). Null for local routers.']
  "authentication_type" auth_type [not null, default: 'api_key', note: 'How to authenticate: api_key (header-based) or none (local).']
  "default_headers" JSONB [not null, default: '{}', note: 'Default HTTP headers for requests to this router.']
  "rate_limits" JSONB [not null, default: '{}', note: 'Rate limits: {requests_per_minute, tokens_per_minute}.']
  "config" JSONB [not null, default: '{}', note: 'Connection config: {timeout_ms, retry_limit, retry_delay_ms, circuit_breaker_threshold, circuit_breaker_window_minutes}.']
  "is_active" BOOLEAN [not null, default: true, note: 'Whether this router is available for use.']
  "sequence" INTEGER [not null, default: 0, note: 'Display order — lower values shown first.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''
API access points for LLM gateway.
- direct: single-provider API (anthropic, openai)
- aggregator: multi-provider proxy (openrouter)
- local: on-device runtime (ollama)
- config: connection settings — {timeout_ms, retry_limit, retry_delay_ms, circuit_breaker_threshold, ...}
- rate_limits: {requests_per_minute, tokens_per_minute}
Seed data loaded via staging.import_routers().
'''
}

Table "history"."past_extensions" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "extension_id" UUID [not null, note: 'References sensei.extensions.id. No FK — survives hard deletes.']
  "plugin_id" UUID
  "kind" TEXT [not null]
  "name" TEXT [not null]
  "version" TEXT
  "description" TEXT
  "content" TEXT
  "props" JSONB [not null, default: '{}']
  "scope" TEXT [not null]
  "enabled" BOOLEAN [not null]
  "source" TEXT [not null]
  "icons" JSONB [not null, default: '{}']
  "tags" TEXT[] [not null, default: '{}']
  "operation" dml_operation [not null, note: 'DML that produced this entry: INSERT, UPDATE, or DELETE.']
  "revision" INTEGER [not null, default: 0, note: 'Revision number of the extension at this snapshot.']
  "recommendation_id" UUID [note: 'Which recommendation triggered this change. Null for manual edits. Links to inference.recommendations.']
  "effective_from" TIMESTAMPTZ [not null, note: 'When this revision became the live state.']
  "effective_to" TIMESTAMPTZ [note: 'When this revision was superseded. Null if still current or if source was deleted.']
  "changed_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When this history entry was written.']
  "changed_by" TEXT [note: 'Who triggered the change: user, recommendation:{id}, system.']

  indexes {
    extension_id [name: 'past_extensions_extension_id_idx']
    recommendation_id [name: 'past_extensions_recommendation_idx']
  }

  Note: '''
History table for sensei.extensions — auto-populated by historize_extensions trigger.
Captures every INSERT, UPDATE, and DELETE so that skill/persona/rule changes can be
audited and correlated with FTR impact via recommendation_id.

- extension_id: references sensei.extensions.id with no FK — survives hard deletes
- recommendation_id: which recommendation triggered this change (null for manual edits)
- effective_from/to: when this revision was the live state
- operation: INSERT, UPDATE, or DELETE
'''
}

Table "history"."past_memories" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "memory_id" UUID [not null, note: 'References sensei.memories.id. No FK — survives hard deletes.']
  "project_id" UUID
  "scope" TEXT [not null]
  "scope_filter" TEXT
  "type" TEXT [not null]
  "title" TEXT [not null]
  "content" TEXT [not null]
  "impact" TEXT
  "strength" REAL [not null]
  "status" TEXT [not null]
  "session_id" UUID
  "operation" dml_operation [not null, note: 'DML that produced this entry: INSERT, UPDATE, or DELETE.']
  "effective_from" TIMESTAMPTZ [not null, note: 'When this revision became the live state.']
  "effective_to" TIMESTAMPTZ [note: 'When this revision was superseded. Null if still current or if source was deleted.']
  "changed_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When this history entry was written.']

  indexes {
    memory_id [name: 'past_memories_memory_id_idx']
  }

  Note: '''
History table for sensei.memories — auto-populated by historize_memories trigger.
Captures every INSERT, UPDATE, and DELETE so that memory evolution can be audited.

- memory_id: references sensei.memories.id with no FK — survives hard deletes
- effective_from/to: when this revision was the live state
- operation: INSERT, UPDATE, or DELETE
'''
}

Table "public"."logs" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`]
  "level" VARCHAR [not null]
  "running_on" VARCHAR [not null]
  "logged_at" TIMESTAMPTZ [not null]
  "message" VARCHAR
  "context" JSONB [not null, default: '{}']
  "data" JSONB
  "error" JSONB
  "written_at" TIMESTAMPTZ [not null, default: `now()`]

  indexes {
    level [name: 'logs_level_idx']
    running_on [name: 'logs_running_on_idx']
    logged_at [name: 'logs_logged_at_idx']
    (context ->> 'module') [name: 'logs_context_module_idx']
  }

  Note: '''
Generic structured log table — shared across daemon, CLI, MCP, and app.
Follows the kavach logger pattern: level, running_on, context jsonb, data jsonb, error jsonb.

running_on: daemon, cli, mcp, app — identifies which component wrote the log.
context: flexible jsonb bag — callers inject attributes like module, method, task_id, tool, etc.
data: structured payload — task metrics (duration_ms, items_processed), API params, etc.
error: structured error — message, stack, code.

Common queries:
  -- All task executions sorted by duration
  SELECT * FROM logs WHERE context->>'module' = 'tasks' ORDER BY (data->>'duration_ms')::int DESC
  -- Errors in the last hour
  SELECT * FROM logs WHERE level = 'error' AND logged_at > now() - interval '1h'
  -- All activity from a specific component
  SELECT * FROM logs WHERE running_on = 'mcp' ORDER BY logged_at DESC
'''
}

Table "sensei"."assistants" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "family" assistant_family [not null, note: 'Assistant product family: claude, cursor, zed, continue, codex, aider, opencode, kiro.']
  "name" TEXT [not null, note: 'Specific variant or display name (e.g. "Claude Code CLI", "Cursor").']
  "version" TEXT [note: 'Detected version of the assistant binary/app.']
  "path" TEXT [note: 'Filesystem path to the assistant binary or config directory.']
  "transport" TEXT [not null, default: 'stdio', note: 'Communication transport: stdio (pipes) or http (localhost).']
  "configured" BOOLEAN [not null, default: false, note: 'True once sensei has registered its extensions (skills, commands, hooks, MCP) with this assistant.']
  "configured_at" TIMESTAMPTZ [note: 'Timestamp of the last configuration/registration run. Null if never configured.']
  "configured_version" TEXT [note: 'Sensei version string at last configuration. Bootstrap compares this to running version to trigger upgrade reconfiguration.']
  "props" JSONB [not null, default: '{}', note: 'Extra metadata: {detected_at, install_method, registration_log, capabilities, supported_hooks, last_health_check}.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    family [name: 'assistants_family_idx']
    configured [name: 'assistants_configured_idx']
  }

  Note: '''
Detected AI coding assistants (ACPs) and their configuration state.
Bootstrap detects installed assistants and upserts rows here.
Setup wizard (step 3) registers sensei plugins/skills/commands per assistant.
On upgrade, bootstrap compares configured_version against the running sensei
version — if stale, the upgrade flow re-pushes skills, agents, hooks, and
commands to each configured assistant.

- family: groups variants of the same product (e.g. claude covers claude-code CLI and claude-code desktop)
- transport: stdio or http — how sensei communicates with this assistant
- configured: true once sensei has registered its extensions with this assistant
- configured_at: when registration last ran (null = never configured)
- configured_version: sensei version at last configuration — drives upgrade reconfiguration
- props: extra metadata — {detected_at, install_method, registration_log, capabilities}
'''
}

Table "sensei"."collective_preferences" {
  "singleton" BOOLEAN [pk, not null, default: true, note: 'Fixed true (CHECK) — enforces exactly one row; the upsert keys ON CONFLICT (singleton).']
  "destination" TEXT [not null, default: 'none', note: 'Where insights go: none | global (public commons) | dojo (company) | both. Default none — nothing leaves the machine.']
  "cadence" TEXT [not null, default: 'manual', note: 'How often batches are prepared: manual | daily | weekly. manual pauses batching until the user triggers next-batch.']
  "categories" JSONB [not null, default: `'{}'::JSONB`, note: 'Per-category share toggles as jsonb {category: bool}. Categories: memory, pattern, rule, prompt, guard, skill, agent (spec Purpose list). A false value drops that kind from the next batch.']
  "attribution_default" TEXT [not null, default: 'dereferenced', note: 'Default attribution applied when an insight leaves the machine: named | anonymous | dereferenced (mirrors dojo.attribution_mode / dojo_protocol::AttributionMode). Default dereferenced — the safest (source stripped).']
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Note: '''
Single-row (singleton boolean PK) collective-intelligence sharing preferences for
the local user. Backs GET/PUT /api/preferences/collective and gates the Dōjō
contribute loop: destination (none|global|dojo|both), cadence (manual|daily|weekly),
per-category share toggles (jsonb), and the default attribution mode. When no row
exists the API returns conservative defaults (destination none, manual, attribution
dereferenced).
'''
}

Table "sensei"."config" {
  "key" TEXT [pk, not null, note: 'Preference key.']
  "value" TEXT [not null, note: 'Preference value stored as text (JSON-encoded for complex values).']

  Note: '''
Key-value user preferences.
setup_complete, active_project, sidebar_max_items, etc.
'''
}

Table "sensei"."consolidated_rulesets" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`]
  "scope" TEXT [not null, note: 'What was merged: \'global\' (always-on user/general rules) in v1; later a repo abs_path or namespace key.']
  "version" INTEGER [not null, note: 'Monotonic per scope. New consolidation = max(version)+1.']
  "content" TEXT [not null, note: 'The merged markdown ruleset produced by the model.']
  "conflicts" JSONB [not null, default: '[]', note: 'Conflicts the model surfaced during the merge (JSON array). Empty when none/unextracted.']
  "model" TEXT [note: 'Model that produced this merge (e.g. gemma4).']
  "source_hash" TEXT [not null, note: 'Hash of the Tier-1 input rules. A consolidate is skipped when the latest version already has this hash (no change to merge).']
  "status" TEXT [not null, default: 'proposed', note: 'proposed (awaiting approval) | approved (active, feeds rules.md) | superseded (an older approved version).']
  "created_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When this version was produced.']

  indexes {
    (scope, status) [name: 'consolidated_rulesets_scope_status_idx']
  }

  Note: '''
Governance Tier-2 output: an LLM-merged, human-approved ruleset for a scope.
Tier-1 resolution (resolve_rules_raw / resolve_global_rules) gathers + orders the
raw rules; Tier-2 asks a model to merge them into one coherent, deduped,
conflict-flagged markdown ruleset. Each consolidation is a kept version; the row
with status=approved for a scope is the active merged ruleset (it feeds
~/.sensei/rules.md). Versioning IS the history — no separate history table.
'''
}

Table "sensei"."dojo_memberships" {
  "id" UUID [pk, not null, note: 'The service membership id (dojo.memberships.id), assigned by the Dōjō console at pairing. sensei.projects.dojo_id references this value.']
  "registry_url" TEXT [not null]
  "tenant_key" TEXT [not null]
  "dojo_url" TEXT [not null]
  "kind" TEXT [not null, note: 'employer | client | community | personal — drives client-precedence routing (see dojo/routing.rs). client-bound work routes to the client Dōjō and is dereferenced; employer is excluded.']
  "org_slugs" TEXT[] [not null, default: '{}', note: 'Git-remote owner slugs this membership covers (lowercased), mirrored from dojo.memberships.org_slugs. dojo/routing.rs::infer_binding matches a project\'s repo owner against this set to SUGGEST a binding (confirm-inferred in the About panel) — it never auto-commits.']
  "role" TEXT [not null, default: 'contributor']
  "authenticated_via" TEXT [not null, default: 'device_code']
  "attribution_default" TEXT [not null, default: 'named']
  "credential_ref" TEXT [not null, note: 'Keychain entry id for the per-membership device token (Bearer auth). The token is never stored in Postgres.']
  "sync_status" TEXT [not null, default: 'authenticating', note: 'Last-known connection health: healthy | stale | error | authenticating. Derived on the daemon side from last_heartbeat_at and surfaced on the Dōjō connections pane.']
  "last_seq" BIGINT [not null, default: 0]
  "last_heartbeat_at" TIMESTAMPTZ
  "enabled" BOOLEAN [not null, default: true]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  indexes {
    kind [name: 'dojo_memberships_kind_idx']
  }

  Note: '''
Daemon-local mirror of the Dōjōs this install is connected to. Fork 1: the
authoritative dojo.memberships row lives in the Dōjō service DB; this row records
the registry URL, tenant_key, service membership id (as the PK), Keychain
credential_ref, and last-known sync_status so the daemon can route and federate.
sensei.projects.dojo_id points at id. The device token is in the OS Keychain
(credential_ref), never in Postgres — same discipline as sensei.knowledge_sources.
'''
}

Table "sensei"."dojo_preferences" {
  "scope" TEXT [pk, not null, default: 'user', note: 'Preference scope: \'user\' now; later a dojo / org / namespace key. PK part.']
  "capability" TEXT [pk, not null, note: 'Canonical command verb the preference applies to (test / build / lint / run / format / typecheck / e2e / bench / docs / start / dev). PK part.']
  "preferred" TEXT [not null, note: 'Match token for the preferred command — matched against a command\'s raw_name (exact) or command_line (substring), case-insensitively. E.g. \'nextest\'.']
  "note" TEXT [note: 'Optional human note on why this preference exists.']
  "updated_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When the preference was last set.']

  Note: '''
Capability → preferred-tool bias for the command surface (the get_commands MCP
tool + the project-window action buttons). When a project exposes several
commands of the same canonical category — e.g. two `test` commands, `cargo test`
and `cargo nextest` — the preference marks/ranks the one to prefer. `scope` is
`user` today (the local developer's own choice); when a Dōjō exists it will also
carry org / team / dojo scopes that override the user default (the same
specificity ladder as governance). One row per (scope, capability).
'''
}

Table "sensei"."extensions" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "plugin_id" UUID [note: 'Self-referencing FK: null = standalone, set = belongs to a plugin extension.']
  "kind" extension_kind [not null, note: 'Extension type: plugin (container), skill, command, agent, or hook.']
  "name" TEXT [not null, unique, note: 'Unique identifier (e.g. "zero-errors-policy", "sensei:build").']
  "version" TEXT [note: 'Semantic version string.']
  "description" TEXT [note: 'Triggering conditions or purpose description (starts with "Use when..." for skills).']
  "content" TEXT [note: 'Markdown body — the actual skill protocol, command instructions, or agent definition.']
  "props" JSONB [not null, default: '{}', note: 'Parsed frontmatter + config: {triggers, inputs, tool_access, hook_event, ...}.']
  "scope" extension_scope [not null, default: 'global', note: 'Visibility: global (all projects), project (one project), folder (one repository).']
  "enabled" BOOLEAN [not null, default: true, note: 'Whether this extension is currently active.']
  "source" extension_source [not null, default: 'local', note: 'Origin: builtin (ships with sensei), marketplace (installed from registry), local (user-created).']
  "icons" JSONB [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "tags" TEXT[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "revision" INTEGER [not null, default: 0]
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']
  "modified_by" TEXT

  indexes {
    plugin_id [name: 'extensions_plugin_id_idx']
    kind [name: 'extensions_kind_idx']
    tags [name: 'extensions_tags_idx']
  }

  Note: '''
Skills, commands, agents, hooks, and plugins.
Plugins are containers — other extensions reference them via plugin_id (self-ref).
- content: markdown body — the actual skill/command text, editable and round-trippable to .md files
- props: parsed frontmatter + additional config (triggers, inputs, tool_access, etc.)
- scope: global (all projects), project (specific project), folder (specific repository)
- source: builtin (ships with sensei), marketplace (installed), local (user-created)
- plugin_id: null = standalone extension; set = belongs to a plugin
'''
}

Table "sensei"."folders_to_watch" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "path" TEXT [not null, unique, note: 'Absolute filesystem path to the watched root directory.']
  "name" TEXT [not null, note: 'Display name for the root (e.g. "Developer", "Work Projects").']
  "note" TEXT [note: 'Optional user note about this root (e.g. "monorepo root, 3 packages").']
  "status" watch_status [not null, default: 'scanning', note: 'Lifecycle: scanning (initial scan in progress), watching (watchers active), paused (content retained, watchers stopped).']
  "excluded" JSONB [not null, default: '[]', note: 'JSON array of relative folder names/paths excluded from scanning, e.g. ["node_modules","dist",".git"].']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''
Configuration: directories the user has pointed sensei at.
Initial status is scanning; transitions to watching after first scan completes.
Exclusions are user configuration — adding an entry deletes matching folders + children;
removing an entry triggers a re-scan of that subtree.
'''
}

Table "sensei"."narration_cache" {
  "kind" TEXT [pk, not null, note: 'Stable snake_case insight key (e.g. tool_dormant) — InsightKind::as_str.']
  "facts_hash" TEXT [pk, not null, note: 'sha256(kind + canonical_json(facts)); any facts change makes a new key.']
  "title" TEXT [not null, note: 'Model-generated card title (validated against the char + voice limits).']
  "detail" TEXT [not null, note: 'Model-generated card detail (validated against the char + voice limits).']
  "model_provider" TEXT [note: 'Provider/router that produced the copy (e.g. ollama), NULL when unknown.']
  "model_id" TEXT [note: 'Model id that produced the copy (e.g. gemma4), NULL when unknown.']
  "generated_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When this copy was generated (reset on regeneration).']
  "last_used_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Bumped to now() on every cache read; drives the 30-day eviction sweep.']

  indexes {
    last_used_at [name: 'narration_cache_last_used_idx']
  }

  Note: '''
Persisted mentor-voice insight copy produced by the narration-cache pipeline.
Keyed on (kind, facts_hash) so identical facts reuse the same generated copy;
the static per-call-site fallback template is used only on cold start,
timeout, or model failure. Rows evict after 30 days of no use.
'''
}

Table "sensei"."intake_guide" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`]
  "kind" TEXT [not null]
  "axis" TEXT
  "prompt" TEXT [not null]
  "help" TEXT
  "enabled" BOOLEAN [not null, default: true]
  "source" TEXT [not null, default: 'builtin']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
}

Table "sensei"."libraries" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "kind" library_kind [not null, default: 'detected', note: 'Library classification: detected (from package manifests) or imported (manually registered).']
  "name" TEXT [not null, note: 'Package name within the ecosystem (e.g. "react", "tokio", "@lumen/icons").']
  "ecosystem" library_ecosystem [not null, note: 'Package registry: npm, pypi, cargo, go, or docs (pure documentation source).']
  "version" TEXT [note: 'Pinned or latest-known version string.']
  "description" TEXT [note: 'Human-readable description of the library.']
  "source_type" library_source_type [note: 'How documentation pages are sourced: llms.txt, http, or local.']
  "base_url" TEXT [note: 'Root URL for fetching documentation when source_type is http or llms.txt.']
  "local_path" TEXT [note: 'Local filesystem path for reading documentation when source_type is local.']
  "homepage_url" TEXT [note: 'URL of the library homepage or repository.']
  "docs_url" TEXT [note: 'URL of the library primary documentation site.']
  "page_count" INTEGER [not null, default: 0, note: 'Denormalized count of library_pages rows for this library.']
  "embedding" vector(384) [note: '384-dimensional vector embedding on description for similarity search.']
  "icons" JSONB [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "props" JSONB [not null, default: '{}', note: 'Extensible metadata: {llms_txt, llms_txt_fetched_at, skill_path, skill_generated_at, ...}.']
  "tags" TEXT[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "indexed_at" TIMESTAMPTZ [note: 'Timestamp of the last successful index run for this library.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    kind [name: 'libraries_kind_idx']
    embedding [name: 'libraries_embedding_hnsw']
    tags [name: 'libraries_tags_idx']
  }

  Note: '''
Libraries — known packages and documentation sources.
Consolidates the former libraries, lib_meta, and shared_libs tables.
- kind: detected (from Cargo.toml, package.json) or imported (manual, internal SDKs, llms.txt)
- ecosystem: npm, pypi, cargo, go, or docs (for pure documentation sources)
- source_type: how pages are fetched — llms.txt, http, or local
- page_count: denormalized count of library_pages rows
- props: extensible — {llms_txt, llms_txt_fetched_at, skill_path, skill_generated_at, ...}
- embedding: 384-dim vector on description for similarity search
'''
}

Table "sensei"."playbooks" {
  "name" TEXT [pk, not null]
  "title" TEXT [not null]
  "when_to_use" TEXT [not null]
  "opening_tone" TEXT [not null]
  "method_ref" TEXT
  "enabled" BOOLEAN [not null, default: true]
  "source" TEXT [not null, default: 'builtin']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
}

Table "sensei"."projects" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" TEXT [not null, note: 'Project display name — initially derived from parent folder name or git remote.']
  "description" TEXT [note: 'Optional project description.']
  "client" TEXT [note: 'Optional client or owner name.']
  "maturity" project_maturity [not null, default: 'discovery', note: 'Lifecycle stage: discovery (just scanned), active (in development), maintenance, or archived.']
  "goal" TEXT [note: 'What this project is for — populated from README, sensei.json, or user input.']
  "icon" JSONB [not null, default: '{}', note: 'Display icon: {kind:"kanji"|"emoji"|"custom", value:"工", bg:"color", fg:"color"}.']
  "stack" JSONB [not null, default: '{}', note: 'Detected technology stack: {languages:[], frameworks:[], runtimes:[], services:[]}. Derived from member folders.']
  "commands" JSONB [not null, default: '{}', note: 'JSON object of common commands: {dev, test, build, lint, ...}. Derived from config files.']
  "links" JSONB [not null, default: '[]', note: 'External references: [{id, kind, label, url}]. Kinds: docs, dashboard, issues, runbook, design, wiki.']
  "guidelines" JSONB [not null, default: '[]', note: 'Project rules: [{id, rule, source}]. Source can be "house-style", a session id, or "manual".']
  "preferred_acp" TEXT [note: 'Default AI coding tool for sessions in this project: claude-code, cursor, zed, etc.']
  "backlog" JSONB [not null, default: '[]', note: 'Task backlog items: [{id, task, added}]. Surfaced in project settings.']
  "privacy" JSONB [not null, default: '{}', note: 'Per-project privacy settings: {logPrompts:bool, logFileContents:bool, redactSecrets:bool, shareWithCloud:bool}. Defaults to empty = inherit global config.']
  "excluded_globs" JSONB [not null, default: '[]', note: 'Glob patterns to exclude from indexing for this project: ["dist/**", "*.generated.*"]. Layered on top of folders_to_watch.excluded.']
  "tags" TEXT[] [not null, default: '{}', note: 'Array of tag strings for quick filtering. Vocabulary controlled by sensei.tags table.']
  "dojo_id" UUID [note: 'Optional binding to the Dōjō membership this project routes findings to (dojo.memberships.id in the separate Dōjō service DB). Nullable — most projects have no Dōjō. Not a DB-level FK: dojo.* lives in another database (Fork 1). Client-membership bindings take precedence over employer ones.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    maturity [name: 'projects_maturity_idx']
    tags [name: 'projects_tags_idx']
    dojo_id [name: 'projects_dojo_id_idx']
  }

  Note: '''
Projects — independent grouping entity for 1+ folders.
One project per git/subtree folder by default, but users can merge or split.
- maturity: discovery → active → maintenance → archived
- stack: {languages, frameworks, runtimes, services} — derived from member folders
- icon: {kind, value, bg, fg} — e.g. {kind:"kanji", value:"工", bg:"var(--shu-soft)", fg:"var(--shu)"}
- links: external references [{id, kind, label, url}] — docs, dashboards, issue trackers
- guidelines: project rules [{id, rule, source}]
- preferred_acp: default AI coding tool for this project (claude-code, cursor, etc.)
- backlog: task items [{id, task, added}]
- privacy: per-project privacy settings {logPrompts, logFileContents, redactSecrets, shareWithCloud}
- excluded_globs: file/folder patterns to exclude from indexing ["dist/**", "*.generated.*"]
'''
}

Table "sensei"."scopes" {
  "key" TEXT [pk, not null, note: 'Stable identifier (e.g. general, user, organization, client, technology, team, project, repository).']
  "name" TEXT [not null, note: 'Human-readable label.']
  "level" INTEGER [not null, note: 'Precedence rank. Higher = more specific = wins. general=0 … repository=70.']
  "shareable" BOOLEAN [not null, default: false, note: 'Whether knowledge at this scope federates to a shared DÅjÅ (organization/client/team = true).']
  "description" TEXT [note: 'What this scope is for.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  Note: '''
The governance scope ladder. Each row is one level at which rules/knowledge
and identity can apply. Precedence is the integer `level` — higher = more
specific = wins on conflict (most-specific-scope-wins), with enforcement as a
separate override axis (see governance concept doc). A repo is a member of a
SET of namespaces across these scopes (no single-parent tree); resolution
orders by level. Seeded via staging.import_scopes().
'''
}

Table "sensei"."services" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "name" TEXT [not null, unique, note: 'Unique identifier for the service (e.g. "postgres-mcp").']
  "display_name" TEXT [not null, note: 'Human-readable name (e.g. "PostgreSQL MCP").']
  "publisher" TEXT [note: 'Who publishes this service (e.g. "supabase", "stripe").']
  "protocol" service_protocol [not null, default: 'mcp', note: 'Communication protocol: mcp (tools via http/stdio), ollama (local inference), anthropic/openai (external LLM providers).']
  "kind" service_kind [not null, note: 'Service category: data (databases), api (external APIs), devtool (dev tools), service (monitoring etc.), inference (local/external LLM providers).']
  "summary" TEXT [note: 'Short description of what this service provides.']
  "trigger_stacks" TEXT[] [not null, default: '{}', note: 'Stack names that trigger recommendation of this service (e.g. ["PostgreSQL","Redis"]).']
  "tools_count" INTEGER [not null, default: 0, note: 'Number of tools exposed by this service.']
  "verified" BOOLEAN [not null, default: false, note: 'Whether the service is verified/official.']
  "installed" BOOLEAN [not null, default: false, note: 'Whether the service is currently installed and configured.']
  "config" JSONB [not null, default: '{}', note: 'Connection config: MCP: {transport, command, args, url, env}. Ollama: {url, models, default_model}. External: {api_key_env, default_model}.']
  "icons" JSONB [not null, default: '{}', note: 'Display icons: {emoji, devicon, kanji, custom}.']
  "tags" TEXT[] [not null, default: '{}', note: 'Array of tag strings for filtering. Vocabulary controlled by sensei.tags table.']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp of the last modification to this row.']

  indexes {
    kind [name: 'services_kind_idx']
    installed [name: 'services_installed_idx']
    tags [name: 'services_tags_idx']
  }

  Note: '''
External service registry for MCP servers and inference providers.
- kind: data (databases), api (stripe, github), devtool (playwright, figma), service (sentry, etc.), inference (Ollama, external LLM providers)
- protocol: mcp (tools via http/stdio), ollama (local inference), anthropic/openai (external inference)
- trigger_stacks: which detected stacks recommend this service (e.g. ["PostgreSQL"])
- config: connection config, env vars, transport settings, model preferences
'''
}

Table "sensei"."symbol_names" {
  "name" TEXT [pk, not null, note: 'The symbol name (matches sensei.nodes.name). Primary key — global, deduped.']
  "first_seen" TIMESTAMPTZ [not null, default: `now()`, note: 'When this name was first recorded as an indexed symbol.']
  "last_seen" TIMESTAMPTZ [not null, default: `now()`, note: 'When this name was last seen as a current indexed symbol (updated each scan).']

  Note: '''
Global registry of every code-symbol name ever indexed. The doc-drift scan
(scan_project_doc_drift) uses it as the "was ever a real symbol" gate: a doc
mention is flagged broken only when the name IS in this registry (it was a real
symbol at some point) but no longer resolves to a current sensei.nodes row
(removed / renamed). Identifiers that were NEVER symbols — Rust enum variants,
serde-renamed camelCase API fields, string-dispatched MCP tool names — are prose
or config, not drift, so their absence from the graph is not flagged (this
killed the ~408 false-positive drift rows). Populated each drift scan by
record_symbol_names (a monotonic upsert of the current symbol names); never
pruned, so a removed symbol stays known and its stale doc references surface as
real drift.
'''
}

Table "sensei"."tags" {
  "tag" TEXT [pk, not null, note: 'Tag text value — the controlled vocabulary entry.']
  "category" TEXT [note: 'Optional category for grouping tags (e.g. "stack", "domain", "status").']
  "modified_at" TIMESTAMPTZ [not null, default: `now()`, note: 'Timestamp when this tag was first created.']

  Note: '''
Controlled vocabulary for tags used across the system.
Tables that need tags carry a tags text[] column for quick access.
This table provides autocomplete and validation.
- category: optional grouping (e.g. "stack", "domain", "status")
'''
}

Table "sensei"."tool_call_verdicts" {
  "id" bigserial [pk, not null]
  "session_id" TEXT [not null]
  "event_id" BIGINT [not null, unique]
  "tool_name" TEXT
  "verdict" TEXT [not null]
  "confidence" REAL [not null, default: 1.0]
  "reason" TEXT
  "classified_at" TIMESTAMPTZ [not null, default: `now()`]

  indexes {
    session_id [name: 'tool_call_verdicts_session_idx']
    event_id [name: 'tool_call_verdicts_event_idx']
    verdict [name: 'tool_call_verdicts_verdict_idx']
  }

  Note: '''
#90 Per-tool-call usage verdict (used / partial / ignored). Classified from
the (PostToolUse, next-event) pair on the same session. Rebuildable at any
time — the classifier is idempotent, so re-running against a new heuristic
just refreshes the table. Read-time joined by the Replay tab (#84).
'''
}

Table "sensei"."tool_insights" {
  "id" UUID [pk, not null, default: `gen_random_uuid()`, note: 'Surrogate primary key (UUID).']
  "tool_name" TEXT [not null, note: 'Tool being insighted — matches assistant_events.tool_name.']
  "computed_at" TIMESTAMPTZ [not null, default: `now()`, note: 'When this snapshot was written.']
  "metrics" JSONB [not null, default: '{}', note: 'Raw aggregates: call_count, error_count, avg_duration_ms, last_used_at, error_rate.']
  "signal_variant" TEXT [note: 'Signal card variant (warn / opportunity / unused / win) or NULL when no signal fires.']
  "signal_title" TEXT [note: 'Card title copy (matches derive_signals output).']
  "signal_detail" TEXT [note: 'Card detail copy (matches derive_signals output).']

  indexes {
    (tool_name, computed_at) [name: 'tool_insights_tool_time_idx']
    computed_at [name: 'tool_insights_time_idx']
  }

  Note: '''
Cached per-tool insight snapshots produced by the AggregateToolInsights
scheduled task. Append-only — each run writes a fresh row per known tool.
The observatory tool-signals endpoint picks the latest row per tool
(via a distinct-on / row_number window) and returns them ordered by
variant priority. Cache-miss (no rows yet) falls back to the on-the-fly
derivation.
'''
}

Table "sensei"."workflow_state" {
  "project" TEXT [pk, not null, note: 'Project identifier.']
  "active_phase" TEXT [note: 'Current phase name.']
