// The shared packages compiled as their hosts compile them. A package here is source
// only: no build, no dependencies of its own. The app and the dojo alias it in
// (svelte.config.js) and resolve its imports from their own node_modules. On its
// own, with no config, it had no Svelte types, no @sensei/* aliases and no
// svelte or @rokkit modules, so the checker typed almost none of its receivers.
// This file gives the package the hosts' view. The indexer's TypeScript engine
// finds it by walking up from each package (the placement floor; it fell to
// 53% of calls without it), and so does an editor. Imports resolve from the
// app's node_modules, the host whose versions the packages track. A package's
// hand-written declarations (sdlc-figures' index.d.ts) are compiled too: the
// engine reads only the files a program holds, and nothing imports a .d.ts.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@sensei/glyphs": ["./glyphs/index.js"],
      "@sensei/sdlc-figures": ["./sdlc-figures/index.js"],
      "@sensei/ui": ["./ui/index.js"],
      "@sensei/codemap": ["./codemap/index.ts"],
      "@sensei/state": ["./state/index.ts"],
      "*": ["../app/node_modules/*", "../app/node_modules/@types/*"]
    }
  },
  "files": ["../app/node_modules/svelte/types/index.d.ts"],
  "include": ["**/*.d.ts"],
  "exclude": ["**/node_modules/**"]
}
