// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RoleMark > pins every fixture in kanji mode 1`] = `
"<span data-role-mark="" data-role="coordinator" data-size="24" title="Coordinator" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-6 h-6 border-paper-edge bg-[color-mix(in_oklch,var(--accent)_20%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="font-kanji leading-none text-xs text-accent">指</span><!----></span>
<span data-role-mark="" data-role="contributor" data-size="24" title="Contributor" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-6 h-6 border-paper-edge bg-paper"><span data-lane-role="" aria-hidden="true" class="font-kanji leading-none text-xs text-accent">手</span><!----></span>
<span data-role-mark="" data-role="contributor" data-size="30" data-status="active" title="Contributor · Active" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-[30px] h-[30px] bg-[color-mix(in_oklch,var(--success)_14%,var(--paper))] border-[color-mix(in_oklch,var(--success)_45%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="font-kanji leading-none text-sm text-success">手</span><!----></span>
<span data-role-mark="" data-role="contributor" data-size="30" data-status="idle" title="Contributor · Idle" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-[30px] h-[30px] bg-[color-mix(in_oklch,var(--ink-mute)_14%,var(--paper))] border-[color-mix(in_oklch,var(--ink-mute)_45%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="font-kanji leading-none text-sm text-ink-mute">手</span><!----></span>
<span data-role-mark="" data-role="contributor" data-size="30" data-status="not_responding" title="Contributor · Not responding" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-[30px] h-[30px] bg-[color-mix(in_oklch,var(--warning)_14%,var(--paper))] border-[color-mix(in_oklch,var(--warning)_45%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="font-kanji leading-none text-sm text-warning">手</span><!----></span>"
`;

exports[`RoleMark > pins the icon-mode marks 1`] = `
"<span data-role-mark="" data-role="coordinator" data-size="24" title="Coordinator" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-6 h-6 border-paper-edge bg-[color-mix(in_oklch,var(--accent)_20%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="i-solar-cursor-square-bold-duotone text-xs text-accent"></span><!----></span>
<span data-role-mark="" data-role="contributor" data-size="30" data-status="not_responding" title="Contributor · Not responding" class="shrink-0 inline-flex items-center justify-center rounded-full border border-solid w-[30px] h-[30px] bg-[color-mix(in_oklch,var(--warning)_14%,var(--paper))] border-[color-mix(in_oklch,var(--warning)_45%,var(--paper))]"><span data-lane-role="" aria-hidden="true" class="i-solar-hand-stars-bold-duotone text-sm text-warning"></span><!----></span>"
`;
