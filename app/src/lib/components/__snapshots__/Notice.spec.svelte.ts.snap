// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Notice · inline > matches its snapshot 1`] = `"<div data-component="notice" data-size="inline" data-tone="refusal" role="alert" class="text-sm rounded-md border border-paper-edge bg-paper"><div class="flex items-center gap-2 px-3 py-2"><!----><span data-part="mark" data-glyph="kanji" aria-hidden="true" class="font-kanji leading-none text-warning text-sm shrink-0">止</span><!----> <span data-part="title" class="min-w-0 text-ink">Turned off by an org admin.</span> <span class="ml-auto flex items-center gap-3 shrink-0"><!----> <!----><button type="button" data-button="true" data-variant="default" data-style="link" data-size="sm" aria-label="Hide" aria-expanded="true" data-action="toggle"><!----><!----> <!----><!----><!----> <span data-item-text=""><span data-item-label="">Hide</span> <!----></span><!----> <!----> <!----><!----> <!----><!----></button><!----></span></div> <div data-part="more" class="flex flex-col gap-1.5 text-sm px-3 py-2 pl-9 border-t border-paper-edge bg-paper-soft"><p data-part="detail" class="m-0 text-ink">senecaglobal's admin keeps this repository out of the dōjō.</p><!----> <p data-part="remedy" class="m-0 text-ink-mute"><strong class="font-medium text-ink">What to do:</strong> Ask them to turn it on.</p><!----> <!----> <!----> <!----> <div class="flex items-center gap-3"><!----> <!----><span data-part="code" class="font-mono text-xs text-ink-soft whitespace-nowrap">admin_disabled</span><!----></div><!----></div><!----></div>"`;

exports[`Notice · panel > matches its snapshot 1`] = `"<div data-component="notice" data-size="panel" data-tone="refusal" role="alert"><div data-part="card"><!----><div data-card="" data-variant="default"><!----><div data-card-header=""><div class="flex items-center gap-2.5"><!----><span data-part="mark" data-glyph="kanji" aria-hidden="true" class="font-kanji leading-none text-warning text-base shrink-0">止</span><!----> <h3 data-part="heading" class="m-0 flex-1 min-w-0 text-sm font-medium text-ink">Signed in as the wrong GitHub account</h3><!----> <!----><span data-part="code" class="font-mono text-xs text-ink-soft whitespace-nowrap">account_mismatch</span><!----></div><!----></div><!----> <div data-card-body=""><!----><div data-part="body" class="flex flex-col gap-1.5 text-sm"><p data-part="detail" class="m-0 text-ink">GitHub answered as @jerry-seneca, but this identity is @jt-oss. Nothing was saved.</p><!----> <p data-part="remedy" class="m-0 text-ink-mute"><strong class="font-medium text-ink">What to do:</strong> <!---->Open the sign-in link in a private window.</p><!----> <!----> <!----> <!----></div><!----></div><!----> <div data-card-footer=""><!----><div data-part="actions" class="flex flex-wrap items-center justify-between gap-2.5"><!----><button type="button" data-button="true" data-variant="primary" data-style="default" data-size="sm" aria-label="Copy link for a private window" data-action="primary"><!----><!----> <!----><!----><!----> <span data-item-text=""><span data-item-label="">Copy link for a private window</span> <!----></span><!----> <!----> <!----><!----> <!----><!----></button><!----> <!----><button type="button" data-button="true" data-variant="default" data-style="outline" data-size="sm" aria-label="Try again" data-action="secondary"><!----><!----> <!----><!----><!----> <span data-item-text=""><span data-item-label="">Try again</span> <!----></span><!----> <!----> <!----><!----> <!----><!----></button><!----></div><!----></div><!----><!----></div><!----></div><!----></div>"`;

exports[`Notice · screen > matches its snapshot 1`] = `"<div data-component="notice" data-size="screen" data-tone="fault" role="alert" class="w-full max-w-[560px] mx-auto flex flex-col gap-4 py-16 px-6"><div data-part="eyebrow"><span data-component="eyebrow" class="text-xs tracking-[0.18em] uppercase text-ink-soft">couldn't load<!----></span><!----></div><!----> <h2 data-part="title" class="m-0 font-display text-3xl font-light leading-tight tracking-tight text-ink">Sensei can't reach <span data-part="emphasis" class="text-danger">the daemon.</span><!----></h2> <p data-part="detail" class="m-0 text-sm text-ink-mute leading-relaxed">Nothing you entered was lost.</p><!----> <div data-part="card"><!----><div data-card="" data-variant="default"><!----><div data-card-header=""><div class="flex items-center gap-2.5"><!----><span data-part="mark" data-glyph="kanji" aria-hidden="true" class="font-kanji leading-none text-danger text-base shrink-0">難</span><!----> <h3 data-part="heading" class="m-0 flex-1 min-w-0 text-sm font-medium text-ink">What to do</h3><!----> <!----><span data-part="code" class="font-mono text-xs text-ink-soft whitespace-nowrap">daemon_unreachable</span><!----></div><!----></div><!----> <div data-card-body=""><!----><div data-part="body" class="flex flex-col gap-1.5 text-sm"><!----> <p data-part="remedy" class="m-0 text-ink-mute"><!---->Open Health to see which part is down.</p><!----> <!----> <!----> <!----></div><!----></div><!----> <div data-card-footer=""><!----><div data-part="actions" class="flex flex-wrap items-center justify-between gap-2.5"><!----><button type="button" data-button="true" data-variant="primary" data-style="default" data-size="sm" aria-label="Retry" data-action="primary"><!----><!----> <!----><!----><!----> <span data-item-text=""><span data-item-label="">Retry</span> <!----></span><!----> <!----> <!----><!----> <!----><!----></button><!----> <!----><a href="/health" data-button="true" data-variant="default" data-style="outline" data-size="sm" aria-label="Open Health" data-action="secondary"><!----><!----> <!----><!----><!----> <span data-item-text=""><span data-item-label="">Open Health</span> <!----></span><!----> <!----> <!----><!----> <!----><!----></a><!----></div><!----></div><!----><!----></div><!----></div><!----></div>"`;
