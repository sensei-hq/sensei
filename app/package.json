{
	"name": "@sensei/desktop",
	"version": "0.22.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "svelte-kit sync && vitest run",
		"test:e2e": "playwright test --config e2e/playwright.config.ts --project=tauri",
		"test:inspect": "playwright test --config e2e/playwright.inspect.config.ts --project=inspect",
		"test:e2e:cold": "playwright test --config e2e/playwright.cold.config.ts --project=cold-start",
		"preview:capture": "playwright test --config e2e/preview/playwright.config.ts --project=preview",
		"preview:sheet": "node e2e/preview/sheet.mjs",
		"preview:scroll": "playwright test --config e2e/preview/playwright.config.ts --project=scroll",
		"mockup:render": "node e2e/mockup/render.mjs"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@iconify-json/simple-icons": "^1.2.91",
		"@iconify-json/solar": "^1.2.5",
		"@iconify/svelte": "^5.2.1",
		"@rokkit/actions": "^1.15.2",
		"@rokkit/app": "^1.15.2",
		"@rokkit/chart": "^1.15.2",
		"@rokkit/core": "^1.15.2",
		"@rokkit/forms": "^1.15.2",
		"@rokkit/graph": "^1.15.2",
		"@rokkit/icons": "^1.15.2",
		"@rokkit/states": "^1.15.2",
		"@rokkit/themes": "^1.15.2",
		"@rokkit/ui": "^1.15.2",
		"@rokkit/unocss": "^1.15.2",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-shell": "^2.6.0",
		"d3-force": "^3.0.0",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@srsholmes/tauri-playwright": "^0.2.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.3.13",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-zoom": "^3.0.8",
		"@unocss/extractor-svelte": "^66.7.5",
		"@unocss/reset": "^66.7.5",
		"@unocss/vite": "^66.7.5",
		"@vitest/coverage-v8": "^4.1.12",
		"axe-core": "^4.12.1",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.0",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "^6.0.3",
		"unocss": "^66.7.5",
		"vite": "^8.1.6",
		"vitest": "^4.1.12"
	}
}
